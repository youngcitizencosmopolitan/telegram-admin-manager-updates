+import unittest
+
+import batch_uploader as bu
+
+
+class HotAddCandidate0010Tests(unittest.TestCase):
+    def test_use_all_monitor_task_adopts_new_allowed_account(self):
+        tasks = [{"use_all_accounts": True, "monitor_folder": True}]
+        accounts = {"old": object(), "new": object()}
+        allowed = lambda session, capability: capability == "monitoring" and session != "blocked"
+        restricted = lambda session: False
+
+        result = bu._hot_add_candidate_sessions(tasks, accounts, {"old"}, allowed, restricted)
+
+        self.assertEqual(result, ["new"])
+
+    def test_explicit_task_does_not_adopt_unrelated_new_account(self):
+        tasks = [{"use_all_accounts": False, "account_sessions": ["old"], "monitor_folder": True}]
+        accounts = {"old": object(), "new": object()}
+
+        result = bu._hot_add_candidate_sessions(tasks, accounts, {"old"}, lambda *_: True, lambda *_: False)
+
+        self.assertEqual(result, [])
+
+    def test_restricted_or_policy_disabled_account_is_not_hot_added(self):
+        tasks = [{"use_all_accounts": True, "monitor_folder": True}]
+        accounts = {"old": object(), "blocked": object(), "restricted": object()}
+        allowed = lambda session, capability: session != "blocked"
+        restricted = lambda session: session == "restricted"
+
+        result = bu._hot_add_candidate_sessions(tasks, accounts, {"old"}, allowed, restricted)
+
+        self.assertEqual(result, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
+
