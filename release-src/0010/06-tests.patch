+import unittest
+
+import batch_uploader as bu
+
+
+class MonitorMultiTaskPipeline0010ATests(unittest.TestCase):
+    def test_single_monitor_queue_item_with_multiple_tasks_uses_pipeline(self):
+        active_items = [{"source": "Мониторинг", "task_ids": ["vip4", "vip5"]}]
+        self.assertTrue(bu._should_use_monitor_pipeline(active_items, task_count=2))
+
+    def test_single_monitor_task_does_not_need_pipeline(self):
+        active_items = [{"source": "Мониторинг", "task_ids": ["vip4"]}]
+        self.assertFalse(bu._should_use_monitor_pipeline(active_items, task_count=1))
+
+    def test_manual_batch_is_not_reclassified_as_monitor_pipeline(self):
+        active_items = [{"source": "Вручную", "task_ids": ["a", "b"]}]
+        self.assertFalse(bu._should_use_monitor_pipeline(active_items, task_count=2))
+
+
+if __name__ == "__main__":
+    unittest.main()
