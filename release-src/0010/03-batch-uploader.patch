+    async def _hot_promote_session_for_task(
+        self,
+        task: dict[str, Any],
+        session: str,
+        member_entity: Any,
+        clients: dict[str, tuple[Any, Any]],
+        account_locks: dict[str, asyncio.Lock],
+        hot_admin_locks: dict[str, asyncio.Lock],
+    ) -> bool:
+        """Promote a hot-added account using an already open controller client."""
+        target = str(task.get("target", "")).strip()
+        pair = clients.get(session)
+        if not target or pair is None:
+            return False
+        account, member_client = pair
+        claim_key = f"{target.casefold()}\0{session}"
+        lock = hot_admin_locks.setdefault(claim_key, asyncio.Lock())
+        async with lock:
+            try:
+                cached = self.app.group_state_cache.fresh_admin_sessions(target, self._cache_ttl_hours())
+            except Exception:
+                cached = set()
+            if session in cached or await self._is_admin_for_target(member_client, member_entity):
+                return True
+
+            cached_controller = None
+            try:
+                cached_controller = self.app.group_state_cache.cached_controller(target, self._cache_ttl_hours())
+            except Exception:
+                pass
+            controller_sessions = [s for s in clients if s != session]
+            if cached_controller in controller_sessions:
+                controller_sessions.remove(cached_controller)
+                controller_sessions.insert(0, cached_controller)
+
+            for controller_session in controller_sessions:
+                controller_account, controller_client = clients[controller_session]
+                if self.account_health.get(controller_session, {}).get("disabled"):
+                    continue
+                checker = getattr(self.app, "account_usage_allows", None)
+                if callable(checker) and not checker(controller_session, "admins"):
+                    continue
+                restricted = getattr(self.app, "account_is_restricted", None)
+                if callable(restricted) and restricted(controller_session):
+                    continue
+                if controller_session in getattr(self.app, "_admin_safety_disabled_sessions", set()):
+                    continue
+                try:
+                    async with account_locks[controller_session]:
+                        controller_entity = await self.app._resolve_or_join_target(controller_client, target, False)
+                        try:
+                            controller_entity = await controller_client.get_entity(controller_entity)
+                        except Exception:
+                            pass
+                        try:
+                            perms = await controller_client.get_permissions(controller_entity, "me")
+                            creator = bool(getattr(perms, "is_creator", False))
+                            is_admin = bool(getattr(perms, "is_admin", False))
+                            can_add = bool(getattr(perms, "add_admins", False))
+                        except Exception:
+                            creator = bool(getattr(controller_entity, "creator", False))
+                            rights = getattr(controller_entity, "admin_rights", None)
+                            is_admin = rights is not None
+                            can_add = bool(getattr(rights, "add_admins", False)) if rights is not None else False
+                        if not creator and not (is_admin and can_add):
+                            continue
+                        user_entity = None
+                        finder = getattr(self.app, "_find_participant_by_id", None)
+                        if callable(finder):
+                            user_entity = await finder(controller_client, controller_entity, account.user_id)
+                        if user_entity is None:
+                            try:
+                                user_entity = await controller_client.get_entity(account.user_id)
+                            except Exception:
+                                user_entity = None
+                        if user_entity is None:
+                            continue
+                        granted, omitted = await self.app._set_admin_rights(
+                            controller_client, controller_entity, user_entity, "full_add_admins", ""
+                        )
+                        policy_key = self.app.maximum_admin_policy_key("")
+                        self.app.group_state_cache.mark_admins(
+                            target,
+                            {session},
+                            controller_session=controller_session,
+                            title=str(getattr(controller_entity, "title", "") or ""),
+                            anonymous=bool(self.app.store.data.get("admin_anonymous", True)),
+                            policy_key=policy_key,
+                        )
+                        suffix = f"; не удалось выдать: {', '.join(omitted)}" if omitted else ""
+                        self.app.log(
+                            f"{task.get('name', 'Задание')}: hot-add {account.display}: ✅ назначен админом "
+                            f"через {controller_account.display}; прав {len(granted)}{suffix}"
+                        )
+                        return True
+                except Exception as exc:
+                    self.app.log(
+                        f"{task.get('name', 'Задание')}: hot-add {account.display}: "
+                        f"контроллер {controller_account.display} не смог выдать права — {self.app._friendly_error(exc)}"
+                    )
+                    continue
+
+            self.app.log(
+                f"{task.get('name', 'Задание')}: ❌ hot-add {account.display}: "
+                "нет доступного владельца/админа с правом добавлять администраторов"
+            )
+            return False
