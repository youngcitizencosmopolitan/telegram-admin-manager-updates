--- /dev/null
+++ b/app/tests/test_socks5_protocol.py
@@ -0,0 +1,61 @@
+"""Real SOCKS5 library against a local fake server; never connects to Telegram."""
+import importlib.util
+import socket
+import threading
+import unittest
+
+from tam_core.proxies import ProxyManager
+from test_proxies import Store, TestProtector
+
+
+@unittest.skipUnless(importlib.util.find_spec('python_socks'), 'Optional proxy runtime unavailable')
+class SocksProtocolTests(unittest.TestCase):
+    def probe(self, accepted):
+        seen = []
+        with socket.socket() as server:
+            server.bind(('127.0.0.1', 0))
+            server.listen(1)
+            server.settimeout(3)
+            def exact(conn, size):
+                value = b''
+                while len(value) < size:
+                    part = conn.recv(size-len(value))
+                    if not part: raise OSError('EOF')
+                    value += part
+                return value
+            def serve():
+                with server.accept()[0] as conn:
+                    conn.settimeout(3)
+                    version, count = exact(conn, 2)
+                    seen.append((version, exact(conn, count)))
+                    conn.sendall(b'\x05\x02')
+                    version, size = exact(conn, 2)
+                    username = exact(conn, size)
+                    password = exact(conn, exact(conn, 1)[0])
+                    seen.append((version, username, password))
+                    conn.sendall(b'\x01' + (b'\x00' if accepted else b'\x01'))
+                    if not accepted: return
+                    header = exact(conn, 4)
+                    address = exact(conn, 4 if header[3] == 1 else 16)
+                    port = int.from_bytes(exact(conn, 2), 'big')
+                    seen.append((header[:3], address, port))
+                    conn.sendall(b'\x05\x00\x00\x01\x7f\x00\x00\x01\x00\x50')
+            thread = threading.Thread(target=serve, daemon=True)
+            thread.start()
+            manager = ProxyManager(Store(), protector=TestProtector())
+            ident = manager.add('127.0.0.1', server.getsockname()[1], 'user', 'secret')
+            manager.assign('saved', ident)
+            result = manager.check(ident, timeout=2)
+            thread.join(3)
+            self.assertFalse(thread.is_alive())
+            self.assertEqual(result['ok'], accepted)
+            self.assertEqual(seen[1], (1,b'user',b'secret'))
+            self.assertIn('proxy', manager.options('saved'))
+            self.assertNotIn('secret', str(result))
+            if accepted:
+                self.assertEqual(seen[2][0], b'\x05\x01\x00')
+                self.assertEqual(seen[2][2], 443)
+                self.assertGreaterEqual(result['latency_ms'], 0)
+
+    def test_authenticated_tunnel(self): self.probe(True)
+    def test_rejected_authentication_preserves_route(self): self.probe(False)
