 class TelegramAdminManager(tk.Tk):
+    def _new_telegram_client(self, session_path, api_id, api_hash, *, proxy_session=None, _connection_options=None, **kwargs):
+        manager = self.__dict__.get('proxy_manager')
+        session = proxy_session or Path(session_path).name.removesuffix('.session')
+        if _connection_options is not None:
+            kwargs.update(_connection_options)
+        elif manager is not None:
+            kwargs.update(manager.options(session))
+        client = TelegramClient(session_path, api_id, api_hash, **kwargs)
+        route_id = self.__dict__.get('store')
+        route_id = route_id.data.get('account_proxies', {}).get(session) if route_id is not None else None
+        client._tam_route = f'proxy:{route_id}' if route_id else 'direct'
+        return client
+
+    def _proxy_changes_allowed(self):
+        uploader = self.__dict__.get('batch_uploader')
+        if (self.__dict__.get('_busy', False) or self.__dict__.get('_uploader_running', False)
+                or (uploader is not None and (uploader.monitor_active or uploader.running))):
+            return False
+        return True
+
+    def stop_proxy_comparison(self):
+        event = self.__dict__.get('_proxy_benchmark_stop')
+        if event is not None:
+            event.set()
+
+    def _diagnostic(self, method, *args):
+        collector = self.__dict__.get('upload_diagnostics')
+        if collector is None:
+            return
+        try:
+            getattr(collector, method)(*args)
+            if method == 'begin':
+                self.__dict__.setdefault('_quick_diagnostic_keys', set()).add(args[0])
+            elif method == 'finish':
+                self.__dict__.get('_quick_diagnostic_keys', set()).discard(args[0])
+        except Exception:
+            pass
+
+    def start_proxy_comparison(self, session, path):
+        if not self._proxy_changes_allowed():
+            messagebox.showinfo(APP_NAME, 'Останови мониторинг и текущие операции перед сравнением.', parent=self)
+            return
+        try:
+            if not any(account.session == session for account in self.store.accounts()):
+                raise ValueError('Выбери сохранённый аккаунт.')
+            path = Path(path)
+            size = path.stat().st_size
+            if not path.is_file() or not 0 < size <= 2*1024**3:
+                raise ValueError('Выбери непустой файл до 2 ГБ для одинаковых условий теста.')
+            options = self.proxy_manager.options(session)
+            if not options:
+                raise ValueError('Сначала назначь аккаунту SOCKS5-прокси.')
+            proxy_id = self.store.data['account_proxies'][session]
+            api_id, api_hash = self._api_credentials()
+        except Exception as exc:
+            from tam_core.proxies import ProxyError
+            text = str(exc) if isinstance(exc, (ProxyError, ValueError)) else 'Не удалось подготовить тест.'
+            messagebox.showerror(APP_NAME, text, parent=self)
+            return
+        self._proxy_benchmark_stop = threading.Event()
+        from tam_core.proxy_benchmark import compare_routes
+        def make_client(connection_options):
+            return self._new_telegram_client(str(SESSIONS_DIR / session), api_id, api_hash,
+                _connection_options=connection_options, flood_sleep_threshold=0)
+        def run():
+            asyncio.run(compare_routes(make_client, self.upload_diagnostics, session, path, options,
+                f'proxy:{proxy_id}', lambda: self._closed or self._proxy_benchmark_stop.is_set()))
+        self.run_worker(run, 'Сравнение: один файл, прямое подключение / SOCKS5…')
+
     def __init__(self):
