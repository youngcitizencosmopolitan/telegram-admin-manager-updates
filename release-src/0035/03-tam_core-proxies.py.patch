+"""Per-account SOCKS5 routes; credentials stay encrypted in persistent state.
+
+An assigned route which cannot be read always raises ProxyError. Callers must
+not catch that error and construct a direct Telegram connection instead.
+"""
+import base64
+import copy
+import ctypes
+import ipaddress
+import json
+import math
+import os
+import re
+import threading
+import time
+import uuid
+
+
+class ProxyError(ValueError):
+    """Safe to show to the user; never contains underlying exception text."""
+
+
+class DPAPIProtector:
+    """Windows user-bound encryption with no plaintext fallback."""
+
+    @staticmethod
+    def _crypt(value, decrypt=False):
+        if os.name != 'nt':
+            raise ProxyError('Шифрование прокси доступно только в Windows.')
+        from ctypes import wintypes
+
+        class Blob(ctypes.Structure):
+            _fields_ = [('size', wintypes.DWORD), ('data', ctypes.POINTER(ctypes.c_ubyte))]
+
+        buffer = ctypes.create_string_buffer(value)
+        source = Blob(len(value), ctypes.cast(buffer, ctypes.POINTER(ctypes.c_ubyte)))
+        target = Blob()
+        crypt = ctypes.WinDLL('crypt32', use_last_error=True)
+        kernel = ctypes.WinDLL('kernel32', use_last_error=True)
+        kernel.LocalFree.argtypes = [ctypes.c_void_p]
+        kernel.LocalFree.restype = ctypes.c_void_p
+        if decrypt:
+            operation = crypt.CryptUnprotectData
+            operation.argtypes = [ctypes.POINTER(Blob), ctypes.c_void_p, ctypes.c_void_p,
+                                  ctypes.c_void_p, ctypes.c_void_p, wintypes.DWORD, ctypes.POINTER(Blob)]
+        else:
+            operation = crypt.CryptProtectData
+            operation.argtypes = [ctypes.POINTER(Blob), wintypes.LPCWSTR, ctypes.c_void_p,
+                                  ctypes.c_void_p, ctypes.c_void_p, wintypes.DWORD, ctypes.POINTER(Blob)]
+        operation.restype = wintypes.BOOL
+        if not operation(ctypes.byref(source), None, None, None, None, 1, ctypes.byref(target)):
+            raise ProxyError('Не удалось обработать защищённые данные прокси.')
+        try:
+            return ctypes.string_at(target.data, target.size)
+        finally:
+            kernel.LocalFree(ctypes.cast(target.data, ctypes.c_void_p))
+
+    def protect(self, value):
+        return self._crypt(value)
+
+    def unprotect(self, value):
+        return self._crypt(value, decrypt=True)
+
+
+class ProxyManager:
+    def __init__(self, store, protector=None, proxy_factory=None):
+        self.store = store
+        self._protector = protector if protector is not None else DPAPIProtector()
+        self._proxy_factory = proxy_factory
+        self._lock = threading.RLock()
+
+    @staticmethod
+    def _endpoint(host, port):
+        if not isinstance(host, str) or not host or host != host.strip():
+            raise ProxyError('Укажите корректный адрес SOCKS5.')
+        try:
+            ipaddress.ip_address(host)
+        except ValueError:
+            if len(host) > 253 or not all(re.fullmatch(r'[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?', part)
+                                          for part in host.split('.')):
+                raise ProxyError('Укажите корректный адрес SOCKS5.') from None
+        if isinstance(port, bool) or not isinstance(port, (str, int)):
+            raise ProxyError('Порт должен быть от 1 до 65535.')
+        if isinstance(port, str) and not re.fullmatch(r'[0-9]+', port):
+            raise ProxyError('Порт должен быть от 1 до 65535.')
+        try:
+            port = int(port)
+        except (ValueError, OverflowError):
+            raise ProxyError('Порт должен быть от 1 до 65535.') from None
+        if not 1 <= port <= 65535:
+            raise ProxyError('Порт должен быть от 1 до 65535.')
+        return host, port
+
+    @staticmethod
+    def _credentials(username, password):
+        if (not isinstance(username, str) or not isinstance(password, str)
+                or bool(username) != bool(password)):
+            raise ProxyError('Укажите логин и пароль вместе или оставьте оба пустыми.')
+        try:
+            if any(len(value.encode('utf-8')) > 255 or '\x00' in value for value in (username, password)):
+                raise ValueError
+        except (ValueError, UnicodeError):
+            raise ProxyError('Некорректные учётные данные SOCKS5.') from None
+        return username, password
+
+    def _seal(self, username, password):
+        self._credentials(username, password)
+        try:
+            raw = json.dumps([username, password], ensure_ascii=True).encode('utf-8')
+            return base64.b64encode(self._protector.protect(raw)).decode('ascii')
+        except Exception:
+            raise ProxyError('Не удалось защитить учётные данные прокси.') from None
+
+    def _unseal(self, record):
+        try:
+            raw = self._protector.unprotect(base64.b64decode(record['credentials'], validate=True))
+            values = json.loads(raw.decode('utf-8'))
+            if not isinstance(values, list) or len(values) != 2:
+                raise ValueError
+            return self._credentials(*values)
+        except Exception:
+            raise ProxyError('Не удалось прочитать учётные данные прокси. Проверьте настройки.') from None
+
+    def _state(self):
+        records = self.store.data.get('socks5_proxies', {})
+        assignments = self.store.data.get('account_proxies', {})
+        if not isinstance(records, dict) or not isinstance(assignments, dict):
+            raise ProxyError('Повреждены настройки прокси.')
+        return records, assignments
+
+    def _record(self, ident):
+        records, _ = self._state()
+        if not isinstance(ident, str) or ident not in records:
+            raise ProxyError('Назначенный прокси не найден. Проверьте настройки.')
+        record = records[ident]
+        if not isinstance(record, dict):
+            raise ProxyError('Повреждены настройки прокси.')
+        self._endpoint(record.get('host'), record.get('port'))
+        return record
+
+    def _change(self, operation):
+        with self._lock:
+            self._state()
+            before = copy.deepcopy(self.store.data)
+            try:
+                records = self.store.data.setdefault('socks5_proxies', {})
+                assignments = self.store.data.setdefault('account_proxies', {})
+                result = operation(records, assignments)
+                self.store.save()
+                return result
+            except Exception as error:
+                self.store.data.clear()
+                self.store.data.update(before)
+                if isinstance(error, ProxyError):
+                    raise
+                raise ProxyError('Не удалось сохранить настройки прокси.') from None
+
+    def list_proxies(self):
+        with self._lock:
+            records, _ = self._state()
+            result = []
+            for ident in records:
+                record = self._record(ident)
+                result.append({'id': ident, 'host': record['host'], 'port': record['port']})
+            return result
+
+    def add(self, host, port, username='', password=''):
+        host, port = self._endpoint(host, port)
+        record = {'host': host, 'port': port, 'credentials': self._seal(username, password)}
+        ident = uuid.uuid4().hex
+        self._change(lambda records, assignments: records.__setitem__(ident, record))
+        return ident
+
+    def update(self, ident, host, port, username='', password='', keep_credentials=False):
+        host, port = self._endpoint(host, port)
+        with self._lock:
+            old = self._record(ident)
+            if keep_credentials:
+                self._unseal(old)
+                protected = old['credentials']
+            else:
+                protected = self._seal(username, password)
+            self._change(lambda records, assignments: records.__setitem__(ident, {
+                'host': host, 'port': port, 'credentials': protected}))
+
+    def delete(self, ident):
+        def remove(records, assignments):
+            self._record(ident)
+            if ident in assignments.values():
+                raise ProxyError('Прокси назначен аккаунтам. Сначала измените их маршруты.')
+            del records[ident]
+        self._change(remove)
+
+    def import_lines(self, text):
+        if not isinstance(text, str):
+            raise ProxyError('Некорректный список прокси.')
+        parsed = []
+        for line in text.splitlines():
+            if not line.strip():
+                continue
+            parts = line.strip().split(':', 3)
+            if len(parts) not in (2, 4):
+                raise ProxyError('Формат строки: IP:PORT[:LOGIN:PASSWORD].')
+            host, port = self._endpoint(parts[0], parts[1])
+            username, password = parts[2:] if len(parts) == 4 else ('', '')
+            parsed.append((uuid.uuid4().hex, {'host': host, 'port': port,
+                                             'credentials': self._seal(username, password)}))
+        if not parsed:
+            return []
+        self._change(lambda records, assignments: records.update(parsed))
+        return [ident for ident, _ in parsed]
+
+    def assign(self, session, proxy_id):
+        if not isinstance(session, str) or not session:
+            raise ProxyError('Не указан аккаунт.')
+        def assign_route(records, assignments):
+            if proxy_id is None:
+                assignments.pop(session, None)
+            else:
+                self._unseal(self._record(proxy_id))
+                assignments[session] = proxy_id
+        self._change(assign_route)
+
+    def distribute(self, sessions):
+        sessions = list(dict.fromkeys(sessions))
+        if any(not isinstance(session, str) or not session for session in sessions):
+            raise ProxyError('Не указан аккаунт.')
+        def distribute_routes(records, assignments):
+            ids = list(records)
+            if not ids:
+                raise ProxyError('Сначала добавьте SOCKS5 прокси.')
+            for ident in ids:
+                self._unseal(self._record(ident))
+            for index, session in enumerate(sessions):
+                assignments[session] = ids[index % len(ids)]
+        self._change(distribute_routes)
+
+    def options(self, session):
+        with self._lock:
+            _, assignments = self._state()
+            if session not in assignments:
+                return {}
+            record = self._record(assignments[session])
+            username, password = self._unseal(record)
+            return {'proxy': ('socks5', record['host'], int(record['port']), True, username, password)}
+
+    def route_label(self, session):
+        with self._lock:
+            _, assignments = self._state()
+            if session not in assignments:
+                return 'Прямое'
+            ident = assignments[session]
+            record = self._record(ident)
+            return '{} / {}:{}'.format(ident, record['host'], record['port'])
+
+    def check(self, proxy_id, timeout=8):
+        start = time.monotonic()
+        sock = None
+        try:
+            if not isinstance(timeout, (int, float)) or not math.isfinite(timeout) or timeout <= 0:
+                raise ProxyError('Некорректное время проверки.')
+            with self._lock:
+                record = self._record(proxy_id)
+                username, password = self._unseal(record)
+                parameters = dict(host=record['host'], port=int(record['port']),
+                                  username=username or None, password=password or None)
+            if self._proxy_factory is None:
+                from python_socks import ProxyType
+                from python_socks.sync import Proxy
+                tunnel = Proxy(proxy_type=ProxyType.SOCKS5, rdns=True, **parameters)
+            else:
+                tunnel = self._proxy_factory(**parameters)
+            sock = tunnel.connect(dest_host='149.154.167.51', dest_port=443, timeout=timeout)
+            return {'ok': True, 'latency_ms': round((time.monotonic() - start) * 1000, 1), 'error': ''}
+        except Exception:
+            return {'ok': False, 'latency_ms': None,
+                    'error': 'SOCKS5 соединение не установлено. Проверьте адрес, порт и учётные данные.'}
+        finally:
+            if sock is not None:
+                try:
+                    sock.close()
+                except Exception:
+                    pass
