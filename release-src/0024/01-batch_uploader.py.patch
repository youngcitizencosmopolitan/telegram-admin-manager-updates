+    def _unconfirmed_store(self):
+        # Only unresolved file identities are retained, never the media catalog or
+        # active transfer objects. Batch counters remain local to each wave.
+        lock = getattr(self, '_unconfirmed_lock', None)
+        if lock is None:
+            lock = self.__dict__.setdefault('_unconfirmed_lock', threading.RLock())
+        return lock, self.__dict__.setdefault('_unconfirmed_by_rule', {})
+
+    def _remember_unconfirmed(self, task, path: Path, blocked: bool) -> bool:
+        tid, identity = str(task.get('id', '')), monitor_identity(task)
+        lock, entries = self._unconfirmed_store()
+        with lock:
+            entry = entries.get(tid)
+            if entry and entry[0] != identity:
+                entries.pop(tid, None)
+                entry = None
+            if blocked:
+                if entry is None:
+                    entry = entries[tid] = (identity, set())
+                entry[1].add(str(path))
+            elif entry:
+                removed = str(path) in entry[1]
+                entry[1].discard(str(path))
+                if not entry[1]:
+                    entries.pop(tid, None)
+                return removed
+        return False
+
+    def _prune_unconfirmed(self, rules) -> None:
+        identities = {str(r.get('id', '')): monitor_identity(r) for r in rules}
+        lock, entries = self._unconfirmed_store()
+        with lock:
+            if not entries:
+                self._unconfirmed_identities = identities
+                return
+        # Manual uploads share the controller, but are not monitoring rules.
+        # A linked legacy task may retain the old target after its rule is edited.
+        for task in self.tasks():
+            identities.setdefault(str(task.get('id', '')), monitor_identity(task))
+        with lock:
+            self._unconfirmed_identities = identities
+            for tid, (identity, _) in list(entries.items()):
+                if identities.get(tid) != identity:
+                    entries.pop(tid, None)
+
+    def _monitor_display_state(self, tid, rule=None):
+        state = dict(getattr(self, 'task_states', {}).get(tid, {}))
+        lock, entries = self._unconfirmed_store()
+        with lock:
+            identities = getattr(self, '_unconfirmed_identities', None)
+            identity = monitor_identity(rule) if rule is not None else (identities or {}).get(tid)
+            if (rule is not None or identities is not None) and state.get('_monitor_identity') not in (None, identity):
+                state = {}
+            entry = entries.get(tid)
+            if entry and (rule is None or entry[0] == monitor_identity(rule)):
+                state['blocked'] = max(int(state.get('blocked', 0) or 0), len(entry[1]))
+        return state
+
+    def _unconfirmed_count(self) -> int:
+        lock, entries = self._unconfirmed_store()
+        with lock:
+            counts = {tid: len(entry[1]) for tid, entry in entries.items()}
+        for tid in getattr(self, 'task_states', {}):
+            state = self._monitor_display_state(tid)
+            counts[tid] = max(counts.get(tid, 0), int(state.get('blocked', 0) or 0))
+        return sum(counts.values())
 
