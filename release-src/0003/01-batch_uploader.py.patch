     # ---------- persistence ----------
+    def _load_table_sort_state(self, table_id: str) -> dict[str, Any] | None:
+        raw = self.app.store.data.get("table_sorts", {})
+        if not isinstance(raw, dict):
+            return None
+        state = raw.get(str(table_id))
+        return dict(state) if isinstance(state, dict) else None
+
+    def _save_table_sort_state(self, table_id: str, state: dict[str, Any]) -> None:
+        raw = self.app.store.data.get("table_sorts", {})
+        table_sorts = dict(raw) if isinstance(raw, dict) else {}
+        table_sorts[str(table_id)] = {"column": str(state.get("column", "")), "reverse": bool(state.get("reverse", False))}
+        self.app.store.data["table_sorts"] = table_sorts
+        self.app.store.save()
+
+    def _register_sortable_tree(
+        self, tree: ttk.Treeview, table_id: str, column_types: dict[str, str] | None = None,
+        *, first_descending: set[str] | None = None,
+    ) -> TreeviewSortController:
+        controller = TreeviewSortController(
+            tree, table_id=table_id, column_types=column_types,
+            load_state=self._load_table_sort_state, save_state=self._save_table_sort_state,
+            first_descending=first_descending,
+        )
+        self._tree_sort_controllers.append(controller)
+        return controller
+
