+    def _load_table_sort_state(self, table_id: str) -> dict[str, object] | None:
+        raw = self.store.get_setting("table_sort:" + str(table_id), "") or ""
+        if not raw:
+            return None
+        try:
+            import json
+            value = json.loads(raw)
+            return dict(value) if isinstance(value, dict) else None
+        except Exception:
+            return None
+
+    def _save_table_sort_state(self, table_id: str, state: dict[str, object]) -> None:
+        import json
+        self.store.set_setting("table_sort:" + str(table_id), json.dumps({
+            "column": str(state.get("column", "")), "reverse": bool(state.get("reverse", False))
+        }, ensure_ascii=False))
+
+    def _register_sortable_tree(
+        self, tree: ttk.Treeview, table_id: str, column_types: dict[str, str] | None = None,
+        *, first_descending: set[str] | None = None,
+    ) -> TreeviewSortController:
+        controller = TreeviewSortController(
+            tree, table_id=table_id, column_types=column_types,
+            load_state=self._load_table_sort_state, save_state=self._save_table_sort_state,
+            first_descending=first_descending,
+        )
+        self._tree_sort_controllers.append(controller)
+        return controller
+
