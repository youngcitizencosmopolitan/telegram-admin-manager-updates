+        if not peer_ids:
+            messagebox.showinfo(APP_NAME, "В кэше пока нет каналов/групп.")
+            return
+        self.run_worker(
+            lambda: asyncio.run(self._refresh_channel_links_async(peer_ids, create_missing=True, show_message=True)),
+            "Обновляю ссылки каналов…",
+        )
+
+    async def _channel_existing_invite_link(self, client: Any, entity: Any) -> str:
+        cls = getattr(getattr(tl_functions, "messages", None), "GetExportedChatInvitesRequest", None)
+        if cls is None:
+            return ""
+        params = inspect.signature(cls).parameters
+        kwargs: dict[str, Any] = {"peer": entity}
+        if "admin_id" in params:
+            kwargs["admin_id"] = await client.get_input_entity("me")
+        if "offset_date" in params:
+            kwargs["offset_date"] = None
+        if "offset_link" in params:
+            kwargs["offset_link"] = None
+        if "limit" in params:
+            kwargs["limit"] = 50
+        if "revoked" in params:
+            kwargs["revoked"] = False
+        result = await client(cls(**kwargs))
+        return pick_active_invite_link(getattr(result, "invites", ()) or ())
+
+    async def _channel_create_invite_link(self, client: Any, entity: Any) -> str:
+        cls = getattr(getattr(tl_functions, "messages", None), "ExportChatInviteRequest", None)
+        if cls is None:
+            return ""
+        params = inspect.signature(cls).parameters
+        kwargs: dict[str, Any] = {"peer": entity}
+        # Keep the generated fallback simple and reusable. Optional expiry/limits
+        # are intentionally omitted so an explicit refresh does not create a
+        # short-lived link that silently stops working later.
+        for name in ("expire_date", "usage_limit", "request_needed", "title"):
+            if name in params:
+                kwargs[name] = None
+        result = await client(cls(**kwargs))
+        return str(getattr(result, "link", "") or "")
+
+    async def _refresh_channel_links_async(
+        self, peer_ids: list[int], *, create_missing: bool, show_message: bool,
+    ) -> None:
+        rows = {int(row.get("peer_id", 0) or 0): row for row in self.state_db.channels_all()}
+        target_ids = [int(x) for x in peer_ids if int(x) in rows]
+        remaining: set[int] = set()
+        now = time.time()
+        for peer_id in target_ids:
+            row = rows[peer_id]
+            username = str(row.get("username", "") or "")
+            if username:
+                self.state_db.channel_upsert({
+                    "peer_id": peer_id, "link": f"https://t.me/{username}",
+                    "link_status": "ok", "link_updated_at": now,
+                })
+            else:
+                remaining.add(peer_id)
+        if not remaining:
+            self.ui_call(self.refresh_channels_from_cache)
+            if show_message:
+                self.ui_call(lambda: messagebox.showinfo(APP_NAME, "Ссылки публичных каналов уже актуальны."))
+            return
+
+        all_accounts = {a.session: a for a in self.store.accounts()}
+        accounts = self.accounts_for("channels")
+        errors_by_peer: dict[int, str] = {}
+        candidate_seen: set[int] = set()
+        for account in accounts:
+            if not remaining:
+                break
+            if self.account_is_restricted(account.session):
+                continue
+            cooldown = admin_flood_remaining(self.state_db, account.session)
+            if cooldown > 0:
+                continue
+            eligible: list[int] = []
+            for peer_id in list(remaining):
+                relations = {str(x.get("session", "")): x for x in self.state_db.channel_accounts(peer_id)}
+                relation = relations.get(account.session, {})
+                if relation_can_manage_invites(relation):
+                    eligible.append(peer_id)
+                    candidate_seen.add(peer_id)
+            if not eligible:
+                continue
+            client = TelegramClient(str(SESSIONS_DIR / account.session), *self._api_credentials(), flood_sleep_threshold=0)
+            try:
+                await client.connect()
+                if not await client.is_user_authorized():
+                    continue
+                for peer_id in list(eligible):
+                    if peer_id not in remaining:
+                        continue
+                    row = rows[peer_id]
+                    try:
+                        peer = tl_types.PeerChannel(peer_id) if str(row.get("peer_type", "channel")) == "channel" else tl_types.PeerChat(peer_id)
+                        entity = await client.get_entity(peer)
+                        link = await self._channel_existing_invite_link(client, entity)
+                        if not link and create_missing:
+                            link = await self._channel_create_invite_link(client, entity)
+                        if link:
+                            self.state_db.channel_upsert({
+                                "peer_id": peer_id, "link": link, "link_status": "ok",
+                                "link_source_session": account.session, "link_updated_at": time.time(),
+                            })
+                            remaining.discard(peer_id)
+                            self.log(f"Каналы: {row.get('title', peer_id)}: ✅ ссылка обновлена через {account.display}")
+                        else:
+                            errors_by_peer[peer_id] = "Нет активной invite-ссылки"
+                    except Exception as exc:
+                        if errors is not None and isinstance(exc, getattr(errors, "FloodWaitError", ())):
+                            remember_admin_flood_wait(self.state_db, account.session, max(1, int(getattr(exc, "seconds", 1))))
+                        self.remember_account_restriction(account, exc, "channel_invite_link")
+                        errors_by_peer[peer_id] = self._friendly_error(exc)
+            finally:
+                await client.disconnect()
+
+        for peer_id in remaining:
+            current = self.state_db.channel_get(peer_id)
+            if current.get("link"):
+                continue
+            if peer_id not in candidate_seen:
+                status = "Нет доступа к invite-ссылке"
+            else:
+                status = errors_by_peer.get(peer_id) or ("Нет активной invite-ссылки" if not create_missing else "Не удалось получить invite-ссылку")
+            self.state_db.channel_upsert({
+                "peer_id": peer_id, "link_status": status, "link_updated_at": time.time(),
+            })
+        self.ui_call(self.refresh_channels_from_cache)
+        if show_message:
+            resolved = len(target_ids) - len(remaining)
+            self.ui_call(lambda: messagebox.showinfo(
+                APP_NAME, f"Ссылки обновлены. Получено: {resolved}; без доступной ссылки: {len(remaining)}."
+            ))
