+    def _load_table_sort_state(self, table_id: str) -> dict[str, Any] | None:
+        raw = self.store.data.get("table_sorts", {})
+        if not isinstance(raw, dict):
+            return None
+        state = raw.get(str(table_id))
+        return dict(state) if isinstance(state, dict) else None
+
+    def _save_table_sort_state(self, table_id: str, state: dict[str, Any]) -> None:
+        raw = self.store.data.get("table_sorts", {})
+        table_sorts = dict(raw) if isinstance(raw, dict) else {}
+        table_sorts[str(table_id)] = {"column": str(state.get("column", "")), "reverse": bool(state.get("reverse", False))}
+        self.store.data["table_sorts"] = table_sorts
+        self.store.save()
