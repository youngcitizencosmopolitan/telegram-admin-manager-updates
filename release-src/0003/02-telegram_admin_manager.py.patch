+    def refresh_channel_links_from_telegram(self) -> None:
+        if TelegramClient is None:
+            self._show_missing_dependency(); return
+        selected = self._channels_selected_peer_ids()
+        peer_ids = selected or [int(row.get("peer_id", 0) or 0) for row in self.state_db.channels_all()]
