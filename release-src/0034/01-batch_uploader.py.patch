+    def _refresh_transfer_rates(self) -> None:
+        """One bounded, background aggregate per 15 seconds, even while idle."""
+        if getattr(self, '_transfer_rates_loading', False):
+            return
+        reader = getattr(getattr(self.app, 'state_db', None), 'transfer_window_rates', None)
+        if reader is None:
+            return
+        self._transfer_rates_loading = True
+        def read():
+            try:
+                rates = reader()
+            except Exception:
+                rates = None
+            def finish():
+                self._transfer_rates_loading = False
+                self._transfer_window_rates = rates
+                values = getattr(self, '_last_dashboard_values', None)
+                if values is not None:
+                    self._set_dashboard(*values)
+                else:
+                    self.monitor_transfer_summary_var.set(_monitor_transfer_summary_text(
+                        speed=0, done_files=0, total_files=0, remaining=0, eta=None, window_rates=rates))
+                self.app.after(15000, self._refresh_transfer_rates)
+            self.app.ui_call(finish)
+        threading.Thread(target=read, daemon=True).start()
+
