     # ---------- transfer statistics ----------
+    def transfer_window_rates(self, *, now: float | None = None) -> dict[int, float]:
+        """Confirmed file bytes per wall-clock window, credited at completion."""
+        now = time.time() if now is None else float(now)
+        with self.session() as conn:
+            row = conn.execute('SELECT '
+                'COALESCE(SUM(CASE WHEN created_at>=? THEN size ELSE 0 END),0), '
+                'COALESCE(SUM(CASE WHEN created_at>=? THEN size ELSE 0 END),0), '
+                'COALESCE(SUM(size),0) FROM transfer_stats '
+                'WHERE created_at>=? AND created_at<=? AND success=1',
+                (now-600, now-1800, now-3600, now)).fetchone()
+        return {minutes: int(row[i])/float(minutes*60) for i, minutes in enumerate((10, 30, 60))}
+
