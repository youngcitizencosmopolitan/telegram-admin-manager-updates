--- /dev/null
+++ b/app/tests/test_rolling_transfer_rates.py
@@ -0,0 +1,89 @@
+import tempfile
+import unittest
+import threading
+from types import SimpleNamespace
+from pathlib import Path
+
+from tam_core.state_db import StateDatabase
+from batch_uploader import BatchUploaderPane, _monitor_transfer_summary_text
+
+
+class RollingRatesTests(unittest.TestCase):
+    def test_windows_include_idle_time_exclude_failures_and_future_records(self):
+        with tempfile.TemporaryDirectory() as td:
+            db = StateDatabase(Path(td) / 'state.db')
+            now = 10000
+            for age, size, success in [(0, 600, True), (600, 600, True),
+                    (601, 1800, True), (1800, 1800, True), (1801, 3600, True),
+                    (3600, 3600, True), (3601, 99999, True), (-1, 99999, True), (1, 99999, False)]:
+                db.transfer_stat_record(session='s', account_label='', task='', target='', path='',
+                    size=size, duration=1, success=success, created_at=now-age)
+            self.assertEqual(db.transfer_window_rates(now=now), {10: 2.0, 30: 4800/1800, 60: 12000/3600})
+            reopened = StateDatabase(db.path)
+            self.assertEqual(reopened.transfer_window_rates(now=now+7200), {10: 0.0, 30: 0.0, 60: 0.0})
+
+    def test_summary_shows_three_periods_and_zero_as_zero(self):
+        text = _monitor_transfer_summary_text(speed=1, done_files=0, total_files=1,
+            remaining=100, eta=None, window_rates={10: 1024**2, 30: 2*1024**2, 60: 0})
+        self.assertIn('Факт', text)
+        self.assertIn('10 мин: 1.0 МБ/с', text)
+        self.assertIn('30 мин: 2.0 МБ/с', text)
+        self.assertIn('60 мин: 0 Б/с', text)
+
+    def test_background_refresh_coalesces_and_publishes_on_ui_callback(self):
+        pane = object.__new__(BatchUploaderPane)
+        entered, release, posted = threading.Event(), threading.Event(), threading.Event()
+        callbacks, timers, rendered, threads = [], [], [], []
+        def reader():
+            threads.append(threading.get_ident())
+            entered.set()
+            release.wait(2)
+            return {10: 1, 30: 2, 60: 3}
+        def ui_call(fn):
+            callbacks.append(fn)
+            posted.set()
+        pane.app = SimpleNamespace(state_db=SimpleNamespace(transfer_window_rates=reader),
+            ui_call=ui_call, after=lambda ms, fn: timers.append((ms, fn)))
+        pane.monitor_transfer_summary_var = SimpleNamespace(set=rendered.append)
+        try:
+            pane._refresh_transfer_rates()
+            self.assertTrue(entered.wait(2))
+            pane._refresh_transfer_rates()
+            self.assertEqual(len(threads), 1)
+            self.assertNotEqual(threads[0], threading.get_ident())
+            self.assertFalse(rendered)
+            release.set()
+            self.assertTrue(posted.wait(2))
+            callbacks.pop()()
+            self.assertIn('Факт:', rendered[-1])
+            self.assertEqual(timers[0][0], 15000)
+        finally:
+            release.set()
+
+    def test_failed_refresh_drops_stale_numbers_and_retries_later(self):
+        pane = object.__new__(BatchUploaderPane)
+        posted = threading.Event()
+        callbacks, timers, values = [], [], []
+        def reader(): raise OSError('unavailable')
+        def ui(fn): callbacks.append(fn); posted.set()
+        pane.app = SimpleNamespace(state_db=SimpleNamespace(transfer_window_rates=reader),
+            ui_call=ui, after=lambda *args: timers.append(args))
+        pane._last_dashboard_values = (1, 2, 3, 4, None, 0, 5, 1)
+        pane._transfer_window_rates = {10: 99, 30: 99, 60: 99}
+        pane._set_dashboard = lambda *args: values.append(args)
+        pane._refresh_transfer_rates()
+        self.assertTrue(posted.wait(2))
+        callbacks.pop()()
+        self.assertIsNone(pane._transfer_window_rates)
+        self.assertFalse(pane._transfer_rates_loading)
+        self.assertEqual(len(values), 1)
+        self.assertEqual(len(timers), 1)
+        del pane._last_dashboard_values
+        rendered = []
+        pane.monitor_transfer_summary_var = SimpleNamespace(set=rendered.append)
+        posted.clear()
+        pane._refresh_transfer_rates()
+        self.assertTrue(posted.wait(2))
+        callbacks.pop()()
+        self.assertTrue(rendered, 'An idle failure must clear previously displayed rates')
+        self.assertNotIn('Факт:', rendered[-1])
