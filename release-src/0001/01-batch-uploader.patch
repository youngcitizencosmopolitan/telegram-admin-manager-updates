+def _is_monitor_queue_item(item: dict[str, Any]) -> bool:
+    return str(item.get("source", "")).casefold().startswith("мониторинг")
+
+def _take_monitor_pipeline_wave(first: dict[str, Any], pending: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """Take consecutive non-overlapping monitoring items while preserving queue order."""
+    wave = [first]
+    if not _is_monitor_queue_item(first):
+        return wave
+    seen = {str(x) for x in (first.get("task_ids", []) or []) if str(x)}
+    while pending:
+        candidate = pending[0]
+        if not _is_monitor_queue_item(candidate):
+            break
+        candidate_ids = {str(x) for x in (candidate.get("task_ids", []) or []) if str(x)}
+        if seen.intersection(candidate_ids):
+            break
+        wave.append(pending.pop(0))
+        seen.update(candidate_ids)
+    return wave
+
