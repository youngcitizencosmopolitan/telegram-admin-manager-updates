+import inspect
+import unittest
+
+import batch_uploader as bu
+
+
+class MonitorPipelineTests(unittest.TestCase):
+    def _item(self, qid, source, *task_ids):
+        return {"id": qid, "source": source, "task_ids": list(task_ids)}
+
+    def test_collects_only_consecutive_monitor_items(self):
+        first = self._item("a", "Мониторинг", "t1")
+        pending = [
+            self._item("b", "Мониторинг: новые файлы", "t2"),
+            self._item("m", "Ручной запуск", "t3"),
+            self._item("c", "Мониторинг", "t4"),
+        ]
+        wave = bu._take_monitor_pipeline_wave(first, pending)
+        self.assertEqual([x["id"] for x in wave], ["a", "b"])
+        self.assertEqual([x["id"] for x in pending], ["m", "c"])
+
+    def test_overlapping_task_id_stops_pipeline_before_duplicate_snapshot(self):
+        first = self._item("a", "Мониторинг", "t1")
+        pending = [
+            self._item("b", "Мониторинг", "t2"),
+            self._item("c", "Мониторинг", "t1"),
+            self._item("d", "Мониторинг", "t4"),
+        ]
+        wave = bu._take_monitor_pipeline_wave(first, pending)
+        self.assertEqual([x["id"] for x in wave], ["a", "b"])
+        self.assertEqual([x["id"] for x in pending], ["c", "d"])
+
+    def test_pipeline_contract_uses_task_release_events_and_shared_batch(self):
+        run_batch = inspect.getsource(bu.BatchUploaderPane._run_batch)
+        run_task = inspect.getsource(bu.BatchUploaderPane._run_one_task)
+        queue_worker = inspect.getsource(bu.BatchUploaderPane._queue_worker)
+        self.assertIn("pipeline: bool = False", run_batch)
+        self.assertIn("start_after", run_task)
+        self.assertIn("drained_event", run_task)
+        self.assertIn("_take_monitor_pipeline_wave", queue_worker)
+        self.assertIn("pipeline=len(wave_items) > 1", queue_worker)
+
+
+if __name__ == "__main__":
+    unittest.main()
