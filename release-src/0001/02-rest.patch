@@ -0,0 +1,36 @@
+import unittest
+from unittest.mock import patch
+
+from tam_core import updater
+
+
+class SerialUpdaterTests(unittest.TestCase):
+    def manifest(self, compat, display):
+        return {
+            "version": compat,
+            "display_version": display,
+            "package_url": "https://example.invalid/update.zip",
+            "sha256": "a" * 64,
+            "notes": "x",
+        }
+
+    def test_legacy_438_sees_0001_bridge_as_newer(self):
+        with patch.object(updater, "fetch_manifest", return_value=self.manifest("4.3.8.0001", "0001")):
+            info = updater.check_for_update("4.3.8", "https://manifest.invalid")
+        self.assertIsNotNone(info)
+        self.assertEqual(info.version, "0001")
+
+    def test_installed_0001_does_not_loop_on_bridge_manifest(self):
+        with patch.object(updater, "fetch_manifest", return_value=self.manifest("4.3.8.0001", "0001")):
+            info = updater.check_for_update("0001", "https://manifest.invalid")
+        self.assertIsNone(info)
+
+    def test_0001_sees_0002_by_display_version(self):
+        with patch.object(updater, "fetch_manifest", return_value=self.manifest("4.3.8.0002", "0002")):
+            info = updater.check_for_update("0001", "https://manifest.invalid")
+        self.assertIsNotNone(info)
+        self.assertEqual(info.version, "0002")
+
+
+if __name__ == "__main__":
+    unittest.main()
