--- /dev/null
+++ b/app/tests/test_queue_workspace.py
@@ -0,0 +1,31 @@
+import tkinter as tk
+import unittest
+from unittest.mock import Mock
+from tam_ui.queue_view import QueueView
+
+
+class QueueViewTests(unittest.TestCase):
+    def setUp(self):
+        try:
+            self.root = tk.Tk()
+        except tk.TclError as exc:
+            self.skipTest(str(exc))
+        self.addCleanup(self.root.destroy)
+        self.root.withdraw()
+
+    def test_view_construction_does_not_resume_and_keeps_same_queue_rows(self):
+        commands = {key:Mock() for key in QueueView.COMMANDS}
+        view = QueueView(self.root, commands)
+        for fn in commands.values(): fn.assert_not_called()
+        view.upsert_item('recovered', {'source':'Мониторинг', 'tasks':'VIP',
+                                     'status':'Восстановлено', 'created':'12:00'})
+        view.upsert_item('recovered', {'source':'Мониторинг', 'tasks':'VIP',
+                                     'status':'Восстановлено', 'created':'12:00'})
+        self.assertEqual(view.tree.get_children(), ('recovered',))
+        self.assertIn('Восстановлено', view.tree.item('recovered', 'values'))
+        view.resume_button.configure(state='normal')
+        view.resume_button.invoke()
+        commands['resume_queue'].assert_called_once_with()
+
+
+if __name__ == '__main__': unittest.main()
