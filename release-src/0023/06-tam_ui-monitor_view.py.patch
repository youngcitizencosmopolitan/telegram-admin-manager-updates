+    def select_rule(self, tid: str | None):
+        self.selected = tid
+
+    def update_rule(self, tid: str, presentation: dict):
+        args = dict(text=presentation['name'], values=presentation['values'])
+        if self.tree.exists(tid):
+            self.tree.item(tid, **args)
+        else:
+            self.tree.insert('', 'end', iid=tid, **args)
+
+    def update_totals(self, values: dict):
+        for key, value in values.items():
+            if key in self.metric_vars:
+                self.metric_vars[key].set(value)
+
