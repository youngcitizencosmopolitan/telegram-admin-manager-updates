+    def test_buttons_on_main_pages_fit_minimum_window_in_both_themes(self):
+        from tkinter import ttk
+        self.app.geometry('1180x700')
+        self.app.deiconify()
+        rule = dict(id='blocked', name='VIP с длинным названием', folder=self.tmp.name,
+                    target='@example', monitor_folder=True)
+        self.app.monitor_rules.put(rule)
+        pane = self.app.batch_uploader
+        pane.task_states['blocked'] = {'blocked': 2, 'active': {}}
+        pane.refresh_monitor_tab(force=True)
+        pane.monitor_tree.selection_set('blocked')
+        pane._update_monitor_details()
+        def children(widget):
+            for w in widget.winfo_children():
+                yield w
+                yield from children(w)
+        def inside_scroll_canvas(widget):
+            parent = widget.master
+            while parent is not None:
+                if isinstance(parent, tk.Canvas):
+                    return True
+                parent = parent.master
+            return False
+        for pref in ('dark', 'light'):
+            self.app.theme_manager.apply(pref)
+            for key in self.app.workspace.pages:
+                self.app.workspace.select(key)
+                self.app.update()
+                rx, ry = self.app.winfo_rootx(), self.app.winfo_rooty()
+                right, bottom = rx+self.app.winfo_width(), ry+self.app.winfo_height()
+                candidates = list(children(self.app.workspace.pages[key])) + list(self.app.workspace.nav_buttons.values())
+                clipped = [(str(w.cget('text')), w.winfo_rootx()-rx, w.winfo_rooty()-ry,
+                            w.winfo_width(), w.winfo_height()) for w in candidates
+                           if isinstance(w, (ttk.Button, ttk.Menubutton)) and w.winfo_ismapped()
+                           and not inside_scroll_canvas(w)
+                           and (w.winfo_rootx()+w.winfo_width()>right+1 or
+                                w.winfo_rooty()+w.winfo_height()>bottom+1)]
+                self.assertEqual(clipped, [], (pref, key, clipped))
+
+
+if __name__ == '__main__': unittest.main()
