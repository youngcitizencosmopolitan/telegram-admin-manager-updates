+    def _upsert_monitor_row(self, parent, position, *, iid, text, values):
+        tree = self.monitor_tree
+        if hasattr(tree, 'exists'):
+            state = self.task_states.get(iid, {})
+            tags = ('warning',) if state.get('blocked') else ('error',) if state.get('failed') else ()
+            args = dict(text=text, values=values, tags=tags)
+            if tree.exists(iid):
+                tree.item(iid, **args)
+            else:
+                tree.insert(parent, position, iid=iid, **args)
+        else:
