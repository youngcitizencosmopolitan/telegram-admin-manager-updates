+    def _update_monitor_details(self) -> None:
+        if not hasattr(self, 'monitor_view'):
+            return
+        from tam_ui.monitor_presentation import rule_presentation
+        tid = self._monitor_selected_tid()
+        self.monitor_view.select_rule(tid)
+        store = getattr(self.app, 'monitor_rules', None)
+        rule = store.get(tid) if tid and store else None
+        if not rule:
+            self.monitor_view.show_details({})
+            return
+        state = getattr(self, 'task_states', {}).get(tid, {})
+        data = rule_presentation(rule, getattr(self, 'monitor_runtime', {}).get(tid, {}), state,
+            running=tid in getattr(self, 'live_tasks', {}), queued=tid in self._queued_task_ids())
