+import tempfile
+import tkinter as tk
+import unittest
+from pathlib import Path
+from tkinter import ttk
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+from tam_ui.theme import PALETTES, ThemeManager, resolve_theme
+
+
+class ThemeLogicTests(unittest.TestCase):
+    def test_system_and_invalid_preferences_follow_system(self):
+        self.assertEqual(resolve_theme('system', True), 'dark')
+        self.assertEqual(resolve_theme('invalid', False), 'light')
+        self.assertEqual(resolve_theme('light', True), 'light')
+        self.assertEqual(resolve_theme('dark', False), 'dark')
+
+    def test_normal_text_meets_contrast_in_both_palettes(self):
+        def luminance(color):
+            rgb = [int(color[n:n+2], 16)/255 for n in (1, 3, 5)]
+            return sum(w*(x/12.92 if x <= .04045 else ((x+.055)/1.055)**2.4)
+                       for w, x in zip((.2126, .7152, .0722), rgb))
+        for palette in PALETTES.values():
+            for fg, bg in [('text', 'surface'), ('muted', 'surface'),
+                           ('text', 'background'), ('warning', 'warning_bg'),
+                           ('error', 'error_bg')]:
+                a, b = sorted((luminance(palette[fg]), luminance(palette[bg])))
+                self.assertGreaterEqual((b+.05)/(a+.05), 4.5, (fg, bg, palette))
+
+
+class NativeThemeTests(unittest.TestCase):
+    def setUp(self):
+        try:
+            self.root = tk.Tk()
+        except tk.TclError as exc:
+            self.skipTest(str(exc))
+        self.root.withdraw()
+        self.addCleanup(self.root.destroy)
+        self.store = SimpleNamespace(data={'unrelated': 17}, save=Mock())
+        self.manager = ThemeManager(self.root, self.store)
+
+    def test_theme_keeps_tree_selection_contents_and_saves_preference(self):
+        tree = ttk.Treeview(self.root)
+        tree.insert('', 'end', iid='r1', text='Правило')
+        tree.selection_set('r1')
+        for theme in ('dark', 'light'):
+            self.manager.apply(theme)
+            self.assertEqual(tree.selection(), ('r1',))
+            self.assertEqual(tree.item('r1', 'text'), 'Правило')
+            self.assertEqual(self.store.data['ui_theme'], theme)
+        self.assertEqual(self.store.data['unrelated'], 17)
+        self.assertEqual(self.store.save.call_count, 2)
+
+    def test_existing_text_menu_and_new_dialog_follow_theme(self):
+        text = tk.Text(self.root)
+        menu = tk.Menu(self.root, tearoff=False)
+        self.manager.register(text)
+        self.manager.register(menu)
+        self.manager.apply('dark')
+        self.assertEqual(text.cget('bg'), PALETTES['dark']['surface'])
+        self.assertEqual(str(menu.cget('fg')), PALETTES['dark']['text'])
+        win = tk.Toplevel(self.root)
+        win.withdraw()
+        win.attributes('-alpha', 0)
+        field = tk.Text(win)
+        field.pack()
+        win.deiconify()
+        self.root.update()
+        self.assertEqual(field.cget('bg'), PALETTES['dark']['surface'])
+        win.destroy()
+        self.manager.apply('light')
+
+    def test_reopening_manager_uses_saved_preference_without_saving_again(self):
+        self.store.data['ui_theme'] = 'dark'
+        other = ThemeManager(self.root, self.store)
+        self.assertEqual(other.current, 'dark')
+        self.store.save.assert_not_called()
+
+
+if __name__ == '__main__':
+    unittest.main()
