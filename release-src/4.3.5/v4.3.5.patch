@@ -0,0 +1,58 @@
+import inspect
+import unittest
+
+import telegram_admin_manager as main_app
+import batch_uploader
+from batch_uploader import BatchUploaderPane, _fmt_eta
+
+
+class MainTabbedUiTests(unittest.TestCase):
+    def test_main_ui_uses_persistent_notebook_instead_of_launcher_cards(self):
+        source = inspect.getsource(main_app.TelegramAdminManager._build_ui)
+        self.assertIn("main_notebook", source)
+        self.assertIn("ttk.Notebook", source)
+        self.assertNotIn("Launcher.TButton", source)
+        self.assertNotIn("Выбери инструмент и работай в отдельном окне", source)
+
+    def test_main_tab_labels_keep_primary_tools_visible(self):
+        self.assertTrue(hasattr(main_app, "MAIN_TAB_SPECS"))
+        labels = [label for _key, label in main_app.MAIN_TAB_SPECS]
+        self.assertEqual(labels[:3], ["Создание групп", "Мониторинг", "Админы"])
+        self.assertIn("Аккаунты / API", labels)
+        self.assertIn("Twitter / X", labels)
+        self.assertIn("Обновления", labels)
+
+    def test_primary_tool_switch_selects_existing_tab_not_toplevel(self):
+        source = inspect.getsource(main_app.TelegramAdminManager._open_primary_tool)
+        self.assertIn("main_notebook.select", source)
+        self.assertNotIn("deiconify", source)
+
+
+class MonitoringEtaTests(unittest.TestCase):
+    def test_remaining_eta_uses_remaining_bytes_and_live_speed(self):
+        fn = getattr(batch_uploader, "_remaining_eta_seconds", None)
+        self.assertIsNotNone(fn)
+        self.assertEqual(fn(10000, 2500, 2500), 3.0)
+        self.assertEqual(_fmt_eta(fn(1024 * 60, 0, 2048)), "30с")
+
+    def test_remaining_eta_is_unknown_without_useful_speed(self):
+        fn = getattr(batch_uploader, "_remaining_eta_seconds", None)
+        self.assertIsNotNone(fn)
+        self.assertIsNone(fn(1000, 100, 0))
+        self.assertIsNone(fn(1000, 100, 512))
+        self.assertEqual(fn(1000, 1000, 2048), 0.0)
+
+    def test_monitor_rules_have_eta_column_next_to_speed(self):
+        source = inspect.getsource(BatchUploaderPane._build_unified_monitor_ui)
+        self.assertIn('"speed", "eta", "state"', source)
+        self.assertIn('"eta": "Осталось"', source)
+
+    def test_monitor_refresh_calculates_and_renders_eta(self):
+        source = inspect.getsource(BatchUploaderPane.refresh_monitor_tab)
+        self.assertIn("remaining = max(0, total - processed - active_bytes)", source)
+        self.assertIn("_remaining_eta_seconds", source)
+        self.assertIn("_fmt_eta", source)
+
+
+if __name__ == "__main__":
+    unittest.main()
