+def _remaining_eta_seconds(total_bytes: int | float, done_bytes: int | float, speed: float) -> float | None:
+    remaining = max(0.0, float(total_bytes) - float(done_bytes))
+    if remaining <= 0:
+        return 0.0
+    # Avoid noisy/infinite ETA while the transfer is stalled or only starting.
+    if float(speed) <= 1024.0:
+        return None
+    return remaining / float(speed)
+
