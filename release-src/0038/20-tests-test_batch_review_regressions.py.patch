+    def install_slots(self):
+        slots = FakeSlots()
+        self.pane.app.network_slot = slots.network_slot
+        self.pane.app.transfer_slot = slots.transfer_slot
+        return slots
+
+    async def run_rule(self, clients):
+        self.pane._effective_task_sessions = lambda *args: list(clients)
+        pool = {session: (Account(session=session, label=session, phone='', user_id=index), client)
+                for index, (session, client) in enumerate(clients.items(), start=1)}
+        await self.pane._run_one_task(dict(self.rule), pool, {session: False for session in clients}, self.locks,
+            asyncio.Semaphore(4), asyncio.Semaphore(2), asyncio.Semaphore(2), preparation=self.pool)
+
+    def reservation_rows(self):
+        with self.history.db.session() as conn:
+            return [tuple(row) for row in conn.execute('SELECT path, prepublication FROM upload_reservations')]
+
+    def record_waits(self, slots):
+        """Every pause or sleep is logged with the network capacity held across it."""
+        waits = []
+
+        async def gate(*args):
+            waits.append(slots.network_active)
+            return True
+
+        async def sleep(seconds):
+            waits.append(slots.network_active)
+            await asyncio.sleep(.01)
+            return True
+
+        self.pane._wait_gate, self.pane._sleep_stop = gate, sleep
+        return waits
+
+    # Finding 1: idle time must not occupy global capacity; Stop wakes waiters.
+    async def test_network_slot_covers_bytes_and_publication_but_not_publication_gap(self):
+        self.file('a.mp4', b'first')
+        self.file('b.mp4', b'second')
+        self.rule['delay'] = .05
+        slots = self.install_slots()
+        waits = self.record_waits(slots)
+        during = []
+
+        async def on_upload(path):
+            during.append(('upload', slots.network_active))
+
+        async def on_send(path):
+            during.append(('send', slots.network_active))
+
+        await asyncio.wait_for(self.run_rule({'s1': FakeTelegram(self, on_upload, on_send)}), 5)
+        self.assertEqual(len(self.sent), 2)
+        self.assertEqual(during, [('upload', 1), ('send', 1)] * 2)
+        self.assertGreater(len(waits), 2)
+        self.assertEqual(set(waits), {0}, 'network capacity was held across a pause or publication gap')
+        self.assertEqual(slots.network_active, 0)
+
+    async def test_network_slot_is_released_during_flood_wait(self):
+        self.file()
+        slots = self.install_slots()
+        waits = self.record_waits(slots)
+        attempts = []
+
+        async def on_upload(path):
+            attempts.append(path)
+            if len(attempts) == 1:
+                raise FakeFlood()
+
+        with (patch.object(bu, 'TELETHON_WAIT_ERRORS', (FakeFlood,)),
+              patch.object(bu, 'telegram_wait_seconds', lambda exc: 1),
+              patch.object(bu, 'is_premium_upload_wait', lambda exc: False)):
+            await asyncio.wait_for(self.run_rule({'s1': FakeTelegram(self, on_upload)}), 5)
+        self.assertEqual(len(attempts), 2)
+        self.assertEqual(len(self.sent), 1)
+        self.assertEqual(slots.network_entries, 3, 'failed upload, retried upload, publication')
+        self.assertEqual(set(waits), {0}, 'network capacity was held across FloodWait')
+
