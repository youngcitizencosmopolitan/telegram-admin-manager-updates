+class FakeSlots:
+    """Records the shared account and network capacity a run is holding."""
+
+    def __init__(self):
+        self.network_active = 0
+        self.network_entries = 0
+        self.held_accounts = set()
+        self.max_accounts = 0
+
+    @asynccontextmanager
+    async def network_slot(self, stop_event=None):
+        self.network_active += 1
+        self.network_entries += 1
+        try:
+            yield
+        finally:
+            self.network_active -= 1
+
+    @asynccontextmanager
+    async def transfer_slot(self, session, stop_event=None):
+        self.held_accounts.add(session)
+        self.max_accounts = max(self.max_accounts, len(self.held_accounts))
+        try:
+            yield
+        finally:
+            self.held_accounts.discard(session)
+
+
+class FakeFlood(Exception):
+    seconds = 1
+
+
+class FakeTelegram:
+    def __init__(self, owner, on_upload=None, on_send=None):
+        self.owner, self.on_upload, self.on_send = owner, on_upload, on_send
+
+    async def upload_file(self, path, **kwargs):
+        if self.on_upload:
+            await self.on_upload(Path(path))
+        return SimpleNamespace(path=path, name=Path(path).name)
+
+    async def send_file(self, entity, path, **kwargs):
+        path = getattr(path, 'path', path)
+        if self.on_send:
+            await self.on_send(Path(path))
+        self.owner.sent.append((path, kwargs))
+        return SimpleNamespace(id=len(self.owner.sent))
+
+
+class BatchReviewRegressionTests(unittest.IsolatedAsyncioTestCase):
+    asyncTearDown = fixture.PrefetchUploadTests.asyncTearDown
+    read = fixture.PrefetchUploadTests.read
