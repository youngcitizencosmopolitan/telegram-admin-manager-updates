+    async def test_stop_while_waiting_for_network_slot_requeues_safely(self):
+        self.file()
+        waiting = asyncio.Event()
+
+        @asynccontextmanager
+        async def network_slot(stop_event=None):
+            waiting.set()
+            while not stop_event.is_set():
+                await asyncio.sleep(.01)
+            raise asyncio.CancelledError()  # the runtime's stop signal
+            yield
+
+        self.pane.app.network_slot = network_slot
+        running = asyncio.create_task(self.run_rule({'s1': FakeTelegram(self)}))
+        await asyncio.wait_for(waiting.wait(), 2)
+        self.stop.set()
+        await asyncio.wait_for(running, 2)  # a bare CancelledError here would mean the rule died
+        self.assertEqual(self.sent, [])
+        self.assertEqual(self.errors, [])
+        self.assertEqual(self.reservation_rows(), [])
+        self.assertEqual(self.pane.task_states['r1']['failed'], 0)
+        self.assertFalse(self.account_lock.locked())
