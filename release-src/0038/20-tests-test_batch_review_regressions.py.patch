+    async def test_cancel_during_claim_releases_the_claim_that_lands_later(self):
+        self.file()
+        entered, proceed, landed = threading.Event(), threading.Event(), threading.Event()
+        real_claim = self.pane._claim_upload_fingerprint
+
+        def claim(*args):
+            entered.set()
+            proceed.wait(5)
+            try:
+                return real_claim(*args)
+            finally:
+                landed.set()
+
+        self.pane._claim_upload_fingerprint = claim
+        running = asyncio.create_task(self.run_rule({'s1': FakeTelegram(self)}))
+        self.assertTrue(await asyncio.to_thread(entered.wait, 5))
+        running.cancel()
+        await asyncio.sleep(0)
+        proceed.set()
+        with self.assertRaises(asyncio.CancelledError):
+            await running
+        self.assertTrue(await asyncio.to_thread(landed.wait, 5))
+        self.assertEqual(self.reservation_rows(), [], 'a claim landed after cancellation and was never released')
