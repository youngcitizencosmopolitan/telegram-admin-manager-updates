+class SelectedDisabledTaskTests(unittest.TestCase):
+    def pane_with(self, tasks):
+        pane = bu.BatchUploaderPane.__new__(bu.BatchUploaderPane)
+        logged, queued, resumed = [], [], []
+        noop = lambda *args, **kwargs: None
+        pane.app = SimpleNamespace(save_api_settings=noop, _api_credentials=lambda: (1, 'hash'),
+                                   save_safety_settings=noop, log=logged.append)
+        pane.tasks = lambda: tasks
+        pane.save_tasks = pane.refresh_safety_badge = noop
+        pane._selected_task_ids = lambda: [str(task['id']) for task in tasks]
+        pane._enqueue_batch = lambda selected, **kwargs: queued.append([task['id'] for task in selected])
+        pane._ensure_queue_worker = lambda: resumed.append(True)
+        pane.queue_halt_requested = True
+        return pane, logged, queued, resumed
+
+    def test_all_disabled_selection_is_rejected_with_a_message(self):
+        pane, _, queued, resumed = self.pane_with([{'id': 'off', 'name': 'Отключённое', 'enabled': False}])
+        with patch.object(bu, 'TelegramClient', object), patch.object(bu, 'messagebox') as box:
+            pane.start(True)
+        self.assertEqual(queued, [])
+        self.assertEqual(resumed, [], 'a rejected start must not resume a halted dispatcher')
+        self.assertTrue(pane.queue_halt_requested)
+        message = box.showinfo.call_args.args[1]
+        self.assertIn('выключ', message.casefold())
+        self.assertIn('Отключённое', message)
+
+    def test_mixed_selection_queues_enabled_tasks_and_reports_skipped(self):
+        pane, logged, queued, _ = self.pane_with([{'id': 'off', 'name': 'Отключённое', 'enabled': False},
+                                                  {'id': 'on', 'name': 'Включённое'}])
+        with patch.object(bu, 'TelegramClient', object), patch.object(bu, 'messagebox'):
+            pane.start(True)
+        self.assertEqual(queued, [['on']])
+        self.assertTrue(any('Отключённое' in line and 'выключ' in line.casefold() for line in logged), logged)
+
