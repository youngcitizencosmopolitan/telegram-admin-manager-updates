+    # Finding 4: a connected but unregistered handle must not outlive cancellation.
+    async def test_hot_add_cancel_disconnects_unregistered_handle_even_when_recancelled(self):
+        entered, disconnecting, proceed = asyncio.Event(), asyncio.Event(), asyncio.Event()
+        disconnected = []
+
+        class Handle:
+            async def connect(self):
+                return None
+
+            async def is_user_authorized(self):
+                return True
+
+            async def get_me(self):
+                entered.set()
+                await asyncio.Event().wait()
+
+            async def disconnect(self):
+                disconnecting.set()
+                await proceed.wait()
+                disconnected.append(True)
+
+        self.pane.app.store.accounts = lambda: [Account(session='s9', label='hot', phone='', user_id=9)]
+        self.pane.sessions_dir = self.root
+        self.pane._new_telegram_client = lambda *args, **kwargs: Handle()
+        clients = {}
+        with patch.object(bu, '_hot_add_candidate_sessions', lambda *args: ['s9']):
+            running = asyncio.create_task(self.pane._connect_hot_batch_accounts_once([], clients, {}, {}, 1, 'hash'))
+            await asyncio.wait_for(entered.wait(), 2)
+            running.cancel()
+            await asyncio.wait_for(disconnecting.wait(), 2)
+            running.cancel()
+            await asyncio.sleep(0)
+            self.assertFalse(running.done(), 'cleanup was abandoned by the second cancellation')
+            proceed.set()
+            with self.assertRaises(asyncio.CancelledError):
