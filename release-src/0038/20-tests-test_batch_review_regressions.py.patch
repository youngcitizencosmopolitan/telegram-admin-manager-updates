+    # Finding 3: one account failing must not take other accounts' files with it.
+    async def test_connection_failure_settles_healthy_worker_then_raises(self):
+        self.file('a.mp4', b'first')
+        self.file('b.mp4', b'second')
+        healthy_uploading, connection_failed = asyncio.Event(), asyncio.Event()
+        finished = []
+
+        @asynccontextmanager
+        async def lease(session, clients, fallback):
+            if session == 's1':
+                await healthy_uploading.wait()
+                connection_failed.set()
+                raise OSError('proxy down')
+            yield fallback
+
+        async def on_upload(path):
+            first = not healthy_uploading.is_set()
+            healthy_uploading.set()
+            await connection_failed.wait()
+            if first:
+                await asyncio.sleep(.35)  # long enough for the wave loop to observe the failure
+            finished.append(path)
+
+        self.pane._file_client_lease = lease
+        with self.assertRaisesRegex(OSError, 'proxy down'):
+            await asyncio.wait_for(self.run_rule({'s1': FakeTelegram(self), 's2': FakeTelegram(self, on_upload)}), 5)
+        self.assertEqual(len(finished), 2, 'the healthy transfer was cancelled or the failed file was lost')
+        self.assertEqual(len(self.sent), 2)
+        self.assertEqual(self.reservation_rows(), [])
+        self.assertEqual(self.pane.account_health['s1']['state'], 'Недоступен')
+        self.assertIn('proxy down', self.pane.account_health['s1']['reason'])
+        self.assertEqual(self.pane.task_states['r1']['failed'], 0)
+
