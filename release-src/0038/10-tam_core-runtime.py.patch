+class AsyncRuntime:
+    def __init__(self, name='tam-async'):
+        self._lock = threading.RLock()
+        self._closing = False
+        self._futures = set()
+        self._ready = threading.Event()
+        self.leases = SessionLeaseManager()
+        self._thread = threading.Thread(target=self._serve, name=name, daemon=True)
+        self._thread.start()
+        self._ready.wait()
+        self.broker = ManagedClientBroker(self)
+        self._transfer_condition = asyncio.Condition()
+        self._active_transfer_sessions = set()
+        self._transfer_waiters = deque()
+
+    def _serve(self):
+        self.loop = asyncio.new_event_loop()
+        asyncio.set_event_loop(self.loop)
+        self._ready.set()
+        try:
+            self.loop.run_forever()
+        finally:
+            for task in asyncio.all_tasks(self.loop):
+                task.cancel()
+                # A cancellation-resistant third-party task cannot hold shutdown
+                # forever. It has already received the bounded grace period.
+                task._log_destroy_pending = False
+            self.loop.close()
+
+    def assert_owner_loop(self):
+        try:
+            running = asyncio.get_running_loop()
+        except RuntimeError:
+            running = None
+        if running is not self.loop:
+            raise RuntimeError('Managed clients must be used on the runtime event loop')
+
+    def submit(self, coro):
+        with self._lock:
+            if self._closing:
+                _dispose_coroutine(coro)
+                raise RuntimeError('Async runtime is closed')
+            future = asyncio.run_coroutine_threadsafe(coro, self.loop)
+            self._futures.add(future)
+            future.add_done_callback(self._forget_future)
+            return future
+
+    def _forget_future(self, future):
+        with self._lock:
+            self._futures.discard(future)
+
+    def run(self, coro, timeout=None):
+        if threading.current_thread() is self._thread:
+            _dispose_coroutine(coro)
+            raise RuntimeError('Blocking run() cannot be called on the runtime loop')
+        future = self.submit(coro)
+        try:
+            return future.result(timeout)
+        except concurrent.futures.TimeoutError:
+            future.cancel()
+            raise
+
+    @asynccontextmanager
+    async def transfer_slot(self, session_path, limit_provider, *, cancelled=None):
+        """Hold one file's shared global permit and exclusive account permit.
+
+        Use across assignment, upload, publication and history recording. The
+        synchronous provider must read a thread-safe settings snapshot, not Tk.
+        Reduced limits drain active files; increases are noticed within 50 ms.
+        Independent account waiters may pass a waiter whose account is active.
+        """
+        self.assert_owner_loop()
+        path = canonical_session_path(session_path)
+        token = object()
+        waiter = (token, path)
+        condition = self._transfer_condition
+        acquired = False
+        async with condition:
+            self._transfer_waiters.append(waiter)
+            try:
+                while True:
+                    if self._closing:
+                        raise RuntimeError('Async runtime is closed')
+                    if cancelled is not None and cancelled():
+                        raise asyncio.CancelledError()
+                    limit = max(1, int(limit_provider()))
+                    eligible = next((candidate for candidate, account in self._transfer_waiters
+                                     if account not in self._active_transfer_sessions), None)
+                    if eligible is token and len(self._active_transfer_sessions) < limit:
+                        self._active_transfer_sessions.add(path)
+                        acquired = True
+                        break
+                    self.broker._status(True, path, token, reason='transfer slot')
+                    try:
+                        await asyncio.wait_for(condition.wait(), timeout=0.05)
+                    except asyncio.TimeoutError:
+                        pass
+            finally:
+                self._transfer_waiters.remove(waiter)
+                self.broker._status(False, token=token)
+                condition.notify_all()
+        try:
+            yield
+        finally:
+            if acquired:
+                async def release():
+                    async with condition:
+                        self._active_transfer_sessions.discard(path)
+                        condition.notify_all()
+                cleanup = asyncio.create_task(release())
+                try:
+                    await asyncio.shield(cleanup)
+                except asyncio.CancelledError:
+                    await cleanup
+                    raise
+
+    @asynccontextmanager
+    async def network_slot(self, limit_provider, *, cancelled=None):
+        """Reserve shared network capacity only while a network action runs."""
+        self.assert_owner_loop()
+        if not hasattr(self, '_network_condition'):
+            self._network_condition = asyncio.Condition()
+            self._network_waiters = deque()
+            self._network_active = 0
+        condition = self._network_condition
+        token = object()
+        acquired = False
+        async with condition:
+            self._network_waiters.append(token)
+            try:
+                while True:
+                    if self._closing:
+                        raise RuntimeError('Async runtime is closed')
+                    if cancelled is not None and cancelled():
+                        raise asyncio.CancelledError()
+                    if self._network_waiters[0] is token and self._network_active < max(1, int(limit_provider())):
+                        self._network_active += 1
+                        acquired = True
+                        break
+                    self.broker._status(True, '', token, reason='network slot')
+                    try:
+                        await asyncio.wait_for(condition.wait(), .05)
+                    except asyncio.TimeoutError:
+                        pass
+            finally:
+                self._network_waiters.remove(token)
+                self.broker._status(False, token=token)
+                condition.notify_all()
+        try:
+            yield
+        finally:
+            if acquired:
+                async def release():
+                    async with condition:
+                        self._network_active -= 1
+                        condition.notify_all()
+                await _settle_cleanup(release())
+
+    async def _shutdown(self, timeout):
+        self.broker._closed = True
+        current = asyncio.current_task()
+        tasks = [task for task in asyncio.all_tasks() if task is not current]
+        for task in tasks:
+            task.cancel()
+        if tasks:
+            await asyncio.wait(tasks, timeout=max(0, timeout / 2))
+        cleanup = asyncio.create_task(self.broker.close())
+        done, _ = await asyncio.wait([cleanup], timeout=max(0, timeout / 2))
+        if not done:
+            cleanup.cancel()
+            # Let gather/child cancellation settle before the loop is stopped.
+            await asyncio.wait([cleanup], timeout=min(0.05, max(0, timeout / 8)))
+
+    def shutdown(self, timeout=5):
+        if threading.current_thread() is self._thread:
+            raise RuntimeError('Shutdown must be called outside the runtime loop')
+        deadline = time.monotonic() + max(0, timeout)
+        with self._lock:
+            if not self._closing:
+                self._closing = True
+                shutdown = asyncio.run_coroutine_threadsafe(self._shutdown(max(0, timeout * 0.8)), self.loop)
+            else:
+                shutdown = None
+        if shutdown is not None:
+            try:
+                shutdown.result(max(0, deadline - time.monotonic()))
+            except (concurrent.futures.TimeoutError, concurrent.futures.CancelledError):
+                pass
+            finally:
+                self.leases.close()
+                with self._lock:
+                    for future in tuple(self._futures):
+                        future.cancel()
+                if not self.loop.is_closed():
+                    self.loop.call_soon_threadsafe(self.loop.stop)
+        self._thread.join(max(0, deadline - time.monotonic()))
+        return not self._thread.is_alive()
+
+    close = shutdown
+
