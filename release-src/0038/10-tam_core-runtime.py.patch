+class _Session:
+    def __init__(self):
+        self.condition = asyncio.Condition()
+        self.waiters = deque()
+        self.client = None
+        self.options_key = None
+        self.handles = set()
+        self.exclusive = False
+        self.lease_owner = object()
+        self.reservation_owner = None
+        self.failure = None
