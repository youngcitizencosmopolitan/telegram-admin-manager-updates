+class ManagedClientBroker:
+    def __init__(self, runtime):
+        self.runtime = runtime
+        self._sessions = {}
+        self._closed = False
+        self._reservations = contextvars.ContextVar('tam_session_reservations', default={})
+        self._operation = contextvars.ContextVar('tam_operation', default=None)
+        self._wait_tokens = {}
+
+    @contextmanager
+    def operation(self, operation):
+        """Bind waiting messages to one operation (also inherited by submit())."""
+        token = self._operation.set(operation)
+        try:
+            yield operation
+        finally:
+            self._operation.reset(token)
+
+    def _status(self, waiting, path='', token=None, reason='session'):
+        operation = self._operation.get()
+        if operation is None:
+            return
+        if waiting:
+            outstanding = self._wait_tokens.setdefault(operation, {})
+            label = 'Ожидает свободный слот' if reason in ('transfer slot', 'network slot') else 'Ожидает аккаунт'
+            outstanding[token] = label + (': ' + Path(path).stem if path else '')
+        else:
+            outstanding = self._wait_tokens.get(operation)
+            if outstanding is None or token not in outstanding:
+                return
+            del outstanding[token]
+        if outstanding:
+            operation.update(status='waiting', detail=next(reversed(outstanding.values())))
+        else:
+            self._wait_tokens.pop(operation, None)
+            operation.update(status='running', detail='')
+
+    @asynccontextmanager
+    async def exclusive(self, session_path):
+        """Reserve a session across a whole authorization/file-swap workflow.
+
+        Child tasks inherit ownership; callers must join them before leaving.
+        Handles opened in this context may use the reserved session.
+        """
+        self.runtime.assert_owner_loop()
+        path = canonical_session_path(session_path)
+        inherited = self._reservations.get()
+        session = self._sessions.setdefault(path, _Session())
+        if path in inherited and session.reservation_owner is inherited[path]:
+            yield
+            return
+        token = object()
+        acquired = False
+        context_token = None
+        async with session.condition:
+            session.waiters.append(token)
+            try:
+                while True:
+                    if self._closed:
+                        raise RuntimeError('Client broker is closed')
+                    if session.failure is not None:
+                        raise RuntimeError('Session cleanup failed; restart the runtime before reusing it') from session.failure
+                    if session.waiters[0] is token and not session.handles and session.reservation_owner is None:
+                        break
+                    self._status(True, path, token)
+                    await session.condition.wait()
+                if session.client is not None:
+                    await self._disconnect_client(path, session)
+                while not self.runtime.leases.try_acquire([path], session.lease_owner):
+                    self._status(True, path, token)
+                    await asyncio.sleep(0.05)
+                    if self._closed:
+                        raise RuntimeError('Client broker is closed')
+                    if session.failure is not None:
+                        raise RuntimeError('Session cleanup failed; restart the runtime before reusing it') from session.failure
+                self._status(False, token=token)
+                session.reservation_owner = token
+                acquired = True
+                context_token = self._reservations.set({**inherited, path: token})
+            finally:
+                session.waiters.remove(token)
+                self._status(False, token=token)
+                session.condition.notify_all()
+        try:
+            yield
+        finally:
+            if acquired:
+                self._reservations.reset(context_token)
+                async def release_reservation():
+                    async with session.condition:
+                        session.reservation_owner = None
+                        if not session.handles and session.client is None:
+                            self.runtime.leases.release([path], session.lease_owner)
+                        session.condition.notify_all()
+                await _settle_cleanup(release_reservation())
+
+    def handle(self, session_path, factory, options_key=None, exclusive=False, keepalive=False):
+        """Create a lease handle, optionally retaining an idle reusable client.
+
+        Idle connections retain session ownership until a route/options change,
+        an exclusive workflow, or runtime teardown. Exclusive handles and handles
+        inside exclusive workflows always close on their final disconnect.
+        """
+        return ManagedClientHandle(self, canonical_session_path(session_path), factory,
+                                   options_key, exclusive, keepalive)
+
+    async def _acquire(self, handle):
+        self.runtime.assert_owner_loop()
+        if self._closed:
+            raise RuntimeError('Client broker is closed')
+        session = self._sessions.setdefault(handle.session_path, _Session())
+        token = object()
+        async with session.condition:
+            session.waiters.append(token)
+            try:
+                while True:
+                    if self._closed:
+                        raise RuntimeError('Client broker is closed')
+                    if session.failure is not None:
+                        raise RuntimeError('Session cleanup failed; restart the runtime before reusing it') from session.failure
+                    owns_reservation = (session.reservation_owner is not None and
+                                        self._reservations.get().get(handle.session_path) is session.reservation_owner)
+                    allowed = session.reservation_owner is None or owns_reservation
+                    compatible = allowed and (not session.handles or
+                                  (not session.exclusive and not handle.exclusive and
+                                   session.options_key == handle.options_key))
+                    if (session.waiters[0] is token or owns_reservation) and compatible:
+                        break
+                    self._status(True, handle.session_path, token)
+                    await session.condition.wait()
+                if (session.client is not None and not session.handles and
+                        (session.options_key != handle.options_key or handle.exclusive)):
+                    await self._disconnect_client(handle.session_path, session)
+                if session.client is None:
+                    while not self.runtime.leases.try_acquire([handle.session_path], session.lease_owner):
+                        self._status(True, handle.session_path, token)
+                        await asyncio.sleep(0.05)
+                        if self._closed:
+                            raise RuntimeError('Client broker is closed')
+                    self._status(False, token=token)
+                    client = None
+                    try:
+                        candidate = handle.factory()
+                        client = await _await_if_needed(candidate)
+                        await _await_if_needed(client.connect())
+                    except BaseException:
+                        if client is not None:
+                            session.client = client
+                            await self._disconnect_client(handle.session_path, session)
+                        elif session.reservation_owner is None:
+                            self.runtime.leases.release([handle.session_path], session.lease_owner)
+                        raise
+                    session.client = client
+                    session.options_key = handle.options_key
+                    session.exclusive = handle.exclusive
+                else:
+                    await self._reconnect_if_needed(session)
+                session.handles.add(handle)
+                handle._session = session
+            finally:
+                session.waiters.remove(token)
+                self._status(False, token=token)
+                session.condition.notify_all()
+
+    async def _disconnect_client(self, path, session):
+        """Caller holds the session condition; retain ownership on failure."""
+        if session.client is None:
+            return
+        async def physical_disconnect():
+            try:
+                await _await_if_needed(session.client.disconnect())
+            except BaseException as error:
+                session.failure = error
+                raise
+            else:
+                session.client = None
+                if session.reservation_owner is None:
+                    self.runtime.leases.release([path], session.lease_owner)
+        await _settle_cleanup(physical_disconnect())
+
+    async def _reconnect_if_needed(self, session):
+        connected = getattr(session.client, 'is_connected', None)
+        if callable(connected) and not await _await_if_needed(connected()):
+            await _await_if_needed(session.client.connect())
+
+    async def ensure_connected(self, handle):
+        self.runtime.assert_owner_loop()
+        session = handle._session
+        async with session.condition:
+            if session.failure is not None:
+                raise RuntimeError('Session cleanup failed; restart the runtime before reusing it') from session.failure
+            await self._reconnect_if_needed(session)
+
+    async def _release(self, handle):
+        session = handle._session
+        if session is None:
+            return
+        async with session.condition:
+            session.handles.discard(handle)
+            handle._session = None
+            retain_idle = (handle.keepalive and not session.exclusive and
+                           session.reservation_owner is None and not self._closed)
+            try:
+                if not session.handles and not retain_idle:
+                    await self._disconnect_client(handle.session_path, session)
+            finally:
+                session.condition.notify_all()
+
+    async def close(self):
+        self.runtime.assert_owner_loop()
+        self._closed = True
+        async def close_session(path, session):
+            async with session.condition:
+                for handle in session.handles:
+                    handle._session = None
+                session.handles.clear()
+                client, session.client = session.client, None
+                try:
+                    if client is not None:
+                        await _await_if_needed(client.disconnect())
+                finally:
+                    self.runtime.leases.release([path], session.lease_owner)
+                    session.condition.notify_all()
+        results = await asyncio.gather(*(close_session(path, session) for path, session in self._sessions.items()), return_exceptions=True)
+        return results
+
