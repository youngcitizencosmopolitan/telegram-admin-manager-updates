+class ManagedClientHandle:
+    def __init__(self, broker, session_path, factory, options_key, exclusive, keepalive=False):
+        self.broker = broker
+        self.session_path = session_path
+        self.factory = factory
+        self.options_key = options_key
+        self.exclusive = exclusive
+        self.keepalive = keepalive
+        self._session = None
+        self._lock = None
+
+    @property
+    def flood_sleep_threshold(self):
+        if '_tam_flood_sleep_threshold' in self.__dict__:
+            return self.__dict__['_tam_flood_sleep_threshold']
+        if self._session is None:
+            return 60
+        return getattr(self._client(), 'flood_sleep_threshold', 60)
+
+    @flood_sleep_threshold.setter
+    def flood_sleep_threshold(self, value):
+        # Match Telethon's upper bound and its None/zero handling.
+        self._tam_flood_sleep_threshold = min(value or 0, 86400)
+
+    def _owner_lock(self):
+        self.broker.runtime.assert_owner_loop()
+        if self._lock is None:
+            self._lock = asyncio.Lock()
+        return self._lock
+
+    async def connect(self):
+        async with self._owner_lock():
+            if self._session is None:
+                await self.broker._acquire(self)
+            else:
+                await self.broker.ensure_connected(self)
+        return self
+
+    async def disconnect(self):
+        async with self._owner_lock():
+            await _settle_cleanup(self.broker._release(self))
+
+    def _client(self):
+        self.broker.runtime.assert_owner_loop()
+        if self._session is None:
+            raise RuntimeError('Managed client handle is not connected')
+        return self._session.client
+
+    def __getattr__(self, name):
+        attribute = getattr(self._client(), name)
+        if callable(attribute):
+            def call(*args, **kwargs):
+                # Resolve again after reconnect rather than retain an old client.
+                return self._guard_result(getattr(self._client(), name)(*args, **kwargs))
+            return call
+        return attribute
+
+    def _guard_result(self, value, flood_policy=_FLOOD_POLICY_UNSET):
+        if flood_policy is _FLOOD_POLICY_UNSET:
+            flood_policy = self.__dict__.get('_tam_flood_sleep_threshold')
+        # RequestIter implements both protocols. Preserve iteration before
+        # considering await-based collection rather than turning it into a coro.
+        if hasattr(value, '__aiter__'):
+            wrapper = _PolicyAwaitableAsyncIterator if inspect.isawaitable(value) else _PolicyAsyncIterator
+            return wrapper(self, value, flood_policy)
+        if inspect.isawaitable(value):
+            return self._guard_awaitable(value, flood_policy)
+        return value
+
+    def _guard_awaitable(self, value, flood_policy):
+        async def guarded():
+            try:
+                self.broker.runtime.assert_owner_loop()
+            except RuntimeError:
+                _dispose_coroutine(value)
+                raise
+            context_token = CLIENT_FLOOD_POLICY.set(flood_policy)
+            try:
+                return await value
+            finally:
+                CLIENT_FLOOD_POLICY.reset(context_token)
+        return guarded()
+
+    def __call__(self, *args, **kwargs):
+        if '_tam_flood_sleep_threshold' in self.__dict__:
+            kwargs.setdefault('flood_sleep_threshold', self.__dict__['_tam_flood_sleep_threshold'])
+        return self._guard_result(self._client()(*args, **kwargs),
+                                  flood_policy=kwargs.get('flood_sleep_threshold'))
+
+    async def __aenter__(self):
+        await self.connect()
+        return self
+
+    async def __aexit__(self, *exc):
+        await self.disconnect()
