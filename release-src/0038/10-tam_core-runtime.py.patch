+# The concrete TelegramClient adapter consults this policy from convenience
+# methods as well as direct requests. The raw client's stored default is never
+# mutated when independent handles overlap on one connection.
+CLIENT_FLOOD_POLICY = contextvars.ContextVar('tam_client_flood_policy', default=None)
+_FLOOD_POLICY_UNSET = object()
+
+
+async def _await_if_needed(value):
+    if inspect.isawaitable(value):
+        return await value
+    return value
+
+
+async def _settle_cleanup(coroutine):
+    """Keep ownership until physical cleanup settles, even after cancellation."""
+    cleanup = asyncio.create_task(coroutine)
+    cancelled = None
+    while not cleanup.done():
+        try:
+            await asyncio.shield(cleanup)
+        except asyncio.CancelledError as error:
+            cancelled = error
+    result = cleanup.result()
+    if cancelled is not None:
+        raise cancelled
+    return result
+
+
+def _dispose_coroutine(coro):
+    if inspect.iscoroutine(coro):
+        coro.close()
+
