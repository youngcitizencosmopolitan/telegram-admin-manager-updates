+class _PolicyAsyncIterator:
+    """Preserve lazy async iteration without dropping the handle's policy."""
+    def __init__(self, handle, source, flood_policy):
+        self._handle = handle
+        self._source = source
+        self._iterator = source if hasattr(source, '__anext__') else None
+        self._flood_policy = flood_policy
+
+    def _invoke(self, method, *args, **kwargs):
+        self._handle.broker.runtime.assert_owner_loop()
+        token = CLIENT_FLOOD_POLICY.set(self._flood_policy)
+        try:
+            value = method(*args, **kwargs)
+        finally:
+            CLIENT_FLOOD_POLICY.reset(token)
+        return self._handle._guard_result(value, flood_policy=self._flood_policy)
+
+    def __aiter__(self):
+        self._handle.broker.runtime.assert_owner_loop()
+        token = CLIENT_FLOOD_POLICY.set(self._flood_policy)
+        try:
+            self._iterator = self._source.__aiter__()
+        finally:
+            CLIENT_FLOOD_POLICY.reset(token)
+        return self
+
+    async def __anext__(self):
+        if self._iterator is None:
+            self.__aiter__()
+        return await self._invoke(self._iterator.__anext__)
+
+    def __getattr__(self, name):
+        self._handle.broker.runtime.assert_owner_loop()
+        target = self._iterator if self._iterator is not None and hasattr(self._iterator, name) else self._source
+        attribute = getattr(target, name)
+        if callable(attribute):
+            def call(*args, **kwargs):
+                return self._invoke(attribute, *args, **kwargs)
+            return call
+        return attribute
+
+
+class _PolicyAwaitableAsyncIterator(_PolicyAsyncIterator):
+    def __await__(self):
+        return self._handle._guard_awaitable(self._source, self._flood_policy).__await__()
+
