+    async def test_rule_limit_does_not_reserve_idle_account_from_other_rule(self):
+        self.file('a.mp4', b'first')
+        self.file('b.mp4', b'second')
+        other_folder = self.root / 'other'
+        other_folder.mkdir()
+        (other_folder / 'c.mp4').write_bytes(b'other')
+        first_started, other_started, release = asyncio.Event(), asyncio.Event(), asyncio.Event()
+        busy = []
+
+        class Client:
+            def __init__(self, session): self.session = session
+            async def upload_file(self, path, **kwargs):
+                if Path(path).parent == other_folder:
+                    other_started.set()
+                else:
+                    busy.append(self.session)
+                    first_started.set()
+                    await release.wait()
+                return SimpleNamespace(path=path, name=Path(path).name)
+            async def send_file(self, *args, **kwargs): return SimpleNamespace(id=1)
+
+        clients = {s: (self.account, Client(s)) for s in ('s1', 's2')}
+        locks = {s: asyncio.Lock() for s in clients}
+        self.pane._effective_task_sessions = lambda task, *args: (
+            [s for s in clients if s != busy[0]] if task['id'] == 'r2' else list(clients))
+        first = dict(self.rule, parallel_auto=False, parallel=1)
+        other = dict(self.rule, id='r2', folder=str(other_folder))
+        self.pane.live_tasks['r2'] = other
+
+        async def run(rule):
+            await self.pane._run_one_task(rule, clients, {}, locks, asyncio.Semaphore(100),
+                asyncio.Semaphore(2), asyncio.Semaphore(2), preparation=self.pool)
+
+        tasks = [asyncio.create_task(run(first))]
+        try:
+            await asyncio.wait_for(first_started.wait(), 3)
+            # Let the second worker of the limited rule reach its slot wait.
+            await asyncio.sleep(0.1)
+            tasks.append(asyncio.create_task(run(other)))
+            await asyncio.wait_for(other_started.wait(), 2)
+        finally:
+            release.set()
+            await asyncio.wait_for(asyncio.gather(*tasks), 5)
