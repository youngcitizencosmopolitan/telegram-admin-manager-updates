+    async def test_automatic_rule_starts_two_accounts_concurrently(self):
+        self.file('a.mp4', b'first')
+        self.file('b.mp4', b'second')
+        started = set()
+        both = asyncio.Event()
+        release = asyncio.Event()
+
+        class Client:
+            def __init__(self, session): self.session = session
+            async def upload_file(self, path, **kwargs):
+                started.add(self.session)
+                if len(started) == 2: both.set()
+                await release.wait()
+                return SimpleNamespace(path=path, name=Path(path).name)
+            async def send_file(self, *args, **kwargs): return SimpleNamespace(id=1)
+
+        clients = {s: (self.account, Client(s)) for s in ('s1', 's2')}
+        self.pane._effective_task_sessions = lambda *args: list(clients)
+        running = asyncio.create_task(self.pane._run_one_task(dict(self.rule), clients, {},
+            {s: asyncio.Lock() for s in clients}, asyncio.Semaphore(100), asyncio.Semaphore(2),
+            asyncio.Semaphore(2), preparation=self.pool))
+        try:
+            await asyncio.wait_for(both.wait(), 3)
+            self.assertEqual(started, {'s1', 's2'})
+        finally:
+            release.set()
+            await asyncio.wait_for(running, 3)
