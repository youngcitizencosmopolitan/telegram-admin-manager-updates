+class TkCase(unittest.TestCase):
+    def setUp(self):
+        try:
+            self.root = tk.Tk()
+        except tk.TclError as exc:
+            self.skipTest(f'Tk display is unavailable: {exc}')
+        self.addCleanup(self.root.destroy)
+        self.root.withdraw()
+        self.root.attributes('-alpha', 0)
+        self.clipboard = []
+        for name, new in (('clipboard_clear', lambda _w, **_k: self.clipboard.clear()),
+                          ('clipboard_append', lambda _w, text, **_k: self.clipboard.append(text))):
+            patcher = patch.object(tk.Misc, name, new)
+            patcher.start()
+            self.addCleanup(patcher.stop)
+
+    @property
+    def copied(self):
+        return ''.join(self.clipboard)
+
+    def show_transparently(self):
+        self.root.geometry('500x220')
+        self.root.deiconify()
+        self.root.update()
+
+    def make_tree(self, **options):
+        options.setdefault('columns', ('status', 'size', 'hidden'))
+        options.setdefault('displaycolumns', ('size', 'status'))
+        options.setdefault('show', 'tree headings')
+        options.setdefault('selectmode', 'extended')
+        options.setdefault('height', 5)
+        tree = ttk.Treeview(self.root, **options)
+        for column, title in (('#0', 'Файл'), ('status', 'Статус'), ('size', 'Размер'), ('hidden', 'Скрыто')):
+            if column == '#0' or column in options['columns']:
+                tree.heading(column, text=title)
+        tree.pack(fill='both', expand=True)
+        return tree
+
+    def fill(self, tree, count=3):
+        for n in range(count):
+            tree.insert('', 'end', iid=f'r{n}', text=f'file{n}', values=(f's{n}', f'{n} Б', f'secret{n}'))
+
