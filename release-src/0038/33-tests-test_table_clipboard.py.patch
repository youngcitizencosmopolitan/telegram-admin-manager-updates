+class TsvFormatTests(unittest.TestCase):
+    def test_plain_rows_use_tabs_and_lf_without_trailing_newline(self):
+        self.assertEqual(to_tsv([['a', 'b'], ['1', '2']]), 'a\tb\n1\t2')
+
+    def test_special_characters_are_quoted_and_round_trip(self):
+        rows = [['with\ttab', 'with\nnewline'], ['with "quote"', 'plain']]
+        self.assertEqual(parse_tsv(to_tsv(rows)), rows)
+        self.assertIn('"with\ttab"', to_tsv(rows))
+        self.assertIn('"with ""quote"""', to_tsv(rows))
+
+    def test_carriage_returns_are_normalised_so_they_cannot_split_rows(self):
+        text = to_tsv([['one\r\ntwo', 'three\rfour'], ['x', 'y']])
+        self.assertNotIn('\r', text)
+        self.assertEqual(parse_tsv(text), [['one\ntwo', 'three\nfour'], ['x', 'y']])
+
