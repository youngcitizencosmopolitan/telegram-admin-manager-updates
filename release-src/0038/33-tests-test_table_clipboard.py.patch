+class PhysicalShortcutTests(unittest.TestCase):
+    def test_latin_and_russian_keysyms_map_to_the_same_physical_letter(self):
+        for keysym, letter in (('a', 'a'), ('A', 'a'), ('Cyrillic_ef', 'a'), ('Cyrillic_EF', 'a'),
+                               ('c', 'c'), ('C', 'c'), ('Cyrillic_es', 'c'), ('Cyrillic_ES', 'c')):
+            with self.subTest(keysym=keysym):
+                self.assertEqual(physical_ctrl_letter(key(keysym)), letter)
+
+    @unittest.skipUnless(sys.platform == 'win32', 'Virtual keycodes are specific to Windows')
+    def test_windows_virtual_keycodes_identify_the_physical_key(self):
+        self.assertEqual(physical_ctrl_letter(key('??', 65)), 'a')
+        self.assertEqual(physical_ctrl_letter(key('??', 67)), 'c')
+
+    def test_other_keys_and_extra_modifiers_are_not_claimed(self):
+        self.assertIsNone(physical_ctrl_letter(key('v', 86)))
+        self.assertIsNone(physical_ctrl_letter(key('Cyrillic_em', 86)))
+        self.assertIsNone(physical_ctrl_letter(key('Control_L', 17)))
+        self.assertIsNone(physical_ctrl_letter(key('c', 67, CTRL | SHIFT)))
+        self.assertIsNone(physical_ctrl_letter(key('c', 67, CTRL | ALT)))
+
