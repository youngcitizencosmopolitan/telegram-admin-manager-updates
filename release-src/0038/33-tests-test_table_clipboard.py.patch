+"""Task 5: table multi-selection and clipboard.
+
+Everything runs on real Tk widgets in a withdrawn or fully transparent window.
+The application is never launched and the user's clipboard is never touched:
+``tk.Misc.clipboard_*`` is replaced for the duration of every test.
+"""
+import csv
+import io
+import re
+import sys
+import tempfile
+import tkinter as tk
+import unittest
+from pathlib import Path
+from tkinter import ttk
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+from tam_ui.table_clipboard import (
+    actions_for,
+    install_table_actions,
+    physical_ctrl_letter,
+    preserve_view,
+    selected_items,
+    single_selection,
+    telegram_link,
+    to_tsv,
+)
+
+ROOT = Path(__file__).resolve().parents[1]
+CTRL = 0x4
+SHIFT = 0x1
+ALT = 0x20000 if sys.platform == 'win32' else 0x8
+
+
+def key(keysym='', keycode=0, state=CTRL):
+    return SimpleNamespace(keysym=keysym, keycode=keycode, state=state)
+
+
+def parse_tsv(text):
+    return list(csv.reader(io.StringIO(text), dialect='excel-tab'))
+
+
+def menu_labels(menu):
+    end = menu.index('end')
+    if end is None:
+        return []
+    return [menu.entrycget(i, 'label') for i in range(end + 1) if menu.type(i) != 'separator']
+
