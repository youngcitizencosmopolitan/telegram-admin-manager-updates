+class PreserveViewTests(TkCase):
+    def test_selection_and_focus_survive_a_full_rebuild(self):
+        tree = self.make_tree()
+        self.fill(tree, 5)
+        tree.selection_set(('r1', 'r3'))
+        tree.focus('r3')
+        with preserve_view(tree):
+            tree.delete(*tree.get_children())
+            self.fill(tree, 5)
+        self.assertEqual(tree.selection(), ('r1', 'r3'))
+        self.assertEqual(tree.focus(), 'r3')
+
+    def test_rows_that_disappeared_are_dropped_from_the_selection(self):
+        tree = self.make_tree()
+        self.fill(tree, 5)
+        tree.selection_set(('r1', 'r4'))
