+class ConfigSnapshotTests(unittest.TestCase):
+    def test_account_refresh_cannot_restore_removed_account_or_old_label(self):
+        from tam_core.repositories import ConfigStore
+        from tam_core.models import Account
+        with tempfile.TemporaryDirectory() as folder:
+            store = ConfigStore(Path(folder) / "config.json")
+            first = Account("first", "old label", "111", 1)
+            removed = Account("removed", "removed", "222", 2)
+            store.set_accounts([first, removed])
+            stale_observations = store.accounts()
+            stale_observations[0].premium = True
+            stale_observations[0].username = "fresh_server_name"
+            first.label = "edited label"
+            store.set_accounts([first])
+            store.refresh_accounts(stale_observations)
+            accounts = store.accounts()
+            self.assertEqual([a.session for a in accounts], ["first"])
+            self.assertEqual(accounts[0].label, "edited label")
+            self.assertTrue(accounts[0].premium)
+            self.assertEqual(accounts[0].username, "fresh_server_name")
+            snapshot = store.snapshot()
+            snapshot["accounts"][0]["label"] = "alias mutation"
+            self.assertEqual(store.accounts()[0].label, "edited label")
+
