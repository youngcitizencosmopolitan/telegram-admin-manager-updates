+class LivePermitTests(unittest.IsolatedAsyncioTestCase):
+    async def test_reduction_drains_existing_permits_and_gates_new_work(self):
+        from tam_core.live_rules import LiveSemaphore
+        limit = [2]
+        sem = LiveSemaphore(lambda: limit[0])
+        await sem.__aenter__()
+        await sem.__aenter__()
+        limit[0] = 1
+        started, entered = asyncio.Event(), asyncio.Event()
+        async def waiting():
+            started.set()
+            async with sem:
+                entered.set()
+        waiter = asyncio.create_task(waiting())
+        await started.wait()
+        self.assertFalse(entered.is_set())
+        await sem.__aexit__()
+        self.assertEqual(sem.active, 1)
+        self.assertFalse(entered.is_set())
+        await sem.__aexit__()
+        await asyncio.wait_for(waiter, 1)
+        self.assertTrue(entered.is_set())
+        self.assertEqual(sem.active, 0)
+
+    async def test_network_bridge_uses_app_runtime(self):
+        from batch_uploader import BatchUploaderPane
+        pane = BatchUploaderPane.__new__(BatchUploaderPane)
+        seen = []
+        pane.app = SimpleNamespace(run_async=lambda coro: seen.append(coro) or "runtime")
+        async def work(): return 1
+        coro = work()
+        try:
+            self.assertEqual(pane._run_async(coro), "runtime")
+            self.assertEqual(seen, [coro])
+        finally:
+            coro.close()
