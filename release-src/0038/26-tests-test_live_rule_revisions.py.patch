+class ConcurrentScanTests(RuleRevisionTests):
+    def test_scan_finishing_after_route_edit_or_delete_is_discarded(self):
+        for action in (lambda: self.rules.update_fields("r", {"target": "new"}), lambda: self.rules.delete("r")):
+            old = self.rules.get("r")
+            ready, finish = threading.Event(), threading.Event()
+            result = []
+            def scan():
+                ready.set()
+                if not finish.wait(2):
+                    raise RuntimeError("test barrier timeout")
+                result.append(self.rules.commit_scan("r", old["route_revision"], {"monitor_signature": "stale"}, {"stale.mp4"}))
+            worker = threading.Thread(target=scan)
+            worker.start()
+            self.assertTrue(ready.wait(2))
+            action()
+            finish.set()
+            worker.join(2)
+            self.assertFalse(worker.is_alive())
+            self.assertEqual(result, [{}])
+            self.assertEqual(self.rules.seen_files("r"), set())
+
