+class RuleRevisionTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.db = StateDatabase(Path(self.tmp.name) / "state.db")
+        self.rules = MonitorRuleStore(self.db)
+        self.rules.put({"id": "r", "folder": "a", "target": "one", "monitor_folder": True})
+
+    def test_stale_edit_cannot_overwrite_new_caption(self):
+        stale = self.rules.get("r")
+        fresh = self.rules.update_fields("r", {"caption": "new"})
+        self.assertGreater(fresh["revision"], stale["revision"])
+        stale["caption"] = "old"
+        with self.assertRaises(ValueError):
+            self.rules.put(stale)
+        self.assertEqual(self.rules.get("r")["caption"], "new")
+
+    def test_deleted_stale_rule_cannot_resurrect(self):
+        stale = self.rules.get("r")
+        self.rules.delete("r")
+        with self.assertRaises(ValueError):
+            self.rules.put(stale)
+        self.assertEqual(self.rules.get("r"), {})
+
+    def test_scan_commit_is_atomic_and_route_guarded(self):
+        old = self.rules.get("r")
+        self.rules.update_fields("r", {"target": "two"})
+        accepted = self.rules.commit_scan("r", old["route_revision"], {"monitor_seen_initialized": True}, {"old.mp4"})
+        self.assertEqual(accepted, {})
+        self.assertEqual(self.rules.seen_files("r"), set())
+        self.assertNotIn("monitor_seen_initialized", self.rules.get("r"))
+
+    def test_caption_change_keeps_route_and_scan_preserves_caption(self):
+        old = self.rules.get("r")
+        new = self.rules.update_fields("r", {"caption": "new"})
+        self.assertEqual(new["route_revision"], old["route_revision"])
+        accepted = self.rules.commit_scan("r", old["route_revision"], {"monitor_seen_initialized": True}, {"file.mp4"})
+        self.assertEqual(accepted["caption"], "new")
+        self.assertEqual(self.rules.seen_files("r"), {"file.mp4"})
+
+if __name__ == "__main__": unittest.main()
+
