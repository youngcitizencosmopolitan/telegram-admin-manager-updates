+class ClientBoundaryTests(unittest.IsolatedAsyncioTestCase):
+    async def test_file_boundary_releases_old_and_fresh_route_handle(self):
+        from batch_uploader import BatchUploaderPane
+        events = []
+        class Handle:
+            def __init__(self, label): self.label = label
+            async def connect(self): events.append(("connect", self.label))
+            async def disconnect(self): events.append(("disconnect", self.label))
+        pane = BatchUploaderPane.__new__(BatchUploaderPane)
+        pane.app = SimpleNamespace(_runtime_enabled=True, _api_credentials=lambda: (123,"newkey"))
+        pane.sessions_dir = Path("synthetic")
+        def factory(path, api_id, api_hash, **kw):
+            events.append(("factory",api_id,api_hash))
+            return Handle("fresh")
+        pane._new_telegram_client = factory
+        old = Handle("old")
+        clients = {"s": (object(), old)}
+        async with pane._file_client_lease("s",clients,old) as current:
+            self.assertIs(current,clients["s"][1])
+            events.append(("transfer",current.label))
+        self.assertEqual(events, [("disconnect","old"),("factory",123,"newkey"),("connect","fresh"),("transfer","fresh"),("disconnect","fresh")])
