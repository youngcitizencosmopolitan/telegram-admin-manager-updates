+        repo.put(self.rule)
+        self.rule = repo.get("r1")
+        self.pane.app.monitor_rules = repo
+        uploading, edited = asyncio.Event(), asyncio.Event()
+        sent = []
+        owner = self
+        class Client:
+            async def upload_file(self, path, **kwargs):
+                if Path(path) == first:
+                    uploading.set()
+                    await asyncio.wait_for(edited.wait(), 2)
+                return SimpleNamespace(path=path, name=Path(path).name)
+            async def send_file(self, entity, file, **kwargs):
