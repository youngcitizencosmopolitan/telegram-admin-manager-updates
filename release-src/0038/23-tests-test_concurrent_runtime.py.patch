+class Client:
+    def __init__(self, events, name='client', fail=False):
+        self.events, self.name, self.fail = events, name, fail
+        self.loop = asyncio.get_running_loop()
+
+    async def connect(self):
+        self.events.append(('connect', self.name))
+        if self.fail:
+            raise ValueError('connect failed')
+
+    def disconnect(self):
+        async def close():
+            self.events.append(('disconnect', self.name))
+        return close()
+
+    async def __call__(self, value):
+        assert asyncio.get_running_loop() is self.loop
+        return value
+
+    async def read(self):
+        return self.name
+
