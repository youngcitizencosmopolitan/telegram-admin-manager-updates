+    def test_submissions_share_loop_and_cancel_independently(self):
+        started = threading.Event()
+        async def pending():
+            started.set()
+            await asyncio.Event().wait()
+        first = self.runtime.submit(pending())
+        self.assertTrue(started.wait(2))
+        async def identity():
+            return asyncio.get_running_loop()
+        self.assertIs(self.runtime.run(identity()), self.runtime.loop)
+        first.cancel()
+        self.assertIs(self.runtime.run(identity()), self.runtime.loop)
