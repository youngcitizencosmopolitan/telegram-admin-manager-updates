+            first = broker.handle('reserved', lambda: Client(events))
+            await first.connect()
+            entered = asyncio.Event()
+            release = asyncio.Event()
+            async def authorise():
+                async with broker.exclusive('reserved'):
+                    entered.set()
+                    async with broker.exclusive('reserved'):
+                        async with broker.handle('reserved', lambda: Client(events, 'auth')) as own:
+                            self.assertEqual(await own.read(), 'auth')
+                    await release.wait()
+            auth = asyncio.create_task(authorise())
+            await asyncio.sleep(0)
+            self.assertFalse(entered.is_set())
+            await first.disconnect()
+            await entered.wait()
+            reader = broker.handle('reserved', lambda: Client(events, 'reader'))
+            pending = asyncio.create_task(reader.connect())
+            await asyncio.sleep(0)
+            self.assertFalse(pending.done())
+            release.set()
+            await auth
+            await pending
+            await reader.disconnect()
+        runtime.run(work(), timeout=3)
