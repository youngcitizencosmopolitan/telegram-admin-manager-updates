+class ScopedFloodPolicyTests(unittest.TestCase):
+    def test_concurrent_utility_calls_assignment_and_explicit_request_are_isolated(self):
+        from tam_core.runtime import CLIENT_FLOOD_POLICY
+        runtime = AsyncRuntime()
+        self.addCleanup(runtime.close)
+        class PolicyClient(Client):
+            @property
+            def flood_sleep_threshold(self):
+                requested = CLIENT_FLOOD_POLICY.get()
+                return 60 if requested is None else requested
+
+            async def utility(self, entered, release):
+                before = self.flood_sleep_threshold
+                entered.set()
+                await release.wait()
+                return before, self.flood_sleep_threshold
+
+            async def __call__(self, value, *, flood_sleep_threshold=None):
+                await asyncio.sleep(0)
+                return value, flood_sleep_threshold, self.flood_sleep_threshold
+
+        async def work():
+            admin = runtime.broker.handle('policy', lambda: PolicyClient([]))
+            admin.flood_sleep_threshold = 0
+            upload = runtime.broker.handle('policy', lambda: PolicyClient([]))
+            upload.flood_sleep_threshold = 60
+            admin_entered, upload_entered, release = asyncio.Event(), asyncio.Event(), asyncio.Event()
+            async with admin, upload:
+                pending_admin = asyncio.create_task(admin.utility(admin_entered, release))
+                pending_upload = asyncio.create_task(upload.utility(upload_entered, release))
+                await admin_entered.wait()
+                await upload_entered.wait()
+                admin.flood_sleep_threshold = 7
+                release.set()
+                self.assertEqual(await pending_admin, (0, 0))
+                self.assertEqual(await pending_upload, (60, 60))
+                self.assertEqual(await admin('next'), ('next', 7, 7))
+                self.assertEqual(await upload('upload'), ('upload', 60, 60))
+                self.assertEqual(await admin('explicit', flood_sleep_threshold=11), ('explicit', 11, 11))
+                self.assertEqual(await admin('default', flood_sleep_threshold=None), ('default', None, 60))
+                self.assertEqual(admin.flood_sleep_threshold, 7)
+                self.assertIsNone(CLIENT_FLOOD_POLICY.get())
+                admin.flood_sleep_threshold = 90000
+                self.assertEqual(admin.flood_sleep_threshold, 86400)
+                admin.flood_sleep_threshold = None
+                self.assertEqual(admin.flood_sleep_threshold, 0)
+        runtime.run(work(), timeout=2)
+
+    def test_cancelled_utility_restores_callers_policy(self):
+        from tam_core.runtime import CLIENT_FLOOD_POLICY
+        runtime = AsyncRuntime()
+        self.addCleanup(runtime.close)
+        class PolicyClient(Client):
+            async def utility(self):
+                self_seen = CLIENT_FLOOD_POLICY.get()
+                raise asyncio.CancelledError(self_seen)
+        async def work():
+            handle = runtime.broker.handle('policy', lambda: PolicyClient([]))
+            handle.flood_sleep_threshold = 0
+            async with handle:
+                previous = CLIENT_FLOOD_POLICY.set(13)
+                try:
+                    with self.assertRaises(asyncio.CancelledError) as caught:
+                        await handle.utility()
+                    self.assertEqual(caught.exception.args, (0,))
+                    self.assertEqual(CLIENT_FLOOD_POLICY.get(), 13)
+                finally:
+                    CLIENT_FLOOD_POLICY.reset(previous)
+        runtime.run(work(), timeout=2)
+
