+class ScopedIteratorPolicyTests(unittest.TestCase):
+    def test_iterators_and_await_collection_preserve_captured_policy(self):
+        from tam_core.runtime import CLIENT_FLOOD_POLICY
+        runtime = AsyncRuntime()
+        self.addCleanup(runtime.close)
+        class Rows:
+            def __init__(self, client):
+                self.client, self.remaining, self.closed_policy = client, 2, None
+            def __aiter__(self):
+                return self
+            async def __anext__(self):
+                if not self.remaining:
+                    raise StopAsyncIteration
+                self.remaining -= 1
+                before = self.client.flood_sleep_threshold
+                await asyncio.sleep(0)
+                return before, self.client.flood_sleep_threshold
+            async def collect(self):
+                return [row async for row in self]
+            def __await__(self):
+                return self.collect().__await__()
+            async def aclose(self):
+                await asyncio.sleep(0)
+                self.closed_policy = self.client.flood_sleep_threshold
+                return self.closed_policy
+        class PolicyClient(Client):
+            @property
+            def flood_sleep_threshold(self):
+                policy = CLIENT_FLOOD_POLICY.get()
+                return 60 if policy is None else policy
+            def iter_rows(self):
+                return Rows(self)
+        async def work():
+            admin = runtime.broker.handle('iterator', lambda: PolicyClient([]))
+            upload = runtime.broker.handle('iterator', lambda: PolicyClient([]))
+            admin.flood_sleep_threshold = 0
+            upload.flood_sleep_threshold = 60
+            async with admin, upload:
+                rows = admin.iter_rows()
+                admin.flood_sleep_threshold = 7
+                async def consume(iterator):
+                    return [row async for row in iterator]
+                first, second = await asyncio.gather(consume(rows), consume(upload.iter_rows()))
+                self.assertEqual(first, [(0, 0), (0, 0)])
+                self.assertEqual(second, [(60, 60), (60, 60)])
+                self.assertEqual(await rows.aclose(), 0)
+                self.assertEqual(await admin.iter_rows(), [(7, 7), (7, 7)])
+                self.assertIsNone(CLIENT_FLOOD_POLICY.get())
+        runtime.run(work(), timeout=2)
+
+    def test_cancelled_next_and_explicit_close_restore_callers_context(self):
+        from tam_core.runtime import CLIENT_FLOOD_POLICY
+        runtime = AsyncRuntime()
+        self.addCleanup(runtime.close)
+        class PolicyClient(Client):
+            def iter_rows(self):
+                async def rows():
+                    try:
+                        yield CLIENT_FLOOD_POLICY.get()
+                        raise asyncio.CancelledError(CLIENT_FLOOD_POLICY.get())
+                    finally:
+                        self.closed_policy = CLIENT_FLOOD_POLICY.get()
+                return rows()
+        async def work():
+            handle = runtime.broker.handle('generator', lambda: PolicyClient([]))
+            handle.flood_sleep_threshold = 0
+            async with handle:
+                iterator = handle.iter_rows()
+                before = CLIENT_FLOOD_POLICY.set(13)
+                try:
+                    self.assertEqual(await anext(iterator), 0)
+                    with self.assertRaises(asyncio.CancelledError) as caught:
+                        await anext(iterator)
+                    self.assertEqual(caught.exception.args, (0,))
+                    self.assertEqual(CLIENT_FLOOD_POLICY.get(), 13)
+                    fresh = handle.iter_rows()
+                    self.assertEqual(await anext(fresh), 0)
+                    await fresh.aclose()
+                    self.assertEqual(handle.closed_policy, 0)
+                    self.assertEqual(CLIENT_FLOOD_POLICY.get(), 13)
+                finally:
+                    CLIENT_FLOOD_POLICY.reset(before)
+        runtime.run(work(), timeout=2)
+
+
+if __name__ == '__main__':
+    unittest.main()
