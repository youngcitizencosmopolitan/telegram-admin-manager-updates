+    def test_global_limit_and_decrease_drain_active_files(self):
+        async def work():
+            cap = [2]
+            first_release, second_release = asyncio.Event(), asyncio.Event()
+            first_entered, second_entered, third_entered = asyncio.Event(), asyncio.Event(), asyncio.Event()
+            async def transfer(account, entered, release):
+                async with self.runtime.transfer_slot(account, lambda: cap[0]):
+                    entered.set()
+                    await release.wait()
+            first = asyncio.create_task(transfer('a', first_entered, first_release))
+            second = asyncio.create_task(transfer('b', second_entered, second_release))
+            await first_entered.wait()
