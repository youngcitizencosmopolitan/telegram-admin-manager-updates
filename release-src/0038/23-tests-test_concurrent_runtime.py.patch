+class SharedWaitStatusTests(unittest.TestCase):
+    def test_free_child_and_cancelled_child_do_not_clear_another_child_wait(self):
+        from tam_core.operations import OperationRegistry
+        runtime = AsyncRuntime()
+        self.addCleanup(runtime.close)
+        operation = OperationRegistry().start('parallel')
+        async def work():
+            held = runtime.broker.handle('busy', lambda: Client([]))
+            await held.connect()
+            with runtime.broker.operation(operation):
+                first = runtime.broker.handle('busy', lambda: Client([]), exclusive=True)
+                second = runtime.broker.handle('busy', lambda: Client([]), exclusive=True)
+                waiting = asyncio.create_task(first.connect())
+                remaining = asyncio.create_task(second.connect())
+                await asyncio.sleep(0)
+                self.assertEqual(operation.snapshot()['status'], 'waiting')
+                async with runtime.broker.handle('free', lambda: Client([])):
+                    self.assertEqual(operation.snapshot()['status'], 'waiting')
+                waiting.cancel()
+                with self.assertRaises(asyncio.CancelledError):
+                    await waiting
+                self.assertEqual(operation.snapshot()['status'], 'waiting')
+                await held.disconnect()
+                await remaining
+                self.assertEqual(operation.snapshot()['status'], 'running')
+                await second.disconnect()
+        runtime.run(work(), timeout=2)
