+class _FileBody:
+    """Innermost context of one file attempt: tells acquisition failures from body failures."""
+
+    def __init__(self, on_exception):
+        self.on_exception = on_exception
+        self.finished = False
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb):
+        self.finished = True
+        if exc is not None:
+            self.on_exception()
+        return False
+
