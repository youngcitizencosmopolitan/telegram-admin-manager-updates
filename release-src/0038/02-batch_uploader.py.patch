+async def _disconnect_settled(client: Any) -> None:
+    """Close a handle no registry owns yet; further cancellation cannot abandon it."""
+    if client is None:
+        return
+
+    async def close() -> None:
+        await client.disconnect()
+
+    cleanup = asyncio.create_task(close())
+    while not cleanup.done():
+        try:
+            await asyncio.shield(cleanup)
+        except asyncio.CancelledError:
+            continue
+        except Exception:
+            break
+    if not cleanup.cancelled():
+        cleanup.exception()
+
+
+async def _settled_thread_result(function: Any, *args: Any) -> tuple[Any, asyncio.CancelledError | None]:
+    """Finish blocking work whose result must be seen; return it with any pending cancel."""
+    work = asyncio.create_task(asyncio.to_thread(function, *args))
+    cancelled = None
+    while not work.done():
+        try:
+            await asyncio.shield(work)
+        except asyncio.CancelledError as exc:
+            cancelled = exc
+        except Exception:
+            break
+    try:
+        return work.result(), cancelled
+    except Exception:
+        if cancelled is not None:
+            raise cancelled
+        raise
 
 
