+"""Thread-safe operation tracking and arbitration for legacy session owners."""
+from __future__ import annotations
+
+from collections import OrderedDict
+from contextlib import contextmanager
+from concurrent.futures import CancelledError
+import copy
+import os
+import threading
+import time
+import uuid
+
+
+def canonical_session_path(path):
+    """Resolve aliases before comparing Telethon session ownership."""
+    path = os.fspath(path)
+    if not path.endswith('.session'):
+        path += '.session'
+    return os.path.normcase(os.path.realpath(os.path.abspath(path)))
+
+
+class Operation:
+    def __init__(self, registry, label, kind, resources):
+        self._registry = registry
+        self.id = uuid.uuid4().hex
+        self.cancel_event = threading.Event()
+        self._data = dict(id=self.id, label=str(label), kind=str(kind),
+                          resources=tuple(resources), status='running', progress=None,
+                          detail='', result=None, error=None, started_at=time.time(), finished_at=None)
+
+    def update(self, *, status=None, progress=None, detail=None):
+        with self._registry._lock:
+            if self._data['finished_at'] is not None:
+                return
+            if status is not None:
+                if status not in ('running', 'waiting', 'cancelling'):
+                    raise ValueError('Use finish() for terminal status')
+                self._data['status'] = 'cancelling' if self.cancel_event.is_set() else status
+            if progress is not None:
+                self._data['progress'] = copy.deepcopy(progress)
+            if detail is not None:
+                self._data['detail'] = str(detail)
+
+    def finish(self, result=None, error=None):
+        return self._registry.finish(self.id, result=result, error=error)
+
+    def cancel(self):
+        return self._registry.cancel(self.id)
+
+    def snapshot(self):
+        with self._registry._lock:
+            return copy.deepcopy(self._data)
+
+
+class OperationRegistry:
+    def __init__(self, max_completed=100):
+        self._lock = threading.RLock()
+        self._operations = OrderedDict()
+        self._max_completed = max(0, int(max_completed))
+        self._completed = OrderedDict()
+
+    def start(self, label, kind='worker', resources=()):
+        with self._lock:
+            operation = Operation(self, label, kind, resources)
+            self._operations[operation.id] = operation
+            return operation
+
+    def cancel(self, operation_id):
+        with self._lock:
+            operation = self._operations.get(operation_id)
+            if operation is None or operation._data['finished_at'] is not None:
+                return False
+            operation.cancel_event.set()
+            operation._data['status'] = 'cancelling'
+            return True
+
+    def cancel_all(self):
+        with self._lock:
+            for operation_id in tuple(self._operations):
+                self.cancel(operation_id)
+
+    def finish(self, operation_id, result=None, error=None):
+        with self._lock:
+            operation = self._operations.get(operation_id)
+            if operation is None or operation._data['finished_at'] is not None:
+                return False
+            operation._data.update(status=('failed' if error is not None else
+                                          'cancelled' if operation.cancel_event.is_set() else 'completed'),
+                                   result=copy.deepcopy(result), error=str(error) if error is not None else None,
+                                   finished_at=time.time())
+            self._completed[operation_id] = None
+            while len(self._completed) > self._max_completed:
+                expired, _ = self._completed.popitem(last=False)
+                self._operations.pop(expired, None)
+            return True
+
+    def snapshot(self):
+        with self._lock:
+            return [operation.snapshot() for operation in self._operations.values()]
+
+
+class SessionLeaseManager:
+    """Exclusive ownership shared by legacy workers and the managed broker.
+
+    Acquire all resources atomically, so reversed multi-session requests cannot
+    deadlock. Cancellation polling is bounded even without an explicit wake.
+    """
+    def __init__(self):
+        self._condition = threading.Condition()
+        self._owners = {}
+        self._closed = False
+
+    def try_acquire(self, resources, owner):
+        keys = tuple(sorted(set(canonical_session_path(key) for key in resources)))
+        with self._condition:
+            if self._closed:
+                raise RuntimeError('Session leases are closed')
+            if any(key in self._owners and self._owners[key] is not owner for key in keys):
+                return False
+            for key in keys:
+                self._owners[key] = owner
+            return True
+
+    def release(self, resources, owner):
+        with self._condition:
+            for resource in resources:
+                key = canonical_session_path(resource)
+                if self._owners.get(key) is owner:
+                    del self._owners[key]
+            self._condition.notify_all()
+
+    @contextmanager
+    def lease(self, resources, cancel_event=None):
+        resources = tuple(resources)
+        owner = object()
+        acquired = False
+        try:
+            with self._condition:
+                while True:
+                    if cancel_event is not None and cancel_event.is_set():
+                        raise CancelledError()
+                    if self.try_acquire(resources, owner):
+                        acquired = True
+                        break
+                    self._condition.wait(0.05)
+            yield
+        finally:
+            if acquired:
+                self.release(resources, owner)
+
+    def wake_waiters(self):
+        with self._condition:
+            self._condition.notify_all()
+
+    def close(self):
+        with self._condition:
+            self._closed = True
+            self._condition.notify_all()
