+    def test_cancelled_queued_worker_runs_completion_cleanup(self):
+        app = self.app()
+        release = threading.Event()
+        started = [threading.Event() for _ in range(8)]
+        cleaned = threading.Event()
+        def occupied(event):
+            event.set()
+            release.wait(2)
+        try:
+            for index, event in enumerate(started):
+                app.run_worker(lambda event=event: occupied(event), str(index))
+            for event in started:
+                self.assertTrue(event.wait(1))
+            app.run_worker(lambda: None, 'queued', on_finished=cleaned.set)
+            row = next(row for row in app._operations.snapshot() if row['label'] == 'queued')
+            app._operations.cancel(row['id'])
+            release.set()
+            self.assertTrue(cleaned.wait(1))
+        finally:
+            release.set()
+
+    def test_ui_cancel_of_queued_worker_cleans_up_before_pool_is_free(self):
+        app = self.app()
+        release, cleaned = threading.Event(), threading.Event()
+        started = [threading.Event() for _ in range(8)]
+        app.busy_label = Mock()
+        app._busy = False
+        app.after = Mock(return_value='scheduled')
+        def occupied(event):
+            event.set()
+            release.wait(2)
+        try:
+            for index, event in enumerate(started):
+                app.run_worker(lambda event=event: occupied(event), str(index))
+            for event in started:
+                self.assertTrue(event.wait(1))
+            app.run_worker(lambda: None, 'queued-ui', on_finished=cleaned.set)
+            row = next(row for row in app._operations.snapshot() if row['label'] == 'queued-ui')
+            app._operations.cancel(row['id'])
+            main.TelegramAdminManager._refresh_operations_status(app)
+            self.assertTrue(cleaned.is_set(), 'queued cancellation waited for an occupied worker')
+            self.assertEqual(next(row for row in app._operations.snapshot() if row['label'] == 'queued-ui')['status'], 'cancelled')
+        finally:
+            release.set()
+
+    def test_new_phone_sessions_are_unique_even_with_the_same_clock_second(self):
+        paths = []
+        class Client:
+            async def connect(self):
+                raise RuntimeError('test cancellation')
+            async def disconnect(self):
+                pass
+        app = SimpleNamespace(_api_credentials=lambda: (1, 'test'),
+            _new_telegram_client=lambda path, *args: paths.append(path) or Client(),
+            _delete_session_files=Mock())
+        async def scenario():
+            for _ in range(2):
+                with self.assertRaisesRegex(RuntimeError, 'test cancellation'):
+                    await main.TelegramAdminManager._add_account_async(app, '+1234567890', 'test')
+        with patch.object(main.time, 'time', return_value=1234):
+            asyncio.run(scenario())
+        self.assertEqual(len(set(paths)), 2)
+
+    def test_admin_safety_marks_are_isolated_between_operations(self):
+        app = self.app()
+        marked, cleared = threading.Event(), threading.Event()
+        results, errors = {}, []
+        async def first():
+            app._admin_safety_disabled_sessions.add('blocked-in-first')
+            marked.set()
+            while not cleared.is_set():
+                await asyncio.sleep(.005)
+            return set(app._admin_safety_disabled_sessions)
+        async def second():
+            app._admin_safety_disabled_sessions.clear()
+            app._admin_safety_disabled_sessions.add('blocked-in-second')
+            cleared.set()
+            return set(app._admin_safety_disabled_sessions)
+        def run(name, coroutine):
+            try:
+                results[name] = app.run_async(coroutine, operation=app._operations.start(name))
+            except BaseException as exc:
+                errors.append(exc)
+        one = threading.Thread(target=run, args=('first', first()))
+        one.start()
+        try:
+            self.assertTrue(marked.wait(1))
+            two = threading.Thread(target=run, args=('second', second()))
+            two.start()
+            two.join(1)
+            one.join(1)
+            self.assertFalse(errors)
+            self.assertEqual(results, {'first': {'blocked-in-first'}, 'second': {'blocked-in-second'}})
+        finally:
+            cleared.set()
+            one.join(1)
+
+
+if __name__ == '__main__':
+    unittest.main()
