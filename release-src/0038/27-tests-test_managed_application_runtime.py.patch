--- /dev/null
+++ b/app/tests/test_managed_application_runtime.py
@@ -0,0 +1,236 @@
+import asyncio
+import threading
+import unittest
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+import telegram_admin_manager as main
+from tam_core.operations import OperationRegistry
+
+
+class ManagedApplicationTests(unittest.TestCase):
+    def app(self):
+        app = main.TelegramAdminManager.__new__(main.TelegramAdminManager)
+        app._runtime_enabled = True
+        app._runtime_lock = threading.Lock()
+        app._async_runtime = None
+        app._closed = False
+        app.store = SimpleNamespace(data={})
+        app._operations = OperationRegistry()
+        app._worker_pool = None
+        app._admin_auto_pending = {}
+        app._refresh_operations_status = Mock()
+        app.ui_call = lambda f: f()
+        app.log = Mock()
+        app._write_log = Mock()
+        def cleanup():
+            app._closed = True
+            app._operations.cancel_all()
+            runtime = app.__dict__.get('_async_runtime')
+            if runtime is not None:
+                runtime.shutdown()
+            if app._worker_pool is not None:
+                app._worker_pool.shutdown(wait=True, cancel_futures=True)
+        self.addCleanup(cleanup)
+        return app
+
+    def test_read_during_upload_shares_connection_despite_different_flood_options(self):
+        app = self.app()
+        made, closed = [], []
+        class Client:
+            def __init__(self, *args, **kwargs):
+                made.append(kwargs)
+            async def connect(self):
+                pass
+            async def disconnect(self):
+                closed.append(True)
+            async def get_me(self):
+                return 'account'
+            async def upload_file(self, started, finish):
+                started.set()
+                await finish.wait()
+                return 'uploaded'
+        async def scenario():
+            upload = app._new_telegram_client('sessions/a', 1, 'test', flood_sleep_threshold=60)
+            await upload.connect()
+            started, finish = asyncio.Event(), asyncio.Event()
+            sending = asyncio.create_task(upload.upload_file(started, finish))
+            await started.wait()
+            read = app._new_telegram_client('sessions/a', 1, 'test', flood_sleep_threshold=0)
+            await asyncio.wait_for(read.connect(), .5)
+            self.assertEqual(await read.get_me(), 'account')
+            self.assertFalse(sending.done())
+            await read.disconnect()
+            finish.set()
+            self.assertEqual(await sending, 'uploaded')
+            await upload.disconnect()
+        with patch.object(main, 'TelegramClient', Client):
+            app.run_async(scenario())
+        self.assertEqual(len(made), 1)
+        self.assertEqual(made[0]['flood_sleep_threshold'], 60)
+
+    def test_cancel_one_managed_operation_keeps_another_running(self):
+        app = self.app()
+        first_started, second_started = threading.Event(), threading.Event()
+        first_finished, second_finished = threading.Event(), threading.Event()
+        finish_second = threading.Event()
+        async def first():
+            first_started.set()
+            try:
+                await asyncio.Event().wait()
+            finally:
+                first_finished.set()
+        async def second():
+            second_started.set()
+            try:
+                while not finish_second.is_set():
+                    await asyncio.sleep(.01)
+            finally:
+                second_finished.set()
+        app.run_worker(lambda: app.run_async(first()), 'first')
+        app.run_worker(lambda: app.run_async(second()), 'second')
+        self.assertTrue(first_started.wait(1))
+        self.assertTrue(second_started.wait(1))
+        one = next(row for row in app._operations.snapshot() if row['label'] == 'first')
+        app._operations.cancel(one['id'])
+        self.assertTrue(first_finished.wait(1))
+        self.assertFalse(second_finished.is_set())
+        finish_second.set()
+        self.assertTrue(second_finished.wait(1))
+
+    def test_auth_staging_client_physically_closes_before_file_swap(self):
+        app = self.app()
+        closed = []
+        class Client:
+            def __init__(self, path, *args, **kwargs):
+                self.path = path
+            async def connect(self):
+                pass
+            async def disconnect(self):
+                closed.append(self.path)
+        async def authenticate():
+            client = app._new_telegram_client('sessions/auth-staging', 1, 'test')
+            await client.connect()
+            await client.disconnect()
+            self.assertEqual(closed, ['sessions/auth-staging'])
+        with patch.object(main, 'TelegramClient', Client):
+            app.run_async(authenticate(), exclusive_session='sessions/original')
+
