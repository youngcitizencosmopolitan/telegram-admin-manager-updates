+    def _get_runtime(self):
+        runtime = self.__dict__.get('_async_runtime')
+        if runtime is None:
+            from tam_core.runtime import AsyncRuntime
+            with self._runtime_lock:
+                runtime = self.__dict__.get('_async_runtime')
+                if runtime is None:
+                    if self._closed:
+                        raise RuntimeError('Приложение закрыто.')
+                    runtime = self._async_runtime = AsyncRuntime()
+        return runtime
+
+    def run_async(self, coroutine, *, exclusive_session=None, auth_workflow=False, operation=None):
+        runtime = self.__dict__.get('_async_runtime')
+        if runtime is None and self.__dict__.get('_runtime_enabled', False):
+            runtime = self._get_runtime()
+        if runtime is None:
+            return asyncio.run(coroutine)
+        operation = operation or _current_operation.get()
+        if operation is None and exclusive_session is None and not auth_workflow:
+            return runtime.run(coroutine)
+
+        async def invoke():
+            token = _exclusive_workflow.set(auth_workflow or exclusive_session is not None)
+            safety_token = _admin_safety_state.set(set())
+            try:
+                if exclusive_session is None:
+                    return await coroutine
+                if operation is not None:
+                    operation.update(status='waiting', detail='Ожидает завершения передачи аккаунта')
+                async with runtime.broker.exclusive(exclusive_session):
+                    if operation is not None:
+                        operation.update(status='running', detail='')
+                    return await coroutine
+            finally:
+                _admin_safety_state.reset(safety_token)
+                _exclusive_workflow.reset(token)
+                coroutine.close()
+
+        async def watched():
+            task = asyncio.create_task(invoke())
+            try:
+                while not task.done():
+                    if operation is not None and operation.cancel_event.is_set() and not getattr(operation, 'cooperative_cancel', False):
+                        task.cancel()
+                        break
+                    await asyncio.wait({task}, timeout=.1)
+                return await task
+            finally:
+                if not task.done():
+                    task.cancel()
+                    await asyncio.gather(task, return_exceptions=True)
+        with runtime.broker.operation(operation):
+            return runtime.run(watched())
