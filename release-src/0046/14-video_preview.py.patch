+def _invalid_container(stderr):
+    detail = stderr.casefold()
+    if any(marker in detail for marker in ('input/output error', 'i/o error', 'permission denied',
+            'resource temporarily unavailable', 'connection timed out', 'connection reset',
+            'no such file or directory', 'cannot allocate memory', 'out of memory',
+            'too many open files', 'device or resource busy')):
+        return False
+    if any(marker in detail for marker in ('moov atom not found', 'ebml header parsing failed', 'invalid ebml header')):
+        return True
+    return ('invalid data found when processing input' in detail
+            and any(marker in detail for marker in ('error opening input', 'error reading header')))
+
+
