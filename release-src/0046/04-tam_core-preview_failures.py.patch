--- /dev/null
+++ b/app/tam_core/preview_failures.py
@@ -0,0 +1,52 @@
+"""Bounded process-local evidence of unreadable, unchanged video containers."""
+from collections import OrderedDict
+import threading
+
+
+class PreviewFailureCache:
+    def __init__(self, limit=4096):
+        self.limit = max(1, limit)
+        self._records = OrderedDict()
+        self._sources = {}
+        self._lock = threading.Lock()
+
+    def contains_source(self, source):
+        with self._lock:
+            return source in self._sources
+
+    def lookup(self, source, stamp, context):
+        if context is None or stamp[-1] is None:
+            return None  # Manual attempts and uncertain change tokens always retry.
+        key = source, repr(context)
+        with self._lock:
+            record = self._records.get(key)
+            if record is None or record[0] != stamp:
+                return None
+            self._records.move_to_end(key)
+            return record[1]
+
+    def remember(self, source, stamp, context, message):
+        """Return whether matching evidence already existed (for log coalescing)."""
+        if stamp[-1] is None:
+            return False
+        key = source, repr(context)
+        with self._lock:
+            previous = self._records.get(key)
+            repeated = context is not None and previous is not None and previous[0] == stamp
+            if previous is None:
+                self._sources[source] = self._sources.get(source, 0) + 1
+            self._records[key] = stamp, message
+            self._records.move_to_end(key)
+            while len(self._records) > self.limit:
+                (expired, _), _record = self._records.popitem(last=False)
+                self._sources[expired] -= 1
+                if not self._sources[expired]:
+                    self._sources.pop(expired)
+            return repeated
+
+    def discard_source(self, source):
+        with self._lock:
+            if source in self._sources:
+                for key in [key for key in self._records if key[0] == source]:
+                    self._records.pop(key)
+                self._sources.pop(source)
