+    def _refresh_admin_account_list(self) -> None:
+        if not hasattr(self, "admin_accounts_list"):
+            return
+        accounts = self.store.accounts()
+        saved = set(self.store.data.get("admin_selected_sessions", []) or [])
+        self.admin_accounts_list.delete(0, tk.END)
+        for idx, account in enumerate(accounts):
+            self.admin_accounts_list.insert(tk.END, account.display)
+            if not saved or account.session in saved:
+                self.admin_accounts_list.select_set(idx)
+
+    def _select_all_admin_accounts(self) -> None:
+        if hasattr(self, "admin_accounts_list") and self.admin_accounts_list.size():
+            self.admin_accounts_list.select_set(0, tk.END)
+        self._save_admin_selection()
+
+    def _save_admin_selection(self) -> None:
+        if not hasattr(self, "admin_accounts_list"):
+            return
+        self.store.data["admin_selected_sessions"] = [a.session for a in self._selected_admin_accounts()]
+        self.store.save()
+
+    def _selected_admin_accounts(self) -> list[Account]:
+        accounts = self.store.accounts()
+        if not hasattr(self, "admin_accounts_list"):
+            return []
+        indices = list(self.admin_accounts_list.curselection())
+        return [accounts[i] for i in indices if 0 <= i < len(accounts)]
+
