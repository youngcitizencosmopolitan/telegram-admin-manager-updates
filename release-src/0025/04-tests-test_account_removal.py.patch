--- /dev/null
+++ b/app/tests/test_account_removal.py
@@ -0,0 +1,95 @@
+import json
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import telegram_admin_manager as main
+from tam_core.models import Account
+import test_redesign_integration as fixture
+
+
+class AccountRemovalTests(unittest.TestCase):
+    setUp = fixture.RealApplicationFixture.setUp
+    _destroy_app = fixture.RealApplicationFixture._destroy_app
+
+    def seed(self):
+        accounts = [Account(session=f's{i}', label=f'Account {i}', phone='', user_id=i) for i in range(1, 4)]
+        self.app.store.set_accounts(accounts)
+        self.app.refresh_account_list()
+        main.SESSIONS_DIR.mkdir(exist_ok=True)
+        for account in accounts:
+            (main.SESSIONS_DIR/f'{account.session}.session').write_bytes(b'synthetic session')
+        self.app._open_advanced('accounts')
+        self.app.deiconify()
+        self.app.update()
+        return accounts
+
+    def test_startup_does_not_select_all_accounts_for_removal(self):
+        self.seed()
+        self._destroy_app()
+        self.app = main.TelegramAdminManager()
+        self.app.withdraw(); self.app.attributes('-alpha', 0)
+        self.assertEqual(self.app.accounts_list.curselection(), ())
+        self.assertEqual(self.app.account_status_tree.selection(), ())
+
+    def test_status_selection_replaces_stale_select_all_and_removes_only_one(self):
+        self.seed()
+        self.app.select_all_accounts()
+        self.app.update()
+        self.app.account_status_tree.selection_set('s2')
+        self.app.account_status_tree.event_generate('<<TreeviewSelect>>')
+        self.app.update()
+        with patch.object(main.messagebox, 'askyesno', return_value=True):
+            self.app.remove_selected_accounts()
+        self.assertEqual({a.session for a in self.app.store.accounts()}, {'s1', 's3'})
+        self.assertEqual(self.app.accounts_list.curselection(), ())
+
+    def test_list_selection_updates_status_selection(self):
+        self.seed()
+        self.app.accounts_list.select_set(1)
+        self.app.accounts_list.event_generate('<<ListboxSelect>>')
+        self.app.update()
+        self.assertEqual(self.app.account_status_tree.selection(), ('s2',))
+
+    def test_removal_preserves_sessions_and_saves_recovery_metadata(self):
+        accounts = self.seed()
+        self.app.accounts_list.select_set(1)
+        self.app.accounts_list.event_generate('<<ListboxSelect>>')
+        self.app.update()
+        with patch.object(main.messagebox, 'askyesno', return_value=True) as confirm:
+            self.app.remove_selected_accounts()
+        self.assertIn('1', confirm.call_args.args[1])
+        self.assertIn('Account 2', confirm.call_args.args[1])
+        self.assertTrue((main.SESSIONS_DIR/'s2.session').exists())
+        backups = list((main.DATA_DIR/'backups'/'removed-accounts').glob('*.json'))
+        self.assertEqual(len(backups), 1)
+        saved = json.loads(backups[0].read_text(encoding='utf-8'))
+        self.assertEqual({a['session'] for a in saved['accounts']}, {a.session for a in accounts})
+        self.assertEqual(saved['removed_sessions'], ['s2'])
+
+    def test_cancel_keeps_accounts_and_sessions(self):
+        accounts = self.seed()
+        self.app.accounts_list.select_set(1)
+        with patch.object(main.messagebox, 'askyesno', return_value=False):
+            self.app.remove_selected_accounts()
+        self.assertEqual(self.app.store.accounts(), accounts)
+        self.assertTrue((main.SESSIONS_DIR/'s2.session').exists())
+
+    def test_backup_failure_aborts_removal(self):
+        accounts = self.seed()
+        self.app.accounts_list.select_set(1)
+        with patch.object(main.messagebox, 'askyesno', return_value=True), \
+             patch.object(main.messagebox, 'showerror'), \
+             patch.object(Path, 'write_text', side_effect=PermissionError('backup unavailable')):
+            self.app.remove_selected_accounts()
+        self.assertEqual(self.app.store.accounts(), accounts)
+
+    def test_selection_uses_displayed_session_identity_after_store_reordering(self):
+        accounts = self.seed()
+        self.app.accounts_list.select_set(0)
+        self.app.store.set_accounts(list(reversed(accounts)))
+        self.assertEqual([a.session for a in self.app.selected_accounts()], ['s1'])
+
+
+if __name__ == '__main__':
+    unittest.main()
