+    def _render_file_totals(self, counts, blocked):
+        if not hasattr(self, 'monitor_file_vars'):
+            return
+        for key, variable in self.monitor_file_vars.items():
+            value = counts.get(key)
+            # Durable unconfirmed rows may precede a fresh catalog snapshot.
+            if blocked > (counts.get('remaining') or 0):
+                value = None
+            variable.set('Сверка…' if value is None else f'{value:,}'.replace(',', ' '))
+        notes = ['Сверка истории…' if counts.get('checking') else 'Включая файлы, найденные в истории отправок']
+        if counts.get('limits'):
+            notes.append(f"Пропущено по лимиту: {counts['limits']}")
+        self.monitor_file_note_var.set(' · '.join(notes))
 
