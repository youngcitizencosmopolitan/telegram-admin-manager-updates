+    def invalidate_admin_policy(self, target: str, session: str | None = None) -> None:
+        """Forget assignment-policy proof while preserving known membership/controller state."""
+        with self._lock:
+            e = self.entry(target)
+            if not e:
+                return
+            assignments = e.get("admin_assignments") or {}
