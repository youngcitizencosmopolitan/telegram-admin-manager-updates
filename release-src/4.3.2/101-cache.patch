+    def admin_sessions_for_policy(self, target: str, policy_key: str) -> set[str]:
+        """Return sessions whose last successful assignment matches this exact policy.
+
+        Unlike the legacy TTL cache this state is intentionally persistent. It is a
+        local operation journal: once an assignment succeeded, repeating the same
+        desired state is unnecessary until settings change or the user forces a
+        recheck.
+        """
+        wanted = str(policy_key or "")
+        if not wanted:
+            return set()
+        e = self.entry(target)
+        assignments = e.get("admin_assignments") or {}
+        if not isinstance(assignments, dict):
+            return set()
+        return {
+            str(session)
+            for session, state in assignments.items()
+            if session and isinstance(state, dict) and str(state.get("policy_key") or "") == wanted
+        }
+
