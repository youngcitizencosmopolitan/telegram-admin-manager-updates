+ADMIN_POLICY_SCHEMA = 1
+
+
+def build_admin_policy_key(preset: str, title: str, anonymous: bool, requested_flags: dict[str, bool]) -> str:
+    payload = {
+        "schema": ADMIN_POLICY_SCHEMA,
+        "preset": str(preset),
+        "title": str(title or ""),
+        "anonymous": bool(anonymous),
+        "requested_flags": {str(k): bool(v) for k, v in sorted(requested_flags.items())},
+    }
+    raw = json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(raw.encode("utf-8")).hexdigest()
+
+
+def build_incremental_admin_plan(
+    cache: GroupStateCache,
+    targets: list[str],
+    selected: list[Account],
+    policy_key: str,
+    force_recheck: bool = False,
+) -> tuple[list[tuple[str, list[Account]]], dict[str, int]]:
+    plan: list[tuple[str, list[Account]]] = []
+    cached_groups = 0
+    cached_assignments = 0
+    work_assignments = 0
+    for target in targets:
+        cached = set() if force_recheck else cache.admin_sessions_for_policy(target, policy_key)
+        pending = [account for account in selected if account.session not in cached]
+        cached_assignments += len(selected) - len(pending)
+        if pending:
+            plan.append((target, pending))
+            work_assignments += len(pending)
+        else:
+            cached_groups += 1
+    return plan, {
+        "cached_groups": cached_groups,
+        "work_groups": len(plan),
+        "cached_assignments": cached_assignments,
+        "work_assignments": work_assignments,
+    }
+
