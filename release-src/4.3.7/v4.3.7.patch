@@ -0,0 +1,31 @@
+import inspect
+import unittest
+
+import batch_uploader as bu
+
+
+class FilePartRequeuePolicyTests(unittest.TestCase):
+    def test_file_part_missing_is_detected_by_telegram_error_name(self):
+        FilePartMissingError = type('FilePartMissingError', (Exception,), {})
+        self.assertTrue(bu._is_file_part_missing_error(FilePartMissingError('Part 596 is missing')))
+        self.assertFalse(bu._is_file_part_missing_error(RuntimeError('FILE_PART_INVALID')))
+
+    def test_file_part_missing_gets_two_tail_requeues_before_final_failure(self):
+        self.assertEqual(bu.FILE_PART_REQUEUE_LIMIT, 2)
+        self.assertEqual(bu._next_file_part_requeue_cycle(0), 1)
+        self.assertEqual(bu._next_file_part_requeue_cycle(1), 2)
+        self.assertIsNone(bu._next_file_part_requeue_cycle(2))
+
+    def test_upload_worker_defers_file_part_missing_instead_of_immediate_retry(self):
+        source = inspect.getsource(bu.BatchUploaderPane._run_one_task)
+        marker = 'if _is_file_part_missing_error(exc):'
+        self.assertIn(marker, source)
+        branch = source[source.index(marker):]
+        self.assertIn('file_part_deferred.append(item)', branch)
+        self.assertIn('в конец очереди', branch)
+        self.assertIn('file_part_requeue_cycles.get(str(path), 0)', source)
+        self.assertLess(source.index(marker), source.index('if self.app._is_retryable_upload_error(exc)'))
+
+
+if __name__ == '__main__':
+    unittest.main()
