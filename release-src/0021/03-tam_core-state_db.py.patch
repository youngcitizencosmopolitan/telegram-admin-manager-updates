+    def upload_stale_reservations(self, target_key: str, current_run: str) -> list[dict[str, Any]]:
+        prefix = target_key + '#'
+        with self.session() as conn:
+            rows = conn.execute(
+                'SELECT target_key,fingerprint,path,run_token,claim_token FROM upload_reservations '
+                'WHERE run_token<>? AND (target_key=? OR substr(target_key,1,?)=?) '
+                'AND NOT EXISTS(SELECT 1 FROM uploads u WHERE u.target_key=upload_reservations.target_key '
+                'AND u.fingerprint=upload_reservations.fingerprint) '
+                'ORDER BY path,target_key,fingerprint',
+                (current_run, target_key, len(prefix), prefix)).fetchall()
+        return [dict(row) for row in rows]
+
+    def upload_release_stale_reservations(self, rows, current_run: str) -> int:
+        removed = 0
+        with self.session() as conn:
+            for row in rows:
+                cur = conn.execute(
+                    'DELETE FROM upload_reservations WHERE target_key=? AND fingerprint=? '
+                    'AND run_token=? AND claim_token=? AND run_token<>? '
+                    'AND NOT EXISTS(SELECT 1 FROM uploads u WHERE u.target_key=upload_reservations.target_key '
+                    'AND u.fingerprint=upload_reservations.fingerprint)',
+                    (row['target_key'], row['fingerprint'], row['run_token'], row['claim_token'], current_run))
+                removed += cur.rowcount
+        return removed
+
