+class StaleRecoveryTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.folder = self.root / 'videos'
+        self.folder.mkdir()
+        self.history = UploadHistory(self.root / 'uploads.db')
+        for fp, target, path, run in (
+            ('old', 'Channel:1#forum:a', self.folder / 'old.mp4', 'past'),
+            ('active', 'Channel:1', self.folder / 'active.mp4', 'current'),
+            ('other-group', 'Channel:2', self.folder / 'other.mp4', 'past'),
+            ('sibling', 'Channel:1', self.root / 'videos-other' / 'sibling.mp4', 'past')):
+            self.history.claim_fingerprint(fp, target, path, run, 'claim-'+fp)
+
+    def test_recovery_selects_only_old_reservations_in_exact_group_and_folder(self):
+        select = getattr(self.history, 'stale_reservations', None)
+        self.assertTrue(callable(select), 'No scoped unfinished-upload recovery')
+        rows = select(self.folder, 'Channel:1', 'current')
+        self.assertEqual([row['fingerprint'] for row in rows], ['old'])
+        release = getattr(self.history, 'release_stale_reservations', None)
+        self.assertTrue(callable(release))
+        self.assertEqual(release(rows, 'current'), 1)
+        with self.history.db.session() as conn:
+            remaining = {row[0] for row in conn.execute('SELECT fingerprint FROM upload_reservations')}
+        self.assertEqual(remaining, {'active', 'other-group', 'sibling'})
+
+    def test_recovery_never_deletes_a_replaced_claim_or_successful_history(self):
+        select = getattr(self.history, 'stale_reservations', None)
+        self.assertTrue(callable(select), 'No scoped unfinished-upload recovery')
+        rows = select(self.folder, 'Channel:1', 'current')
+        with self.history.db.session() as conn:
+            conn.execute("UPDATE upload_reservations SET claim_token='new-owner' WHERE fingerprint='old'")
+        self.assertEqual(self.history.release_stale_reservations(rows, 'current'), 0)
+        self.assertEqual(self.history.db.upload_claim_fingerprint(target_key='Channel:1#forum:a',
+            fingerprint='old', path='ignored', run_token='current', claim_token='attempt'), 'stale')
+
+    def test_completed_history_wins_during_recovery_confirmation(self):
+        rows = self.history.stale_reservations(self.folder, 'Channel:1', 'current')
+        self.history.db.upload_record(target_key='Channel:1#forum:a', fingerprint='old',
+            path=str(self.folder / 'old.mp4'), size=1, mtime_ns=1,
+            account_user_id=1, account_label='test', message_id=1)
+        self.assertEqual(self.history.release_stale_reservations(rows, 'current'), 0)
+        self.assertTrue(self.history.fingerprint_completed('old', 'Channel:1#forum:a'))
+
+    def test_already_completed_claim_is_not_offered_for_recovery(self):
+        self.history.db.upload_record(target_key='Channel:1#forum:a', fingerprint='old',
+            path=str(self.folder / 'old.mp4'), size=1, mtime_ns=1,
+            account_user_id=1, account_label='test', message_id=1)
+        self.assertEqual(self.history.stale_reservations(self.folder, 'Channel:1', 'current'), [])
+
+    def test_ui_requires_explicit_confirmation_before_releasing_old_claims(self):
+        pane = BatchUploaderPane.__new__(BatchUploaderPane)
+        rule = {'id': 'r1', 'name': 'rule', 'folder': str(self.folder), 'target': '@group'}
+        pane.app = SimpleNamespace(monitor_rules=Store(rule), upload_history=self.history, ui_call=lambda fn: fn())
+        pane.dedup_run_token = 'current'
+        rows = self.history.stale_reservations(self.folder, 'Channel:1', 'current')
+        completed = []
+        pane._finish_unfinished_recovery = lambda rule, count: completed.append(count)
+        class InlineThread:
+            def __init__(self, target, **kwargs): self.target = target
+            def start(self): self.target()
+        with patch('batch_uploader.messagebox.askyesno', return_value=False), patch('batch_uploader.threading.Thread', InlineThread):
+            pane._confirm_unfinished_recovery(rule, rows)
+        self.assertEqual(completed, [])
+        self.assertEqual(len(self.history.stale_reservations(self.folder, 'Channel:1', 'current')), 1)
+        with patch('batch_uploader.messagebox.askyesno', return_value=True), patch('batch_uploader.threading.Thread', InlineThread):
+            pane._confirm_unfinished_recovery(rule, rows)
+        self.assertEqual(completed, [1])
+
+
+if __name__ == '__main__': unittest.main()
