+class MonitorSubmissionTests(unittest.TestCase):
+    def test_same_running_rule_is_not_resubmitted_every_fast_tick(self):
+        pane = BatchUploaderPane.__new__(BatchUploaderPane)
+        rule = {'id': 'r1', 'name': 'rule', 'monitor_folder': True, 'monitor_seen_initialized': True}
+        pane.app = SimpleNamespace(monitor_rules=Store(rule), log=lambda text: None, ui_call=lambda fn: fn())
+        pane.monitor_rules = lambda: [dict(rule)]
+        pane.monitor_runtime, pane.monitor_last_signatures, pane.monitor_pending_signatures = {}, {}, {}
+        pane.monitor_stop_event = threading.Event()
+        pane._queued_task_ids = lambda: {'r1'}
+        pane.refresh_monitor_tab = lambda: None
+        submissions = []
+        enqueue = pane._enqueue_batch
+        def submit(*a, **k): submissions.append(1); return enqueue(*a, **k)
+        pane._enqueue_batch = submit
+        def scan(task):
+            pane._folder_indexes['r1'] = SimpleNamespace(needs_poll=True, busy=True, has_work=True, close=lambda: None)
+            return 'same-snapshot', {'old.mp4'}
+        pane._scan_monitor_snapshot = scan
+        ticks = []
+        async def tick(seconds):
+            ticks.append(1)
+            if len(ticks) == 3: pane.monitor_stop_event.set()
+        with patch('batch_uploader.asyncio.sleep', tick):
+            asyncio.run(pane._monitor_loop())
+        self.assertEqual(len(submissions), 1, 'Deduplicated running rule is submitted in a tight loop')
+
+    def test_stale_reservation_is_blocked_instead_of_completed_duplicate(self):
+        self.assertEqual(_dedup_claim_disposition('stale'), 'blocked')
+
+    def test_confirmed_recovery_queues_a_durable_followup_for_occupied_rule(self):
+        pane = BatchUploaderPane.__new__(BatchUploaderPane)
+        rule = {'id': 'r1', 'name': 'rule', 'folder': 'videos', 'target': '@group'}
+        pane.app = SimpleNamespace(monitor_rules=Store(rule), log=lambda text: None)
+        pane.monitor_last_signatures = {'r1': 'old'}
+        pane.monitor_pending_signatures = {'r1': 'pending'}
+        pane.monitor_blocked_signatures = {'r1': ('old', 0)}
+        pane._queued_task_ids = lambda: {'r1'}
+        pane._monitor_task_for_queue = lambda task: dict(task)
+        queued = []
+        pane._enqueue_batch = lambda tasks, **kwargs: queued.append((tasks, kwargs))
+        with patch('batch_uploader.messagebox.showinfo'):
+            pane._finish_unfinished_recovery(rule, 2)
+        self.assertEqual(len(queued), 1)
+        self.assertFalse(queued[0][1]['dedupe'])
+        self.assertEqual(pane.monitor_recovery_versions['r1'], 1)
+        self.assertNotIn('r1', pane.monitor_pending_signatures)
+        self.assertNotIn('r1', pane.monitor_blocked_signatures)
+
+    def test_monitor_table_exposes_blocked_rule_instead_of_100_percent_running(self):
+        pane = BatchUploaderPane.__new__(BatchUploaderPane)
+        rule = {'id': 'r1', 'name': 'rule', 'monitor_folder': True}
+        pane.app = SimpleNamespace(store=SimpleNamespace(accounts=lambda: []),
+            group_state_cache=SimpleNamespace(entry=lambda target: {}, all_entries=lambda: []))
+        pane.monitor_rules = lambda: [rule]
+        pane.monitor_runtime = {}
+        pane.unified_monitor = pane.monitor_active = pane.running = True
+        pane.monitor_tree = Tree()
+        pane._monitor_selected_tid = lambda: None
+        pane._queued_task_ids = lambda: set()
+        pane._live_task_lock = threading.Lock()
+        pane.live_tasks = {'r1': rule}
+        pane.task_states = {'r1': {'total_bytes': 10001, 'processed_bytes': 10000,
+            'processed_files': 10, 'blocked': 1, 'active': {}}}
+        pane.monitor_summary_var = pane.monitor_state_var = SimpleNamespace(set=lambda value: None)
+        pane.refresh_monitor_tab(force=True)
+        values = pane.monitor_tree.rows['r1']
+        self.assertIn('повтор', str(values[6]).lower())
+        self.assertNotEqual(values[7], '100%')
+
