+    def retry_unfinished_uploads(self) -> None:
+        tid = self._monitor_selected_tid()
+        rule = self.app.monitor_rules.get(tid) if tid else None
+        if not rule or getattr(self, '_reservation_recovery_active', False):
+            return
+        entry = self.app.group_state_cache.entry(str(rule.get('target', '')))
+        peer = entry.get('peer_id')
+        if not isinstance(peer, int) or peer >= 0:
+            messagebox.showinfo('Незавершённые отправки', 'Не удалось определить группу из кеша. Обнови данные группы и повтори.', parent=self.app)
+            return
+        target_key = ('Channel:' + str(abs(peer) - 1000000000000) if peer < -1000000000000
+                      else 'Chat:' + str(abs(peer)))
+        self._reservation_recovery_active = True
+        def read():
+            try:
+                rows = self.app.upload_history.stale_reservations(Path(rule['folder']), target_key, self.dedup_run_token)
+                self.app.ui_call(lambda: self._confirm_unfinished_recovery(rule, rows))
+            except Exception as exc:
+                self.app.ui_call(lambda e=str(exc): self._unfinished_recovery_error(e))
+        threading.Thread(target=read, daemon=True).start()
+
+    def _unfinished_recovery_error(self, error: str) -> None:
+        self._reservation_recovery_active = False
+        messagebox.showerror('Незавершённые отправки', error, parent=self.app)
+
+    def _confirm_unfinished_recovery(self, rule, rows) -> None:
+        current = self.app.monitor_rules.get(str(rule.get('id', '')))
+        if not current or monitor_identity(current) != monitor_identity(rule):
+            self._reservation_recovery_active = False
+            messagebox.showinfo('Незавершённые отправки', 'Правило изменилось. Выбери его и повтори проверку.', parent=self.app)
+            return
+        if not rows:
+            self._reservation_recovery_active = False
+            messagebox.showinfo('Незавершённые отправки', 'Для выбранной группы и папки резервов прошлых запусков нет.', parent=self.app)
+            return
+        approved = messagebox.askyesno('Повторить незавершённые отправки?',
+            f"Правило: {rule.get('name', '')}\nРезервов прошлых запусков: {len(rows)}.\n\n"
+            'Для этих файлов успешная отправка не подтверждена. Если Telegram принял файл перед сбоем, повтор может создать дубль.\n\n'
+            'Разрешить повтор? История подтверждённых загрузок и текущие отправки сохранятся.', parent=self.app)
+        if not approved:
+            self._reservation_recovery_active = False
+            return
+        def release():
+            try:
+                count = self.app.upload_history.release_stale_reservations(rows, self.dedup_run_token)
+                self.app.ui_call(lambda: self._finish_unfinished_recovery(rule, count))
+            except Exception as exc:
+                self.app.ui_call(lambda e=str(exc): self._unfinished_recovery_error(e))
+        threading.Thread(target=release, daemon=True).start()
+
+    def _finish_unfinished_recovery(self, rule, count: int) -> None:
+        self._reservation_recovery_active = False
+        tid = str(rule.get('id', ''))
+        current = self.app.monitor_rules.get(tid)
+        if count and current and monitor_identity(current) == monitor_identity(rule):
+            if not hasattr(self, 'monitor_recovery_versions'):
+                self.monitor_recovery_versions = {}
+            self.monitor_recovery_versions[tid] = self.monitor_recovery_versions.get(tid, 0) + 1
+            getattr(self, 'monitor_blocked_signatures', {}).pop(tid, None)
+            self.monitor_last_signatures.pop(tid, None)
+            self.monitor_pending_signatures.pop(tid, None)
+            occupied = tid in self._queued_task_ids()
+            self._enqueue_batch([self._monitor_task_for_queue(current)], source='Мониторинг: повтор незавершённых', notify=False, dedupe=False)
+            detail = 'Повтор добавлен следом за текущим пакетом; текущая отправка продолжается.' if occupied else 'Правило добавлено в очередь повторной проверки.'
+            self.app.log(f"{current.get('name', 'Правило')}: снято старых резервов {count}. {detail}")
+        messagebox.showinfo('Незавершённые отправки', f'Снято старых резервов: {count}.\nИстория подтверждённых загрузок сохранена.', parent=self.app)
 
