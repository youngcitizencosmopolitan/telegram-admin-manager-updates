+class WorkerGapTests(unittest.IsolatedAsyncioTestCase):
+    asyncSetUp = fixture.PrefetchUploadTests.asyncSetUp
+    asyncTearDown = fixture.PrefetchUploadTests.asyncTearDown
+    read = fixture.PrefetchUploadTests.read
+    file = fixture.PrefetchUploadTests.file
+
+    async def test_real_worker_overlaps_long_upload_with_gap_without_exceeding_global_limit(self):
+        first, second = self.file('a.mp4',b'a'), self.file('b.mp4',b'b')
+        now, uploads, publications, waits = [0.0], [], [], []
+        self.rule['delay'] = 2
+        self.rule['video_preview_mode'] = 'off'
+        owner = self
+        sem = asyncio.Semaphore(1)
+        class Client:
+            async def upload_file(self, path, **kwargs):
+                owner.assertTrue(sem.locked(), 'Byte uploads must still own a global upload slot')
+                uploads.append((Path(path),now[0]))
+                now[0] += 3
+                return SimpleNamespace(name=Path(path).name, path=path)
+            async def send_file(self, entity, file, **kwargs):
+                if isinstance(file,str):  # model the existing one-step path
+                    file=await self.upload_file(file)
+                owner.assertTrue(sem.locked(), 'Final sends must still obey the global limit')
+                publications.append((Path(file.path),now[0]))
+                return SimpleNamespace(id=len(publications))
+        async def sleep(delay): waits.append(delay); now[0] += delay; return True
+        self.pane._sleep_stop = sleep
+        with patch.object(bu,'time',SimpleNamespace(monotonic=lambda:now[0],time=time.time)):
+            await self.pane._run_one_task(dict(self.rule),{'s1':(self.account,Client())},{'s1':False},
+                {'s1':self.account_lock},sem,asyncio.Semaphore(2),asyncio.Semaphore(2),preparation=self.pool)
+        self.assertEqual(uploads, [(first,0),(second,3)], 'The second upload must begin at the first publication, not two seconds later')
+        self.assertEqual(publications, [(first,3),(second,6)])
+        self.assertEqual(waits, [])
+        self.assertEqual(self.pane.task_states['r1']['success'],2)
+        self.assertEqual(self.errors,[])
+
+    async def test_stop_while_waiting_for_actual_upload_slot_sends_no_bytes(self):
+        self.file()
+        waiting, release = asyncio.Event(), asyncio.Event()
+        uploads=[]
+        class Slot(asyncio.Semaphore):
+            arrivals=0
+            async def __aenter__(self):
+                self.arrivals+=1
+                if self.arrivals==2:
+                    waiting.set()
+                    await release.wait()
+                return await super().__aenter__()
+        class Client:
+            async def upload_file(self,path,**kwargs): uploads.append(path);return path
+            async def send_file(self,*args,**kwargs): return SimpleNamespace(id=1)
+        running=asyncio.create_task(self.pane._run_one_task(dict(self.rule),{'s1':(self.account,Client())},{'s1':False},
+            {'s1':self.account_lock},Slot(1),asyncio.Semaphore(2),asyncio.Semaphore(2),preparation=self.pool))
+        try:
+            await asyncio.wait_for(waiting.wait(),2)
+            self.stop.set()
+            release.set()
+            await asyncio.wait_for(running,2)
+        finally:
+            release.set()
+            if not running.done():
+                running.cancel()
+                await asyncio.gather(running,return_exceptions=True)
+        self.assertEqual(uploads,[])
+        with self.history.db.session() as db:
+            self.assertEqual(db.execute('SELECT COUNT(*) FROM uploads').fetchone()[0],0)
+
+    async def test_short_file_pacing_releases_global_slot_and_records_only_confirmed_sends(self):
+        self.file('a.mp4',b'a')
+        self.file('b.mp4',b'b')
+        now, publications, waits = [0.0], [], []
+        self.rule['delay']=2
+        sem=asyncio.Semaphore(1)
+        owner=self
+        class Client:
+            async def upload_file(self,path,**kwargs):
+                now[0]+=.25
+                return SimpleNamespace(path=path,name=Path(path).name)
+            async def send_file(self,entity,file,**kwargs):
+                publications.append(now[0]);return SimpleNamespace(id=len(publications))
+        async def sleep(delay):
+            owner.assertFalse(sem.locked(),'Publication pacing must release the upload slot for other accounts')
+            with owner.history.db.session() as db:
+                owner.assertEqual(db.execute('SELECT COUNT(*) FROM uploads').fetchone()[0],1)
+            waits.append(delay);now[0]+=delay;return True
+        self.pane._sleep_stop=sleep
+        with patch.object(bu,'time',SimpleNamespace(monotonic=lambda:now[0],time=time.time)):
+            await self.pane._run_one_task(dict(self.rule),{'s1':(self.account,Client())},{'s1':False},
+                {'s1':self.account_lock},sem,asyncio.Semaphore(2),asyncio.Semaphore(2),preparation=self.pool)
+        self.assertEqual(publications,[.25,2.25])
+        self.assertEqual(waits,[1.75])
+        self.assertEqual(self.errors,[])
