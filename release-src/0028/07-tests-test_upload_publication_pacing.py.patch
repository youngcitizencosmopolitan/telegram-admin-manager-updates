+class PublicationPacingTests(unittest.IsolatedAsyncioTestCase):
+    async def test_short_files_keep_publication_gap_but_next_bytes_start_immediately(self):
+        pace = getattr(bu, '_publish_with_min_gap', None)
+        self.assertTrue(callable(pace), 'Waiting belongs at publication, not before the next byte upload')
+        now, events, state = [0.0], [], {}
+        async def gate(): return True
+        async def sleep(delay):
+            events.append(('wait', delay))
+            now[0] += delay
+            return True
+        async def publish(): events.append(('publish', now[0])); return 'message'
+        async def one_file():
+            events.append(('upload_start', now[0]))
+            now[0] += .25
+            return await pace(state, 's', 2, publish, gate, sleep, clock=lambda:now[0])
+        await one_file()
+        await one_file()
+        self.assertEqual(events, [('upload_start',0), ('publish',.25), ('upload_start',.25), ('wait',1.75), ('publish',2.25)])
+
+    async def test_stop_after_upload_prevents_publication(self):
+        pace = getattr(bu, '_publish_with_min_gap', None)
+        self.assertTrue(callable(pace))
+        async def gate(): return False
+        async def sleep(delay): return True
+        async def publish(): self.fail('A stopped upload must not publish its handle')
+        with self.assertRaises(bu.BatchUploadStopped):
+            await pace({}, 's', 2, publish, gate, sleep)
+
+    async def test_failed_publication_still_throttles_the_next_attempt_across_rules(self):
+        pace = getattr(bu, '_publish_with_min_gap', None)
+        self.assertTrue(callable(pace))
+        now, state, waits = [0.0], {}, []
+        async def gate(): return True
+        async def sleep(delay): waits.append(delay); now[0] += delay; return True
+        async def fail(): raise TimeoutError('unknown send result')
+        async def good(): return 'message'
+        with self.assertRaises(TimeoutError):
+            await pace(state, 's', 2, fail, gate, sleep, clock=lambda:now[0])
+        await pace(state, 'other-account', 2, good, gate, sleep, clock=lambda:now[0])
+        self.assertEqual(waits, [])
+        await pace(state, 's', .5, good, gate, sleep, clock=lambda:now[0])
+        self.assertEqual(waits, [2])
+
