+class VideoHandleTests(unittest.IsolatedAsyncioTestCase):
+    async def test_metadata_prepared_off_loop_and_preserved_when_sending_uploaded_handle(self):
+        owner_thread=threading.get_ident()
+        handle=object()
+        sent=[]
+        class VideoAttribute:
+            duration=12; w=1080; h=1920; supports_streaming=False
+        attribute=VideoAttribute()
+        def attrs(path, **kwargs):
+            self.assertNotEqual(threading.get_ident(),owner_thread)
+            return [attribute], 'video/mp4'
+        class Client:
+            async def upload_file(self,path,**kwargs): return handle
+            async def send_file(self,entity,file,**kwargs):
+                sent.append((file,kwargs));return 'message'
+        with patch.object(bu,'telethon_utils',SimpleNamespace(get_attributes=attrs),create=True):
+            await bu._send_file_with_safe_parts(Client(),'group',Path('video.mp4'),1024,
+                {'supports_streaming':True,'caption':'caption','reply_to':7})
+        self.assertIs(sent[0][0],handle)
+        self.assertEqual(sent[0][1].get('mime_type'),'video/mp4')
+        self.assertEqual(sent[0][1]['attributes'][0].duration,12)
+        self.assertTrue(sent[0][1]['attributes'][0].supports_streaming)
+        self.assertFalse(attribute.supports_streaming,'Preparing one file must not mutate shared metadata')
+        self.assertEqual(sent[0][1]['reply_to'],7)
