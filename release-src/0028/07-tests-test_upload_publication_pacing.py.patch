+        with patch.object(bu,'time',SimpleNamespace(monotonic=lambda:now[0],time=time.time)):
+            await asyncio.wait_for(self.pane._run_one_task(dict(self.rule),{'s1':(self.account,Client())},{'s1':False},
+                {'s1':self.account_lock},asyncio.Semaphore(1),asyncio.Semaphore(2),asyncio.Semaphore(2),preparation=self.pool),2)
+        self.assertEqual(sent,['a.jpg'],self.errors)
