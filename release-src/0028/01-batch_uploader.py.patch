+async def _publish_with_min_gap(state, session, delay, publish, gate, sleep, *, clock=None):
+    """Pace publications per account; byte uploads may overlap the interval.
+
+    Caller holds its account lock. State is shared across rules and waves,
+    and uncertain publication failures retain the interval as well.
+    """
+    clock = clock or time.monotonic
+    delay = max(0.0, float(delay))
+    while await gate():
+        previous = state.get(session)
+        remaining = max(delay, previous[1]) - (clock() - previous[0]) if previous else 0
+        if remaining > 0:
+            if not await sleep(remaining):
+                raise BatchUploadStopped()
+            continue
+        try:
+            return await publish()
+        finally:
+            state[session] = (clock(), delay)
+    raise BatchUploadStopped()
 
