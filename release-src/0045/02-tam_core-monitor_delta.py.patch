+def _delta_paths(root, names):
+    if not isinstance(names, list) or len(names) > 10000:
+        return None
+    selected = set()
+    for name in names:
+        if not isinstance(name, str) or not name or '\x00' in name:
+            return None
+        relative = Path(name)
+        if (not relative.parts or relative.is_absolute() or relative.drive
+                or '..' in relative.parts or any(':' in part for part in relative.parts)):
+            return None
+        path = Path(os.path.abspath(root / relative))
+        if not path.is_relative_to(root):
+            return None
+        selected.add(path)
+    return selected
+
+
+def _require_root(root):
+    # Path.is_dir/exists suppress some OS errors; explicit stat preserves retries
+    # when a share is unavailable instead of acknowledging an empty selection.
+    if not stat.S_ISDIR(root.stat().st_mode):
+        raise NotADirectoryError(str(root))
+
+
+def _restored_sizes(task, root, selected):
+    _require_root(root)
+    resolved_root = root.resolve(strict=True)
+    sizes = {}
+    allowed = set(VIDEO_EXTENSIONS if task.get('send_videos', True) else ())
+    if task.get('send_photos', False):
+        allowed.update(PHOTO_EXTENSIONS)
+    for path in selected:
+        relative = path.relative_to(root)
+        if (path.suffix.lower() not in allowed
+                or (not task.get('recursive', True) and len(relative.parts) != 1)):
+            continue
+        try:
+            # Contain symlinks/junctions as well as lexical relative paths.
+            if not path.resolve(strict=True).is_relative_to(resolved_root):
+                continue
+            metadata = path.stat()
+        except FileNotFoundError:
+            _require_root(root)
+            continue
+        if stat.S_ISREG(metadata.st_mode):
+            sizes[path] = metadata.st_size
+    _require_root(root)
+    return sizes
+
