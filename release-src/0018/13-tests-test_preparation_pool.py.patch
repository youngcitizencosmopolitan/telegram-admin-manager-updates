--- /dev/null
+++ b/app/tests/test_preparation_pool.py
@@ -0,0 +1,171 @@
+import asyncio
+import tempfile
+import threading
+import time
+import unittest
+from pathlib import Path
+
+try:
+    from tam_core.preparation import PreparationPool
+except ImportError:
+    PreparationPool = None
+from video_preview import PreviewError
+
+
+class PreparationTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.assertIsNotNone(PreparationPool, 'Bounded file prefetch is missing')
+        self.tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self.tmp.name)
+        self.stop = threading.Event()
+        self.pool = PreparationPool(self.stop, concurrency=2, limit=4, quiet=0)
+
+    async def asyncTearDown(self):
+        if hasattr(self, 'pool'):
+            await self.pool.close()
+            self.tmp.cleanup()
+
+    def file(self, name='a.mp4'):
+        path = self.root / name
+        path.write_bytes(b'video')
+        return path
+
+    async def test_prepares_ahead_and_consumes_one_result_without_repeating_work(self):
+        path = self.file()
+        reads = []
+        done = threading.Event()
+
+        def read(path):
+            reads.append(path)
+            done.set()
+            return 'fingerprint'
+
+        factory = lambda: self.pool.prepare_file(path, read)
+        self.assertTrue(self.pool.offer('a', factory))
+        await asyncio.wait_for(asyncio.to_thread(done.wait), 1)
+        prepared = await self.pool.take('a', factory)
+        self.assertEqual(prepared.fingerprint, 'fingerprint')
+        self.assertEqual(reads, [path])
+
+    async def test_quiet_window_is_shared_by_all_pending_files_not_restarted_per_window(self):
+        self.assertTrue(callable(getattr(self.pool, 'observe_files', None)),
+                        'Pending files need one shared initial stability observation')
+        now = [0.0]
+        self.pool.readiness.clock = lambda: now[0]
+        self.pool.readiness.quiet = 3
+        files = [self.file('%d.mp4' % i) for i in range(20)]
+        await self.pool.observe_files(files)
+        now[0] = 3
+        # A file outside the small prefetch window is already old enough when
+        # reached. Fast photo uploads must not pay another 3s for each window.
+        result = await asyncio.wait_for(self.pool.prepare_file(files[-1], lambda p: 'fp'), 1)
+        self.assertEqual(result.fingerprint, 'fp')
+
+    async def test_preparation_concurrency_and_speculative_queue_are_bounded(self):
+        active = [0, 0]
+        lock = threading.Lock()
+
+        def read(path):
+            with lock:
+                active[0] += 1
+                active[1] = max(active)
+            time.sleep(0.03)
+            with lock:
+                active[0] -= 1
+            return 'fp'
+
+        factories = {}
+        for i in range(6):
+            path = self.file('%d.mp4' % i)
+            factories[i] = lambda p=path: self.pool.prepare_file(p, read)
+            self.assertEqual(self.pool.offer(i, factories[i]), i < 4)
+        await asyncio.gather(*(self.pool.take(i, factories[i]) for i in range(4)))
+        self.assertEqual(active[1], 2)
+
+    async def test_known_duplicate_does_not_generate_thumbnail_or_reserve_upload(self):
+        path = self.file()
+
+        def thumbnail(*args):
+            self.fail('Known duplicate thumbnail was regenerated')
+
+        prepared = await self.pool.prepare_file(path, lambda p: 'fp', thumbnail,
+                                                 duplicate=lambda fp: True)
+        self.assertIsNone(prepared.thumbnail)
+
+    async def test_preview_failure_remains_visible_for_required_policy(self):
+        def fail(*args):
+            raise PreviewError('no frame')
+
+        prepared = await self.pool.prepare_file(self.file(), lambda p: 'fp', fail)
+        self.assertIsInstance(prepared.preview_error, PreviewError)
+
+    async def test_changed_prefetched_file_is_prepared_again_before_consumption(self):
+        path = self.file()
+        reads = []
+        ready = asyncio.Event()
+
+        async def factory():
+            result = await self.pool.prepare_file(path, lambda p: reads.append(p.read_bytes()) or p.read_bytes().hex())
+            ready.set()
+            return result
+
+        self.pool.offer('a', factory)
+        await asyncio.wait_for(ready.wait(), 1)
+        path.write_bytes(b'changed')
+        prepared = await self.pool.take('a', factory)
+        self.assertEqual(prepared.fingerprint, b'changed'.hex())
+        self.assertEqual(reads, [b'video', b'changed'])
+
+    async def test_stop_cancels_waiting_for_stability_and_close_drains_tasks(self):
+        path = self.file()
+        self.pool.readiness.quiet = 60
+        self.pool.offer('a', lambda: self.pool.prepare_file(path, lambda p: 'fp'))
+        await asyncio.sleep(0.02)
+        self.stop.set()
+        await asyncio.wait_for(self.pool.close(), 1)
+        self.assertTrue(self.pool.cancel.is_set())
+
+    async def test_cancelled_consumer_does_not_orphan_running_preview(self):
+        path = self.file()
+        started, finished = threading.Event(), threading.Event()
+
+        def thumbnail(path, cancel):
+            started.set()
+            cancel.wait(2)
+            time.sleep(0.05)
+            finished.set()
+            raise PreviewError('cancelled')
+
+        consumer = asyncio.create_task(self.pool.take('a', lambda: self.pool.prepare_file(
+            path, lambda p: 'fp', thumbnail)))
+        await asyncio.wait_for(asyncio.to_thread(started.wait), 1)
+        consumer.cancel()
+        await asyncio.gather(consumer, return_exceptions=True)
+        await self.pool.close()
+        self.assertTrue(finished.is_set(), 'close returned with an orphan preparation thread')
+
+    async def test_changed_source_during_hash_restarts_preparation(self):
+        path = self.file()
+        calls = []
+
+        def read(path):
+            calls.append(path.read_bytes())
+            if len(calls) == 1:
+                path.write_bytes(b'updated during hash')
+                raise OSError('File changed while checking its fingerprint')
+            return path.read_bytes().hex()
+
+        result = await self.pool.prepare_file(path, read)
+        self.assertEqual(result.fingerprint, b'updated during hash'.hex())
+        self.assertEqual(len(calls), 2)
+
+    async def test_real_read_error_is_not_retried_forever(self):
+        def fail(path):
+            raise OSError('unreadable')
+
+        with self.assertRaisesRegex(OSError, 'unreadable'):
+            await asyncio.wait_for(self.pool.prepare_file(self.file(), fail), 1)
+
+
+if __name__ == '__main__':
+    unittest.main()
