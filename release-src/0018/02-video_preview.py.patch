+def _run_preview_command(cmd, cancel=None, timeout=45):
+    kwargs = dict(stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,
+                  encoding='utf-8', errors='replace', creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
+    if cancel is None:
+        return subprocess.run(cmd, timeout=timeout, **kwargs)
+    if cancel.is_set():
+        raise PreviewError('Подготовка превью отменена')
+    child = subprocess.Popen(cmd, **kwargs)
+    deadline = time.monotonic() + timeout
+    try:
+        while True:
+            if cancel.is_set():
+                raise PreviewError('Подготовка превью отменена')
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise subprocess.TimeoutExpired(cmd, timeout)
+            try:
+                _, stderr = child.communicate(timeout=min(0.2, remaining))
+                return subprocess.CompletedProcess(cmd, child.returncode, stderr=stderr)
+            except subprocess.TimeoutExpired:
+                continue
+    finally:
+        if child.poll() is None:
+            child.kill()
+        child.communicate()
 
 
