--- /dev/null
+++ b/app/tests/test_file_readiness.py
@@ -0,0 +1,76 @@
+import asyncio
+import os
+import tempfile
+import threading
+import unittest
+from pathlib import Path
+
+try:
+    from tam_core.file_readiness import FileReadiness, PreparationStopped, read_stamp
+except ImportError:
+    FileReadiness = None
+
+
+class ReadinessTests(unittest.TestCase):
+    def test_quiet_window_resets_after_change_and_does_not_trust_old_mtime(self):
+        self.assertIsNotNone(FileReadiness, 'File readiness tracking is missing')
+        now = [0.0]
+        with tempfile.TemporaryDirectory() as td:
+            path = Path(td) / 'video.mp4'
+            path.write_bytes(b'a')
+            tracker = FileReadiness(quiet=3, clock=lambda: now[0])
+            self.assertIsNone(tracker.check(path))
+            now[0] = 2
+            self.assertIsNone(tracker.check(path))
+            path.write_bytes(b'longer')
+            self.assertIsNone(tracker.check(path))
+            now[0] = 4
+            self.assertIsNone(tracker.check(path))
+            now[0] = 5
+            self.assertEqual(tracker.check(path), read_stamp(path))
+
+    @unittest.skipUnless(os.name == 'nt', 'Windows active-writer check')
+    def test_open_writer_is_not_ready_even_if_size_and_time_stop_changing(self):
+        self.assertIsNotNone(FileReadiness)
+        now = [0.0]
+        with tempfile.TemporaryDirectory() as td:
+            path = Path(td) / 'video.mp4'
+            with path.open('wb') as stream:
+                stream.write(b'copy in progress')
+                stream.flush()
+                tracker = FileReadiness(quiet=3, clock=lambda: now[0])
+                self.assertIsNone(tracker.check(path))
+                now[0] = 10
+                self.assertIsNone(tracker.check(path))
+            # Closing a writer can update metadata, so a new quiet window starts.
+            tracker.check(path)
+            now[0] = 20
+            self.assertIsNotNone(tracker.check(path))
+
+    def test_deleted_file_does_not_become_ready_from_previous_observation(self):
+        self.assertIsNotNone(FileReadiness)
+        with tempfile.TemporaryDirectory() as td:
+            path = Path(td) / 'video.mp4'
+            path.write_bytes(b'video')
+            tracker = FileReadiness(quiet=0)
+            tracker.check(path)
+            path.unlink()
+            with self.assertRaises(OSError):
+                tracker.check(path)
+
+    def test_wait_can_be_stopped_while_copy_is_pending(self):
+        self.assertIsNotNone(FileReadiness)
+
+        async def exercise(path):
+            stop = threading.Event()
+            tracker = FileReadiness(quiet=60)
+            waiting = asyncio.create_task(tracker.wait(path, stop.is_set, interval=0.01))
+            await asyncio.sleep(0.03)
+            stop.set()
+            with self.assertRaises(PreparationStopped):
+                await asyncio.wait_for(waiting, 1)
+
+        with tempfile.TemporaryDirectory() as td:
+            path = Path(td) / 'video.mp4'
+            path.write_bytes(b'video')
+            asyncio.run(exercise(path))
