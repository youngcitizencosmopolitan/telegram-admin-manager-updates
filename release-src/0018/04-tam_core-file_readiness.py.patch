--- /dev/null
+++ b/app/tam_core/file_readiness.py
@@ -0,0 +1,66 @@
+from __future__ import annotations
+
+import asyncio
+import threading
+import time
+from pathlib import Path
+from typing import Callable
+
+from .file_metadata import change_token, has_active_writer, stat_identity
+
+FileStamp = tuple[int | None, ...]
+
+
+def read_stamp(path: Path) -> FileStamp:
+    stat = path.stat()
+    return (*stat_identity(stat), change_token(path, stat))
+
+
+class PreparationStopped(Exception):
+    pass
+
+
+class FileReadiness:
+    def __init__(self, quiet: float = 3.0, clock: Callable[[], float] = time.monotonic):
+        self.quiet = max(0.0, quiet)
+        self.clock = clock
+        self._observed: dict[Path, tuple[FileStamp, float]] = {}
+        self._lock = threading.Lock()
+
+    def observe(self, path: Path, stamp: FileStamp) -> float:
+        now = self.clock()
+        with self._lock:
+            previous = self._observed.get(path)
+            if previous is None or previous[0] != stamp:
+                self._observed[path] = (stamp, now)
+                return now
+            return previous[1]
+
+    def observe_files(self, paths, stopped):
+        for path in paths:
+            if stopped():
+                raise PreparationStopped()
+            try:
+                self.observe(path, read_stamp(path))
+            except OSError:
+                continue  # The upload boundary will report a still-missing file.
+
+    def check(self, path: Path) -> FileStamp | None:
+        stamp = read_stamp(path)
+        since = self.observe(path, stamp)
+        now = self.clock()
+        if stamp[0] <= 0 or now - since < self.quiet or has_active_writer(path):
+            return None
+        return stamp
+
+    async def wait(self, path: Path, stopped: Callable[[], bool], interval: float = 0.25) -> FileStamp:
+        while not stopped():
+            stamp = await asyncio.to_thread(self.check, path)
+            if stamp is not None:
+                return stamp
+            await asyncio.sleep(interval)
+        raise PreparationStopped()
+
+    def forget(self, path: Path) -> None:
+        with self._lock:
+            self._observed.pop(path, None)
