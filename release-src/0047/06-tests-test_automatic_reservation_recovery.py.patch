+    async def test_waiting_for_publication_capacity_is_safe_to_retry(self):
+        self.file()
+        waiting_for_slot = asyncio.Event()
+        admit_publication = asyncio.Event()
+        slot_entries = 0
+
+        @asynccontextmanager
+        async def network_slot():
+            nonlocal slot_entries
+            slot_entries += 1
+            if slot_entries == 2:
+                waiting_for_slot.set()
+                await admit_publication.wait()
+            yield
+
+        self.pane._network_slot = network_slot
+        task = asyncio.create_task(self.run_task())
+        try:
+            await asyncio.wait_for(waiting_for_slot.wait(), 3)
+            with self.history.db.session() as db:
+                self.assertEqual(db.execute('SELECT prepublication FROM upload_reservations').fetchone()[0], 1)
+        finally:
+            task.cancel()
+            await asyncio.gather(task, return_exceptions=True)
+        self.assertEqual(self.sent, [])
+        self.assertEqual(self.pane.task_states['r1']['blocked'], 0)
+
+    async def test_cancellation_during_confirmation_keeps_the_returned_message(self):
+        self.file()
+        loop = asyncio.get_running_loop()
+        writing = asyncio.Event()
+        finish_write = Event()
+        confirm = self.history.db.upload_confirm_returned_message
+
+        def slow_confirmation(**record):
+            loop.call_soon_threadsafe(writing.set)
+            if not finish_write.wait(5):
+                raise TimeoutError('Confirmation test did not release the DB write')
+            return confirm(**record)
+
+        self.history.db.upload_confirm_returned_message = slow_confirmation
+        task = asyncio.create_task(self.run_task())
+        try:
+            await asyncio.wait_for(writing.wait(), 3)
+            task.cancel()
+            await asyncio.sleep(0)
+        finally:
+            finish_write.set()
+            await asyncio.wait_for(asyncio.gather(task, return_exceptions=True), 5)
+        self.assertEqual(len(self.sent), 1)
+        with self.history.db.session() as db:
+            self.assertEqual(db.execute('SELECT count(*) FROM uploads').fetchone()[0], 1)
+            self.assertEqual(db.execute('SELECT count(*) FROM upload_reservations').fetchone()[0], 0)
