+def _connected_upload_account(account, me):
+    # Legacy profiles can lack the user ID. Keep the authenticated sender ID
+    # in the run snapshot without editing the saved account.
+    user_id = getattr(me, 'id', None)
+    if type(user_id) is int and user_id > 0 and user_id != account.user_id:
+        account = copy.copy(account)
+        account.user_id = user_id
+    return account
