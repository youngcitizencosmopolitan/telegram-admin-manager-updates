+class _PremiumWorkPriority:
+    """Pending Premium queues shared by one monitoring wave, on one event loop."""
+
+    def __init__(self, task_ids: list[str]):
+        self.preparing = set(task_ids)
+        self.queues: dict[str, tuple[asyncio.Queue[Any], Any]] = {}
+        self.regular_lane_callbacks: dict[str, Any] = {}
+
+    def register(self, task_id: str, queue: asyncio.Queue[Any], eligible: Any, release_regular: Any = None) -> None:
+        if release_regular is not None:
+            self.regular_lane_callbacks[task_id] = release_regular
+        self.queues[task_id] = (queue, eligible)
+        self.preparing.discard(task_id)
+
+    def finish(self, task_id: str) -> None:
+        # Also release the scan barrier after empty folders or preparation errors.
+        self.preparing.discard(task_id)
+        self.queues.pop(task_id, None)
+        self.regular_lane_callbacks.pop(task_id, None)
+
+    def release_regular_lanes(self) -> None:
+        # Empty middle rules must relay their ordinary gate even when their
+        # only active worker is busy sending a large file on Premium.
+        for release in self.regular_lane_callbacks.values():
+            release()
+
+    @property
+    def ready(self) -> bool:
+        return not self.preparing
+
+    def has_work(self, session: str) -> bool:
+        return any(not queue.empty() and eligible(session) for queue, eligible in self.queues.values())
+
+
+async def _next_upload_job(
+    *, task_id: str, session: str, small_queue: asyncio.Queue[Any], big_queue: asyncio.Queue[Any],
+    premium_by_session: dict[str, bool], start_after: asyncio.Event | None,
+    priority: _PremiumWorkPriority | None, stop_event: Any, disabled: Any, signal_drained: Any,
+) -> Any:
+    """Keep ordinary rule ordering while letting Premium claim later big files."""
+    while not stop_event.is_set() and not disabled():
+        if priority is not None:
+            priority.release_regular_lanes()
+        premium = bool(premium_by_session.get(session, False))
+        if premium and priority is not None:
+            # Do not let a fast first rule consume Premium on small files before
+            # slower folder/target preparation has exposed its large-file queue.
+            if not priority.ready:
+                await asyncio.sleep(0.25)
+                continue
+            try:
+                return big_queue.get_nowait()
+            except asyncio.QueueEmpty:
+                pass
+            if priority.has_work(session):
+                await asyncio.sleep(0.25)
+                continue
+
+        if start_after is not None and not start_after.is_set():
+            await asyncio.sleep(0.25)
+            continue
+        signal_drained()
+        if premium:
+            try:
+                item = big_queue.get_nowait()
+                signal_drained()
+                return item
+            except asyncio.QueueEmpty:
+                pass
+        try:
+            item = small_queue.get_nowait()
+            signal_drained()
+            return item
+        except asyncio.QueueEmpty:
+            signal_drained()
+            return None
+    return None
 
 
