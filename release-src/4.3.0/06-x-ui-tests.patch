--- /dev/null
+++ b/telegram_admin_manager_v4.3.0/tests/test_x_ui_logic.py
@@ -0,0 +1,44 @@
+from __future__ import annotations
+
+import unittest
+from datetime import datetime, timedelta
+
+from tam_x.models import XAccount, XJob
+from tam_x.ui_logic import account_load_summary, calendar_jobs, format_job_row, next_actionable_job
+
+
+def job(job_id: int, status: str, planned: datetime | None, account_id: int | None = 1) -> XJob:
+    now = datetime(2026, 8, 28, 12, 0)
+    return XJob(
+        id=job_id, video_path=f'C:/videos/v{job_id}.mp4', fingerprint=str(job_id), caption='hello', account_mode='random',
+        specific_account_id=None, assigned_account_id=account_id, planned_at=planned, status=status, notes='', created_at=now, updated_at=now,
+    )
+
+
+class UiLogicTests(unittest.TestCase):
+    def test_format_job_row(self):
+        a = {1: XAccount(1, '@one', True, 'chrome', '', '', 'Profile 1', '', 1.0)}
+        row = format_job_row(job(3, 'planned', datetime(2026, 8, 29, 14, 25)), a)
+        self.assertEqual(row['time'], '29.08.2026 14:25')
+        self.assertEqual(row['account'], '@one')
+        self.assertEqual(row['video'], 'v3.mp4')
+
+    def test_account_load_summary(self):
+        now = datetime(2026, 8, 29, 9, 0)
+        jobs = [job(1, 'planned', now.replace(hour=10)), job(2, 'scheduled', now.replace(hour=15)), job(3, 'planned', now + timedelta(days=1))]
+        self.assertEqual(account_load_summary(1, jobs, now.date(), 4), '2/4')
+
+    def test_next_actionable_job_prefers_earliest_planned(self):
+        now = datetime(2026, 8, 29, 9, 0)
+        jobs = [job(1, 'scheduled', now.replace(hour=10)), job(2, 'planned', now.replace(hour=16)), job(3, 'planned', now.replace(hour=11))]
+        self.assertEqual(next_actionable_job(jobs).id, 3)
+
+    def test_calendar_range_excludes_unplanned_and_outside(self):
+        start = datetime(2026, 8, 29, 0, 0)
+        jobs = [job(1, 'planned', start.replace(hour=10)), job(2, 'planned', start + timedelta(days=8)), job(3, 'unplanned', None)]
+        filtered = calendar_jobs(jobs, start.date(), days=7, account_id=None)
+        self.assertEqual([j.id for j in filtered], [1])
+
+
+if __name__ == '__main__':
+    unittest.main()
