--- /dev/null
+++ b/app/tests/test_monitor_layout.py
@@ -0,0 +1,56 @@
+import unittest
+import tkinter as tk
+from tkinter import ttk
+import test_redesign_integration as fixture
+
+
+class MonitorLayoutTests(unittest.TestCase):
+    setUp=fixture.RealApplicationFixture.setUp
+    _destroy_app=fixture.RealApplicationFixture._destroy_app
+
+    def layout(self,size='1700x920'):
+        self.app.geometry(size)
+        self.app.main_notebook.select(1)
+        self.app.deiconify()
+        self.app.update()
+        self.app.update_idletasks()
+        self.app._restore_tool_pane_sashes()
+        self.app.update_idletasks()
+        return self.app.batch_uploader
+
+    def visible(self,widget):
+        self.assertTrue(widget.winfo_ismapped(),str(widget))
+        self.assertGreaterEqual(widget.winfo_width(),widget.winfo_reqwidth()-1,str(widget))
+        self.assertGreaterEqual(widget.winfo_height(),widget.winfo_reqheight()-1,
+            '%s height %s requested %s'%(widget,widget.winfo_height(),widget.winfo_reqheight()))
+        current=widget
+        while current is not self.app.monitor_workspace:
+            parent=current.master
+            self.assertGreaterEqual(current.winfo_y(),-1,str(current))
+            self.assertLessEqual(current.winfo_y()+current.winfo_height(),parent.winfo_height()+1,str(current))
+            self.assertGreaterEqual(current.winfo_x(),-1,str(current))
+            self.assertLessEqual(current.winfo_x()+current.winfo_width(),parent.winfo_width()+1,str(current))
+            current=parent
+
+    def controls(self,pane):
+        self.visible(pane.monitor_btn)
+        self.visible(pane.resume_queue_btn)
+        self.visible(pane.stop_btn)
+        frames=[pane.monitor_btn.master,pane.resume_queue_btn.master]
+        frames.extend(w for w in pane.monitor_tree.master.winfo_children() if isinstance(w,ttk.Frame))
+        cache=pane.cache_ttl_var
+        for frame in frames:
+            for child in frame.winfo_children():
+                if isinstance(child,ttk.Button):self.visible(child)
+
+    def test_default_startup_preserves_full_controls(self):
+        self.controls(self.layout())
+
+    def test_minimum_window_preserves_full_controls(self):
+        self.controls(self.layout('1180x700'))
+
+    def test_scaled_125_monitor_actions_fit(self):
+        self.controls(self.layout('1700x1000'))
+
+    def test_scaled_150_monitor_actions_fit(self):
+        self.controls(self.layout('1700x1000'))
