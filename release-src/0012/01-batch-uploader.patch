 FILE_PART_REQUEUE_LIMIT = 2
 
+# Telegram limits the *number* of upload.saveBigFilePart chunks, not just the
+# advertised file size. With the largest legal/recommended 512 KiB chunk, the
+# current appConfig limits are 4000 parts for regular accounts and 8000 for
+# Premium. Keep routing inside those protocol ceilings so Telethon never asks
+# Telegram to accept an invalid file_total_parts value.
+TELEGRAM_MAX_UPLOAD_PART_SIZE = 512 * 1024
+TELEGRAM_MAX_FILEPARTS_DEFAULT = 4000
+TELEGRAM_MAX_FILEPARTS_PREMIUM = 8000
+TELEGRAM_DEFAULT_PARTS_LIMIT = TELEGRAM_MAX_UPLOAD_PART_SIZE * TELEGRAM_MAX_FILEPARTS_DEFAULT
+TELEGRAM_PREMIUM_PARTS_LIMIT = TELEGRAM_MAX_UPLOAD_PART_SIZE * TELEGRAM_MAX_FILEPARTS_PREMIUM
+
 def _is_file_part_missing_error(exc: Exception) -> bool:
     return exc.__class__.__name__ == "FilePartMissingError"
 
+def _is_file_parts_invalid_error(exc: Exception) -> bool:
+    return exc.__class__.__name__ == "FilePartsInvalidError"
+
+def _telegram_upload_lane(size: int) -> str:
+    """Return small/premium/too_large using Telegram multipart ceilings."""
+    value = max(0, int(size or 0))
+    premium_limit = min(PREMIUM_FILE_LIMIT, TELEGRAM_PREMIUM_PARTS_LIMIT)
+    regular_limit = min(FREE_FILE_LIMIT, TELEGRAM_DEFAULT_PARTS_LIMIT)
+    if value > premium_limit:
+        return "too_large"
+    if value > regular_limit:
+        return "premium"
+    return "small"
+
+def _file_parts_invalid_action(size: int, *, premium: bool, safe_retry_used: bool) -> str:
+    """Choose the safe recovery for FILE_PARTS_INVALID.
+
+    A regular account is rerouted to Premium because its server-side part limit
+    may be lower. A Premium account gets one full restart with fresh upload id
+    and fixed 512 KiB parts; repeating the same invalid request forever is not
+    useful.
+    """
+    if _telegram_upload_lane(size) == "too_large":
+        return "too_large"
+    if not premium:
+        return "premium"
+    if not safe_retry_used:
+        return "retry_safe"
+    return "fail"
+
+async def _send_file_with_safe_parts(
+    client: Any, entity: Any, path: Path, size: int, send_kwargs: dict[str, Any]
+) -> Any:
+    """Restart one upload from byte zero using fresh 512 KiB parts.
+
+    Telethon generates a fresh random upload file_id for every upload_file call.
+    We pass the returned InputFile handle to send_file so the main file is not
+    uploaded twice. Thumbnail/caption/topic options remain in send_kwargs.
+    """
+    progress_callback = send_kwargs.get("progress_callback")
+    uploaded = await client.upload_file(
+        str(path),
+        part_size_kb=512,
+        file_size=int(size),
+        progress_callback=progress_callback,
+    )
+    final_kwargs = dict(send_kwargs)
+    final_kwargs.pop("progress_callback", None)
+    return await client.send_file(entity, uploaded, **final_kwargs)
+
 def _next_file_part_requeue_cycle(completed_cycles: int) -> int | None:
     next_cycle = int(completed_cycles) + 1
     return next_cycle if next_cycle <= FILE_PART_REQUEUE_LIMIT else None
