+class UploadIndexBoundaryTests(unittest.IsolatedAsyncioTestCase):
+    async def test_repeat_pass_skips_known_duplicates_without_reads_sends_or_ui_flood(self):
+        with tempfile.TemporaryDirectory() as td:
+            root = Path(td)
+            for i in range(40):
+                (root / ('copy%03d.mp4' % i)).write_bytes(b'same video')
+            history = UploadHistory(root / 'uploads.db')
+            pane = BatchUploaderPane.__new__(BatchUploaderPane)
+            noop = lambda *args, **kwargs: None
+            ui_calls, reads, sends = [], [], []
+            owner = threading.get_ident()
+
+            async def resolve(*args):
+                return SimpleNamespace(title='group')
+
+            async def open_gate(*args):
+                return True
+
+            class Client:
+                async def send_file(self, entity, path, **kwargs):
+                    sends.append(path)
+                    return SimpleNamespace(id=len(sends))
+
+            def read(path):
+                self.assertNotEqual(threading.get_ident(), owner)
+                reads.append(path)
+                return path.read_bytes().hex()
+
+            rule = {'id': 'r1', 'name': 'index', 'folder': td, 'target': '@group',
+                    'recursive': False, 'auto_admin': False, 'video_preview_mode': 'off'}
+            pane.app = SimpleNamespace(
+                store=SimpleNamespace(data={'upload_tasks': []}, save=noop),
+                group_state_cache=SimpleNamespace(fresh_admin_sessions=lambda *args: set()),
+                upload_history=history, safety_policy=lambda: {'enabled': False},
+                account_usage_allows=lambda *args: True, _resolve_or_join_target=resolve,
+                _target_key=lambda entity: 'group', _quick_fingerprint=read,
+                ui_call=lambda fn: ui_calls.append(fn), log=noop,
+                refresh_safety_health_table=noop, record_upload_error=noop,
+                _friendly_error=str, _is_retryable_upload_error=lambda *args: False)
+            pane._effective_task_sessions = lambda *args: ['s1']
+            pane._cache_ttl_hours = lambda: 24
+            pane.account_health, pane.task_states = {}, {}
+            pane._live_task_lock = threading.RLock()
+            pane.live_tasks = {'r1': dict(rule)}
+            pane.dedup_run_token = 'test'
+            pane.stop_event = threading.Event()
+            pane._emit_dashboard = pane._emit_task_metrics = noop
+            pane._wait_gate = open_gate
+            pane.task_pause_events = {}
+            account = Account(session='s1', label='test', phone='', user_id=1)
+
+            async def run():
+                await pane._run_one_task(dict(rule), {'s1': (account, Client())}, {'s1': False},
+                    {'s1': asyncio.Lock()}, asyncio.Semaphore(1), asyncio.Semaphore(1), asyncio.Semaphore(1))
+
+            await run()
+            self.assertEqual(len(sends), 1)
+            self.assertEqual(len(reads), 40)
+            self.assertEqual(pane.task_states['r1']['failed'], 0)
+            reads.clear()
+            sends.clear()
+            ui_calls.clear()
+            # Reopen the facade, just like a program restart.
+            pane.app.upload_history = UploadHistory(root / 'uploads.db')
+            with patch.object(pane.app.upload_history.db, 'connect', wraps=pane.app.upload_history.db.connect) as connect:
+                await run()
+            self.assertEqual(reads, [])
+            self.assertEqual(sends, [])
+            self.assertEqual(pane.task_states['r1']['skipped'], 40)
+            self.assertLessEqual(connect.call_count, 3)
+            self.assertLessEqual(len(ui_calls), 5)
+
+            # A file can change after the batch query returned its snapshot.
+            # The uploader must compare it with the stat at the skip boundary.
+            first = root / 'copy000.mp4'
+            original_check = pane.app.upload_history.completed_paths
+
+            def mutate_after_check(*args, **kwargs):
+                checked = original_check(*args, **kwargs)
+                first.write_bytes(b'a new version of the video')
+                return checked
+
+            with patch.object(pane.app.upload_history, 'completed_paths', mutate_after_check):
+                await run()
+            self.assertEqual(reads, [first])
+            self.assertEqual(sends, [str(first)])
+            self.assertEqual(pane.task_states['r1']['failed'], 0)
+
+
+if __name__ == '__main__':
+    unittest.main()
