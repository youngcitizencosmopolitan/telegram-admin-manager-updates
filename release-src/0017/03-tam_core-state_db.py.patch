+    def file_fingerprints_get(self, paths: list[str]) -> dict[str, tuple[str, str]]:
+        if not paths:
+            return {}
+        result: dict[str, tuple[str, str]] = {}
+        with self.session() as conn:
+            for offset in range(0, len(paths), 400):
+                chunk = paths[offset:offset + 400]
+                marks = ','.join('?' for _ in chunk)
+                for row in conn.execute(
+                    f'SELECT path, signature_json, fingerprint FROM file_fingerprints WHERE path IN ({marks})', chunk
+                ):
+                    result[row['path']] = (row['signature_json'], row['fingerprint'])
+        return result
+
+    def file_fingerprint_put(self, path: str, signature: str, fingerprint: str) -> None:
+        with self.session() as conn:
+            conn.execute(
+                'INSERT INTO file_fingerprints(path, signature_json, fingerprint) VALUES(?,?,?) '
+                'ON CONFLICT(path) DO UPDATE SET signature_json=excluded.signature_json, fingerprint=excluded.fingerprint',
+                (path, signature, fingerprint),
+            )
+
+    def upload_completed_candidates(
+        self, candidates: list[tuple[str, str, int, int, str]], forum_target_key: str | None = None
+    ) -> set[int]:
+        """Check one scan using indexed joins and a single connection, not one per file."""
+        if not candidates:
+            return set()
+        with self.session() as conn:
+            conn.execute('CREATE TEMP TABLE candidates(target_key TEXT, path TEXT, size INTEGER, mtime_ns INTEGER, fingerprint TEXT)')
+            conn.executemany('INSERT INTO candidates VALUES(?,?,?,?,?)', candidates)
+            result = {row[0] for row in conn.execute(
+                'SELECT c.rowid-1 FROM candidates c WHERE '
+                'EXISTS (SELECT 1 FROM uploads u WHERE u.target_key=c.target_key AND u.path=c.path '
+                'AND u.size=c.size AND u.mtime_ns=c.mtime_ns) OR '
+                "(c.fingerprint<>'' AND EXISTS (SELECT 1 FROM uploads u WHERE u.target_key=c.target_key AND u.fingerprint=c.fingerprint))"
+            )}
+            if forum_target_key is not None:
+                prefix = f'{forum_target_key}#topic:'
+                legacy = {(r[0], r[1], r[2]) for r in conn.execute(
+                    'SELECT path,size,mtime_ns FROM uploads WHERE target_key>=? AND target_key<?',
+                    (prefix, prefix + '\uffff'),
+                )}
+                result.update(i for i, (_, path, size, mtime_ns, _) in enumerate(candidates) if (path, size, mtime_ns) in legacy)
+        return result
+
