+    @staticmethod
+    def _sanitize_sash_positions(raw: Any, *, expected: int) -> list[int]:
+        if not isinstance(raw, (list, tuple)) or expected <= 0:
+            return []
+        values: list[int] = []
+        for item in raw:
+            try:
+                value = int(item)
+            except Exception:
+                continue
+            if value < 0:
+                continue
+            values.append(value)
+            if len(values) >= expected:
+                break
+        return values
+
+    @staticmethod
+    def _collect_pane_sashes(pane: Any, orientation: str) -> list[int]:
+        values: list[int] = []
+        try:
+            count = max(0, len(pane.panes()) - 1)
+        except Exception:
+            return values
+        axis = 0 if str(orientation).casefold().startswith("h") else 1
+        for index in range(count):
+            try:
+                coord = pane.sash_coord(index)
+                values.append(int(coord[axis]))
+            except Exception:
+                continue
+        return values
+
+    def _save_dashboard_sashes(self, _event: Any | None = None) -> None:
+        panes = getattr(self, "_dashboard_panes", {})
+        if not panes:
+            return
+        payload: dict[str, list[int]] = {}
+        for key, (pane, orientation) in panes.items():
+            values = self._collect_pane_sashes(pane, orientation)
+            if values:
+                payload[str(key)] = values
+        if not payload:
+            return
+        try:
+            if self.store.data.get("dashboard_sashes") == payload:
+                return
+            self.store.data["dashboard_sashes"] = payload
+            self.store.save()
+        except Exception:
+            pass
+
+    def _restore_dashboard_sashes(self) -> None:
+        raw = self.store.data.get("dashboard_sashes", {})
+        if not isinstance(raw, dict):
+            return
+        for key, (pane, orientation) in getattr(self, "_dashboard_panes", {}).items():
+            try:
+                expected = max(0, len(pane.panes()) - 1)
+            except Exception:
+                continue
+            positions = self._sanitize_sash_positions(raw.get(key), expected=expected)
+            # Place from the last sash backwards. Moving an early sash can push
+            # later panes because of minsize constraints; reverse order preserves
+            # the saved geometry much more faithfully.
+            for index, value in reversed(list(enumerate(positions))):
+                try:
+                    if str(orientation).casefold().startswith("h"):
+                        pane.sash_place(index, int(value), 0)
+                    else:
+                        pane.sash_place(index, 0, int(value))
+                except Exception:
+                    pass
+            try:
+                self.update_idletasks()
+            except Exception:
+                pass
+
+    @staticmethod
+    def _latest_monitor_detection(rules: list[dict[str, Any]]) -> tuple[str, int, float]:
+        best_name = ""
+        best_count = 0
+        best_stamp = 0.0
+        for rule in rules:
+            try:
+                stamp = float(rule.get("monitor_last_detection", 0) or 0)
+                count = int(rule.get("monitor_last_new_count", 0) or 0)
+            except Exception:
+                continue
+            if count > 0 and stamp > best_stamp:
+                best_stamp = stamp
+                best_count = count
+                best_name = str(rule.get("name", "Правило") or "Правило")
+        return best_name, best_count, best_stamp
+
