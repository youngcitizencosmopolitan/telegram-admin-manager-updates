+    @staticmethod
+    def _update_monitor_seen_state(
+        rule: dict[str, Any], *, previous_files: set[str], current_files: set[str], now: float
+    ) -> tuple[dict[str, Any], int, bool]:
+        """Update compact detection metadata while the file index lives in SQLite.
+
+        The seen-file index is separate from monitor_signature and from the rule's
+        JSON payload. This keeps dashboard reads lightweight and lets monitoring
+        report arrivals even while an older upload is running.
+        """
+        updated = dict(rule)
+        previous = {str(x).replace("\\", "/").casefold() for x in previous_files if str(x)}
+        current = {str(x).replace("\\", "/").casefold() for x in current_files if str(x)}
+        has_baseline = bool(updated.get("monitor_seen_initialized", False))
+        updated["monitor_seen_initialized"] = True
+        if not has_baseline:
+            return updated, 0, True
+        new_count = len(current - previous)
+        if new_count > 0:
+            updated["monitor_last_new_count"] = int(new_count)
+            updated["monitor_last_detection"] = float(now)
+        return updated, int(new_count), False
+
