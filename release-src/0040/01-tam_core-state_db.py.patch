+def _history_group_key(target_key: str) -> str:
+    # Only the two versioned forum suffixes are aliases of a group identity.
+    for marker in ('#topic:', '#forum:'):
+        if marker in target_key:
+            return target_key.split(marker, 1)[0]
+    return target_key
+
+
+def _history_scope_params(target_key: str) -> tuple[str, ...]:
+    base = _history_group_key(target_key)
+    return (base, base + '#topic:', base + '#topic:' + '\uffff',
+            base + '#forum:', base + '#forum:' + '\uffff')
+
+
+def _history_scope_sql(column: str = 'target_key') -> str:
+    # Internal column names only; every destination value is bound separately.
+    return (f'({column}=? OR ({column}>=? AND {column}<?) '
+            f'OR ({column}>=? AND {column}<?))')
 
 
