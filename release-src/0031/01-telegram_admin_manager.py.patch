+    def _on_admin_targets_modified(self, _event=None) -> None:
+        if not self.admin_targets_text.edit_modified():
+            return
+        self.admin_targets_text.edit_modified(False)
+        targets = self._admin_targets()
+        current = set(targets)
+        self._admin_auto_pending = {target: None for target in self._admin_auto_pending if target in current}
+        for target in targets:
+            if target in self._admin_targets_known:
+                continue
+            complete = (self._extract_invite_hash(target) is not None
+                        or re.fullmatch(r"@[A-Za-z][A-Za-z0-9_]{4,}", target)
+                        or re.fullmatch(r"-?\d{5,}", target)
+                        or re.fullmatch(r"(?:https?://)?(?:www\.)?t\.me/[A-Za-z][A-Za-z0-9_]{4,}/?(?:\?[^\s]*)?", target, re.I))
+            if complete:
+                self._admin_auto_pending[target] = None
+        self._admin_targets_known = current
+        self._save_group_settings()
+        self._schedule_admin_auto_queue()
+
+    def _schedule_admin_auto_queue(self, delay: int = 900) -> None:
+        if self._admin_auto_after:
+            self.after_cancel(self._admin_auto_after)
+            self._admin_auto_after = None
+        if self._admin_auto_pending and not self._closed:
+            self._admin_auto_after = self.after(delay, self._flush_admin_auto_queue)
+
+    def _flush_admin_auto_queue(self) -> None:
+        self._admin_auto_after = None
+        if self._closed or not self._admin_auto_pending:
+            return
+        if not self._selected_admin_accounts():
+            self.admin_stats_var.set(f"Авто: выбери аккаунты · ожидают групп {len(self._admin_auto_pending)}")
+            return
+        try:
+            float(self.delay_var.get().replace(',', '.'))
+            if TelegramClient is None:
+                raise ValueError('Для назначения админов требуется Telethon.')
+            self.save_api_settings(quiet=True)
+            self._api_credentials()
+        except (ValueError, TypeError) as exc:
+            self.admin_stats_var.set(str(exc))
+            return
+        if self._busy or self._foreground_takeover_pending:
+            if (not self._foreground_takeover_pending
+                    and self._defer_if_background_monitor(
+                        lambda: self._continue_admin_handoff(self._flush_admin_auto_queue), "новые группы для админов")):
+                return
+            self.admin_stats_var.set(f"Авто: ожидают обработки групп {len(self._admin_auto_pending)}")
+            self._schedule_admin_auto_queue(500)
+            return
+        self.start_promote(targets_override=list(self._admin_auto_pending), automatic=True)
+
+    def _continue_admin_handoff(self, callback: Callable[[], Any]) -> None:
+        try:
+            callback()
+        finally:
+            # Stop, removed links or changed settings may cancel the operation
+            # after the uploader yielded. Release its resume request in that case.
+            if (not self._closed and not self._busy and not self._foreground_takeover_pending
+                    and self._resume_background_queue_after_busy):
+                self._resume_background_queue_after_busy = False
+                self.after(250, self.batch_uploader.resume_queue)
+
