+
+    def session_auth_required(self, session: str) -> bool:
+        return session in getattr(self, '_auth_required_sessions', set())
+
+    def session_connection_ready(self, session: str) -> bool:
+        return not self.session_auth_required(session) and time.monotonic() >= getattr(self, '_connection_retry_after', {}).get(session, 0)
+
+    def clear_session_auth_required(self, session: str) -> None:
+        getattr(self, '_auth_required_sessions', set()).discard(session)
+        getattr(self, '_connection_retry_after', {}).pop(session, None)
+        self.account_health.pop(session, None)
+
+    def remember_session_auth_failure(self, session: str, exc: Exception | None = None) -> bool:
+        if exc is not None and not _requires_session_login(exc):
+            return False
+        self._record_connection_failure(session, exc or _SessionLoginRequired('Требуется повторный вход по QR.'))
+        return True
+
+    def _record_connection_failure(self, session: str, exc: Exception) -> None:
+        auth_required = _requires_session_login(exc)
+        if not hasattr(self, '_auth_required_sessions'):
+            self._auth_required_sessions = set()
+            self._connection_retry_after = {}
+        health = self.account_health.setdefault(session, {})
+        if auth_required or not health.get('disabled'):
+            health.update(state='Нужен вход' if auth_required else 'Недоступен',
+                          reason='Требуется повторный вход по QR.' if auth_required else self.app._friendly_error(exc))
+        if auth_required:
+            self._auth_required_sessions.add(session)
+            health['disabled'] = True
+        else:
+            # Network outages and Telegram waits are recoverable, but polling
+            # them every 750 ms opens a new client and floods the log.
+            delay = max(30.0, float(getattr(exc, 'seconds', 0) or 0))
+            self._connection_retry_after[session] = time.monotonic() + delay
+        self._ui_latest(('health',), self.app.refresh_safety_health_table)
 
