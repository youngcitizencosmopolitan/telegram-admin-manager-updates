+    def run_preflight(self) -> None:
+        rules = self.monitor_rules()
+        selected = self._monitor_selected_tid()
+        if selected:
+            chosen = [r for r in rules if str(r.get("id", "")) == selected]
+        else:
+            chosen = [r for r in rules if bool(r.get("monitor_folder", False))]
+        if not chosen:
+            messagebox.showinfo("Telegram Admin Manager", "Нет выбранного или включённого правила для Preflight.", parent=self.app)
+            return
+        tasks = [self._monitor_task_for_queue(r) for r in chosen]
+        file_rows: list[dict[str, Any]] = []
+        scan_warnings: list[str] = []
+        for task in tasks:
+            try:
+                files, _total = self._scan_task_files(task)
+                for path in files:
+                    try:
+                        file_rows.append({"task_id": str(task.get("id", "")), "size": int(path.stat().st_size)})
+                    except OSError:
+                        scan_warnings.append(f"{task.get('name', 'Правило')}: файл недоступен: {path.name}")
+            except Exception as exc:
+                scan_warnings.append(f"{task.get('name', 'Правило')}: {exc}")
+        accounts = self.app.store.accounts()
+        usage = {a.session: self.app.account_usage(a.session) for a in accounts}
+        restricted = {a.session for a in accounts if self.app.account_is_restricted(a.session)}
+        now = time.time()
+        flood: dict[str, int] = {}
+        for a in accounts:
+            try:
+                until = float(self.app.state_db.get_meta("admin_flood_until:" + a.session, 0) or 0)
+                flood[a.session] = max(0, int(until - now + 0.999))
+            except Exception:
+                flood[a.session] = 0
+        task_rows: list[dict[str, Any]] = []
+        for task in tasks:
+            sessions = list(self._effective_task_sessions(task, {a.session: a for a in accounts}))
+            task_rows.append({**task, "sessions": sessions, "use_all_accounts": False})
+        report = build_preflight_report(
+            tasks=task_rows,
+            accounts=[{"session": a.session, "premium": bool(a.premium)} for a in accounts],
+            usage_by_session=usage, restricted_sessions=restricted, flood_seconds=flood, file_rows=file_rows,
+        )
+        report["warnings"].extend(scan_warnings)
+        # Cached target/admin readiness is advisory: no Telegram write/read bursts here.
+        for task in tasks:
+            target = str(task.get("target", "") or "")
+            if not target:
+                report["warnings"].append(f"{task.get('name', 'Правило')}: не указан канал/группа.")
+                continue
+            cached = self.app.group_state_cache.entry(target)
+            if bool(task.get("auto_admin", True)) and not (cached.get("controller_session") or cached.get("admin_sessions")):
+                report["warnings"].append(f"{task.get('name', 'Правило')}: права/контроллер не подтверждены кэшем; будут проверены при запуске.")
+        text = format_preflight_report(report)
+        self.app.log("Preflight:\n" + text.replace("\n", " | "))
+        messagebox.showinfo("Telegram Admin Manager — Preflight", text, parent=self.app)
+
