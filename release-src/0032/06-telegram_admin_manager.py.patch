+    def _start_channels_inventory_load(self) -> None:
+        from tam_core.channel_search import build_channel_inventory
+        revision = self._channels_load_revision
+        labels = {account.session: account.display for account in self.store.accounts()}
+        self._channels_load_running = True
+
+        def load():
+            try:
+                snapshot = self.state_db.channels_inventory_snapshot()
+                data = build_channel_inventory(*snapshot, labels)
+                self.ui_call(lambda: self._finish_channels_inventory_load(revision, data, None))
+            except Exception as exc:
+                self.ui_call(lambda error=str(exc): self._finish_channels_inventory_load(revision, None, error))
+
+        threading.Thread(target=load, daemon=True).start()
+
+    def _finish_channels_inventory_load(self, revision, data, error) -> None:
+        self._channels_load_running = False
+        if self._closed:
+            return
+        if revision != self._channels_load_revision:
+            self._start_channels_inventory_load()
+            return
+        if error is not None:
+            self.log(f'Не удалось обновить локальный список групп: {error}')
+            if self._channels_inventory is None:
+                self._channels_inventory = {}
+        else:
+            self._channels_inventory, self._channels_relations, self._channels_restrictions = data
+        self._apply_channels_filter()
+
+    def _schedule_channels_filter(self) -> None:
+        if self._channels_filter_after:
+            self.after_cancel(self._channels_filter_after)
+        if not self._closed:
+            self._channels_filter_after = self.after(180, self._apply_channels_filter)
+
+    def _apply_channels_filter(self) -> None:
+        if self._channels_filter_after:
+            self.after_cancel(self._channels_filter_after)
+            self._channels_filter_after = None
+        if self._closed or self._channels_inventory is None:
+            return
+        if self._channels_render_after:
+            self.after_cancel(self._channels_render_after)
+            self._channels_render_after = None
+        if self._channels_sort_paused:
+            self._channels_sort_controller.resume()
+        self._channels_sort_controller.suspend()
+        self._channels_sort_paused = True
+        self._channels_rendering = True
+        self._channels_render_revision += 1
+        revision = self._channels_render_revision
+        query = self.channels_search_var.get().strip().casefold()
+        owner_only = self.channels_owner_only_var.get()
+        admin_only = self.channels_admin_only_var.get()
+        problem_only = self.channels_problem_only_var.get()
+        inventory = self._channels_inventory
+        wanted = [key for key, row in inventory.items() if
+                  (not query or query in row['search']) and (not owner_only or row['owner'])
+                  and (not admin_only or row['admin']) and (not problem_only or row['problem'])]
+        visible = set(self.channels_tree.get_children(''))
+        wanted_set = set(wanted)
+        removed = self._channels_tree_ids - set(inventory)
+        operations = iter([('delete', key) for key in removed]
+                          + [('detach', key) for key in visible - wanted_set - removed]
+                          + [('show', key) for key in wanted])
+
+        def paint():
+            self._channels_render_after = None
+            if self._closed or revision != self._channels_render_revision:
+                return
+            for _ in range(60):
+                try:
+                    action, key = next(operations)
+                except StopIteration:
+                    keep = [key for key in self.channels_tree.selection() if key in wanted_set]
+                    self.channels_tree.selection_set(keep)
+                    self._channels_rendering = self._channels_sort_paused = False
+                    self._channels_sort_controller.resume()
+                    self._channels_show_selected_details()
+                    return
+                if action == 'delete':
+                    self.channels_tree.delete(key)
+                    self._channels_tree_ids.discard(key)
+                    self._channels_painted_values.pop(key, None)
+                elif action == 'detach':
+                    self.channels_tree.selection_remove(key)
+                    self.channels_tree.detach(key)
+                else:
+                    values = inventory[key]['values']
+                    if key not in self._channels_tree_ids:
+                        self.channels_tree.insert('', 'end', iid=key, values=values)
+                        self._channels_tree_ids.add(key)
+                    elif self._channels_painted_values.get(key) != values:
+                        self.channels_tree.item(key, values=values)
+                    self._channels_painted_values[key] = values
+                    self.channels_tree.move(key, '', 'end')
+            self._channels_render_after = self.after(1, paint)
+
+        self._channels_render_after = self.after(0, paint)
 
