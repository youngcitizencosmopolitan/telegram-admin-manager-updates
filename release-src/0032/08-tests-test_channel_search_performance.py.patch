+
+    def test_stale_load_is_discarded_and_refreshes_are_coalesced(self):
+        self.seed(20)
+        app = self.app
+        original = app.state_db.channels_inventory_snapshot
+        started, release = threading.Event(), threading.Event()
+        calls = []
+
+        def delayed():
+            result = original()
+            calls.append(True)
+            if len(calls) == 1:
+                started.set()
+                release.wait(2)
+            return result
+
+        with patch.object(app.state_db, 'channels_inventory_snapshot', side_effect=delayed), \
+             patch.object(app, '_apply_channels_filter', wraps=app._apply_channels_filter) as apply:
+            try:
+                app.refresh_channels_from_cache()
+                self.assertTrue(started.wait(2))
+                app.state_db.channel_upsert({'peer_id': 21, 'title': 'Newest'})
+                for _ in range(10):
+                    app.refresh_channels_from_cache()
+                release.set()
+                self.wait_ready()
+                self.assertEqual(len(calls), 2)
+                self.assertEqual(apply.call_count, 1, 'An obsolete snapshot was painted')
+                self.assertEqual(len(app.channels_tree.get_children('')), 21)
+            finally:
+                release.set()
+
+    def test_failed_refresh_keeps_previous_searchable_snapshot(self):
+        self.seed(20)
+        with patch.object(self.app.state_db, 'channels_inventory_snapshot', side_effect=OSError('busy database')):
+            self.app.refresh_channels_from_cache()
+            self.wait_ready()
+        self.filter_now('alpha')
+        self.assertEqual(len(self.app.channels_tree.get_children('')), 10)
+
+    def test_hidden_group_is_deselected_before_detaching_it(self):
+        self.seed(150)
+        app = self.app
+        app.channels_tree.selection_set(('1', '2'))
+        original = app.channels_tree.detach
+        selected_at_detach = []
+
+        def detach(key):
+            if key in app.channels_tree.selection():
+                selected_at_detach.append(key)
+            return original(key)
+
+        with patch.object(app.channels_tree, 'detach', side_effect=detach):
+            self.filter_now('alpha')
+        self.assertEqual(selected_at_detach, [], 'Hidden groups could still be targeted between paint batches')
+        self.assertEqual(app.channels_tree.selection(), ('1',))
+
+
+if __name__ == '__main__':
+    unittest.main()
