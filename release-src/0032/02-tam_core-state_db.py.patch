+
+    def channels_inventory_snapshot(self) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]]]:
+        """Read inventory and its relationships together, without per-row queries."""
+        with self.session() as conn:
+            conn.execute('BEGIN')
+            tables = [conn.execute(sql).fetchall() for sql in (
+                'SELECT payload_json FROM channels ORDER BY peer_id',
+                'SELECT payload_json FROM channel_accounts ORDER BY peer_id, session',
+                'SELECT payload_json FROM account_restrictions ORDER BY session',
+            )]
+        decoded = []
+        for rows in tables:
+            items = []
+            for row in rows:
+                try:
+                    value = json.loads(row[0])
+                    if isinstance(value, dict):
+                        items.append(value)
+                except (ValueError, TypeError):
+                    continue
+            decoded.append(items)
+        return tuple(decoded)
 
