+import tempfile
+import unittest
+from pathlib import Path
+
+from tam_core.state_db import StateDatabase
+
+
+class AutomaticRecoveryTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.db = StateDatabase(Path(self.tmp.name) / 'state.db')
+
+    def claim(self, run, token, safe=True):
+        return self.db.upload_claim_fingerprint(target_key='group', fingerprint='fp',
+            path='video.mp4', run_token=run, claim_token=token, prepublication=safe)
+
+    def test_prepublication_crash_is_reclaimed_automatically(self):
+        self.assertEqual(self.claim('old', 'one'), 'reserved')
+        self.assertEqual(self.claim('new', 'two'), 'reserved')
+        self.assertEqual(self.claim('new', 'three'), 'in_progress')
+
+    def test_publication_uncertainty_is_preserved(self):
+        self.claim('old', 'one')
+        self.assertTrue(self.db.upload_mark_publishing('group', 'fp', 'one'))
+        self.assertEqual(self.claim('new', 'two'), 'stale')
+
+    def test_old_owner_cannot_publish_after_reclaim(self):
+        self.claim('old', 'one')
+        self.claim('new', 'two')
+        self.assertFalse(self.db.upload_mark_publishing('group', 'fp', 'one'))
+        self.assertTrue(self.db.upload_mark_publishing('group', 'fp', 'two'))
+
+    def test_legacy_claim_is_never_blindly_repeated(self):
+        self.claim('old', 'one', safe=False)
+        self.assertEqual(self.claim('new', 'two'), 'stale')
+
+
+import asyncio
+from types import SimpleNamespace
+import test_prefetch_upload_boundary as fixture
+
+
+class WorkerRecoveryTests(unittest.IsolatedAsyncioTestCase):
+    asyncSetUp = fixture.PrefetchUploadTests.asyncSetUp
+    asyncTearDown = fixture.PrefetchUploadTests.asyncTearDown
+    read = fixture.PrefetchUploadTests.read
+    file = fixture.PrefetchUploadTests.file
+    run_task = fixture.PrefetchUploadTests.run_task
+
+    async def uncertain(self, history_failure):
+        self.file()
+        sends = []
+        class Client:
+            async def upload_file(self, path, **kwargs):
+                return SimpleNamespace(path=path, name=Path(path).name)
+            async def send_file(self, *args, **kwargs):
+                sends.append(True)
+                if not history_failure:
+                    raise TimeoutError('accepted but response lost')
+                return SimpleNamespace(id=1)
+        if history_failure:
+            def fail(*args, **kwargs): raise OSError('database write failed')
+            self.history.record_completed = fail
+        self.pane.app._is_retryable_upload_error = lambda exc: True
+        await asyncio.wait_for(self.pane._run_one_task(dict(self.rule),
+            {'s1': (self.account, Client())}, {'s1': False}, {'s1': self.account_lock},
+            asyncio.Semaphore(1), asyncio.Semaphore(2), asyncio.Semaphore(2), preparation=self.pool), 5)
+        self.assertEqual(sends, [True])
+        self.assertEqual(self.pane.task_states['r1']['blocked'], 1)
+        with self.history.db.session() as db:
+            self.assertEqual(db.execute('SELECT prepublication FROM upload_reservations').fetchone()[0], 0)
+
+    async def test_accepted_send_timeout_keeps_reservation_without_retry(self):
+        await self.uncertain(False)
+
+    async def test_history_write_failure_after_send_keeps_reservation(self):
+        await self.uncertain(True)
+
+    async def test_restarted_worker_resends_only_prepublication_claim(self):
+        path = self.file()
+        self.history.claim_prepublication(self.read(path), 'group', path, 'old', 'old-claim')
+        await asyncio.wait_for(self.run_task(), 5)
+        self.assertEqual(len(self.sent), 1)
+        self.assertEqual(self.pane.task_states['r1']['success'], 1)
+
+    async def test_bytes_upload_is_recoverable_until_final_publication(self):
+        self.file()
+        async def uploading(path):
+            with self.history.db.session() as db:
+                self.assertEqual(db.execute('SELECT prepublication FROM upload_reservations').fetchone()[0], 1)
+        original = self.history.mark_publishing
+        marked = []
+        def marker(*args):
+            marked.append(True)
+            return original(*args)
+        self.history.mark_publishing = marker
+        await asyncio.wait_for(self.run_task(uploading), 5)
+        self.assertEqual(marked, [True])
+        self.assertEqual(len(self.sent), 1)
