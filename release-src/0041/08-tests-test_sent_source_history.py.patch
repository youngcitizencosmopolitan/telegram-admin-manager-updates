+class SourceMigrationTests(unittest.TestCase):
+    def test_first_launch_legacy_import_is_guarded_immediately(self):
+        import sqlite3
+        from tam_core.repositories import UploadHistory
+        with tempfile.TemporaryDirectory() as td:
+            legacy=Path(td)/'uploads.db'
+            c=sqlite3.connect(legacy)
+            c.execute('CREATE TABLE uploads(target_key TEXT,fingerprint TEXT,path TEXT,size INTEGER,mtime_ns INTEGER,account_user_id INTEGER,account_label TEXT,message_id INTEGER,completed_at REAL)')
+            c.execute('INSERT INTO uploads VALUES(?,?,?,?,?,?,?,?,?)',
+                ('Channel:1#topic:7','old-full','C:/old/VIP/Studio/movie.mp4',100,1,1,'test',7,1))
+            c.commit();c.close()
+            history=UploadHistory(legacy)
+            self.assertEqual(history.db.upload_claim_fingerprint(target_key='Channel:1#forum:new',fingerprint='partial',
+                path='Z:/VIP/Studio/movie.mp4',run_token='now',claim_token='new',match_source=True),'completed')
+
+    def test_existing_history_and_reservations_get_metadata_keys_without_media_reads(self):
+        import sqlite3
+        from unittest.mock import patch
+        with tempfile.TemporaryDirectory() as td:
+            path=Path(td)/'state.db'
+            c=sqlite3.connect(path)
+            c.executescript("""
+                CREATE TABLE uploads(id INTEGER PRIMARY KEY, target_key TEXT NOT NULL, fingerprint TEXT NOT NULL,
+                    path TEXT NOT NULL,size INTEGER NOT NULL,mtime_ns INTEGER NOT NULL,account_user_id INTEGER,
+                    account_label TEXT,message_id INTEGER,completed_at REAL NOT NULL, UNIQUE(target_key,fingerprint));
+                CREATE TABLE upload_reservations(target_key TEXT NOT NULL,fingerprint TEXT NOT NULL,path TEXT NOT NULL,
+                    run_token TEXT NOT NULL,claim_token TEXT NOT NULL,reserved_at REAL NOT NULL,prepublication INTEGER NOT NULL DEFAULT 0,
+                    PRIMARY KEY(target_key,fingerprint));
+                INSERT INTO uploads VALUES(1,'Channel:1#topic:7','old-complete','C:/old/VIP/Studio/movie.mp4',100,12,1,'test',7,1);
+                INSERT INTO upload_reservations VALUES('Channel:2#topic:7','old-part','C:/old/VIP/Studio/movie.mp4','past','old',1,1);
+            """)
+            c.commit();c.close()
+            with patch.object(Path,'stat',side_effect=AssertionError('Migration must not stat media')):
+                # Parent directory creation itself may use stat on some platforms;
+                # only the pure key builder must be filesystem-independent.
+                from tam_core.source_history import source_key
+                self.assertEqual(len(source_key('C:/old/VIP/Studio/movie.mp4')),64)
+            db=StateDatabase(path)
+            with db.session() as c:
+                row=c.execute('select fingerprint,path,size,mtime_ns,message_id,source_key from uploads').fetchone()
+                self.assertEqual(tuple(row[:5]),('old-complete','C:/old/VIP/Studio/movie.mp4',100,12,7))
+                self.assertEqual(len(row[5]),64)
+            self.assertEqual(db.upload_claim_fingerprint(target_key='Channel:1#forum:new',fingerprint='partial',
+                path='Z:/VIP/Studio/movie.mp4',run_token='now',claim_token='new',match_source=True),'completed')
+            self.assertEqual(db.upload_claim_fingerprint(target_key='Channel:2#forum:new',fingerprint='new-part',
+                path='Z:/VIP/Studio/movie.mp4',run_token='now',claim_token='new',prepublication=True,match_source=True),'reserved')
+            self.assertFalse(db.upload_mark_publishing('Channel:2#topic:7','old-part','old'))
+
+    def test_policy_save_uses_one_thread_safe_setting_patch(self):
+        from types import SimpleNamespace
+        from batch_uploader import BatchUploaderPane
+        pane=BatchUploaderPane.__new__(BatchUploaderPane)
+        patches=[]
+        pane.app=SimpleNamespace(store=SimpleNamespace(update=patches.append))
+        pane.source_history_var=SimpleNamespace(get=lambda:False)
+        pane._save_source_history_guard()
+        self.assertEqual(patches,[{'monitor_skip_sent_sources':False}])
+
