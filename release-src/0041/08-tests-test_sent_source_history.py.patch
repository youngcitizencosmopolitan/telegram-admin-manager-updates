+class SourceHistoryTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.db = StateDatabase(Path(self.tmp.name) / 'state.db')
+        self.old = r'C:\old\VIP\Studio\Movie.mp4'
+        self.restored = r'\\server\share\VIP\Studio\movie.mp4'
+
+    def record(self):
+        self.db.upload_record(target_key='Channel:1#topic:7', fingerprint='old-complete',
+            path=self.old, size=100, mtime_ns=1, account_user_id=1, account_label='test', message_id=7)
+
+    def claim(self, fp='partial', path=None, target='Channel:1#forum:new', run='current', token='new'):
+        return self.db.upload_claim_fingerprint(target_key=target, fingerprint=fp,
+            path=path or self.restored, run_token=run, claim_token=token, prepublication=True, match_source=True)
+
+    def test_sent_source_blocks_changed_size_date_and_fingerprint(self):
+        self.record()
+        rows=[('Channel:1#forum:new',self.restored,20,99,'partial',0)]
+        self.assertEqual(self.db.upload_completed_candidates(rows,'Channel:1',match_source=True),{0})
+        self.assertEqual(self.claim(),'completed')
+        self.assertEqual(self.db.upload_completed_candidates(rows,'Channel:1'),set())
+
+    def test_other_group_and_other_subfolder_remain_independent(self):
+        self.record()
+        self.assertEqual(self.claim(target='Channel:10#forum:new'), 'reserved')
+        self.assertEqual(self.claim(path=r'Z:\VIP\Other\movie.mp4'), 'reserved')
+
+    def test_different_partial_versions_cannot_be_claimed_together(self):
+        self.assertEqual(self.claim(fp='part1',token='one'),'reserved')
+        self.assertEqual(self.claim(fp='part2',token='two'),'in_progress')
+
+    def test_uncertain_sent_source_remains_blocked_across_content_changes(self):
+        self.assertEqual(self.claim(fp='part1',run='old',token='old'),'reserved')
+        self.assertTrue(self.db.upload_mark_publishing('Channel:1#forum:new','part1','old'))
+        self.assertEqual(self.claim(fp='part2'),'stale')
+
+    def test_safe_source_reclaim_fences_old_content_worker(self):
+        self.assertEqual(self.claim(fp='part1',run='old',token='old'),'reserved')
+        self.assertEqual(self.claim(fp='part2'),'reserved')
+        self.assertFalse(self.db.upload_mark_publishing('Channel:1#forum:new','part1','old'))
+
+    def test_two_threads_reserve_one_source_even_with_different_fingerprints(self):
+        from concurrent.futures import ThreadPoolExecutor
+        from threading import Barrier
+        barrier=Barrier(2)
+        def attempt(fp):
+            barrier.wait(timeout=3)
+            return self.claim(fp=fp,token=fp)
+        with ThreadPoolExecutor(max_workers=2) as pool:
+            self.assertCountEqual(list(pool.map(attempt,('part1','part2'))),['reserved','in_progress'])
+
