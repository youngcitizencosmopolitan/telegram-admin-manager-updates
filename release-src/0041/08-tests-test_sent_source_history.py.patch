+class SourceWorkerTests(unittest.IsolatedAsyncioTestCase):
+    asyncSetUp=fixture.PrefetchUploadTests.asyncSetUp
+    asyncTearDown=fixture.PrefetchUploadTests.asyncTearDown
+    run_task=fixture.PrefetchUploadTests.run_task
+    file=fixture.PrefetchUploadTests.file
+    read=fixture.PrefetchUploadTests.read
+
+    def setup_restoration(self, *, monitor=True, folder='Studio'):
+        old=self.root/'old'/'VIP'/'Studio'/'movie.mp4'
+        old.parent.mkdir(parents=True);old.write_bytes(b'complete-video')
+        self.history.record_completed(old,'group#topic:7',b'complete-video'.hex(),self.account,7)
+        current=self.root/'restored'/'VIP'/folder/'movie.mp4'
+        current.parent.mkdir(parents=True);current.write_bytes(b'part')
+        self.rule.update(folder=str(current.parent),monitor_folder=monitor,forum_topics_from_subfolders=True)
+        async def topics(*args):return {}
+        self.pane._prepare_forum_topics=topics
+        return current
+
+    async def test_partial_restoration_of_sent_source_is_skipped_without_hashing(self):
+        self.setup_restoration()
+        await self.run_task()
+        self.assertEqual(self.sent,[])
+        self.assertEqual(self.reads,[])
+        self.assertEqual(self.pane.task_states['r1']['skipped'],1)
+
+    async def test_disabling_guard_allows_intentional_replacement(self):
+        self.setup_restoration()
+        self.pane.app.store.data['monitor_skip_sent_sources']=False
+        await self.run_task()
+        self.assertEqual(len(self.sent),1)
+
+    async def test_manual_task_keeps_content_based_behavior(self):
+        self.setup_restoration(monitor=False)
+        await self.run_task()
+        self.assertEqual(len(self.sent),1)
+
+    async def test_other_subfolder_can_send_same_generic_filename(self):
+        self.setup_restoration(folder='Other')
+        await self.run_task()
+        self.assertEqual(len(self.sent),1)
+
+    async def test_new_group_can_send_previously_known_source(self):
+        self.setup_restoration()
+        self.pane.app._target_key=lambda entity:'new-group'
+        await self.run_task()
+        self.assertEqual(len(self.sent),1)
+
