+class SourceIdentityTests(unittest.TestCase):
+    def test_case_unicode_and_relocated_root_keep_source_identity(self):
+        from tam_core.source_history import source_key
+        self.assertEqual(source_key('C:/old/VIP/Studio/caf\u00e9.mp4'),
+                         source_key('Z:/new/vip/STUDIO/cafe\u0301.MP4'))
+        self.assertNotEqual(source_key('Z:/VIP/Studio/movie.mp4'),source_key('Z:/VIP/Other/movie.mp4'))
+        self.assertEqual(source_key(''), '')
+
+    def test_indexed_source_lookup_is_bounded_with_large_history(self):
+        import contextlib
+        from unittest.mock import patch
+        from tam_core.source_history import source_key
+        with tempfile.TemporaryDirectory() as td:
+            db=StateDatabase(Path(td)/'state.db')
+            with db.session() as c:
+                c.executemany('INSERT INTO uploads(target_key,fingerprint,path,size,mtime_ns,completed_at,source_key) VALUES(?,?,?,?,?,?,?)',
+                    [('Channel:1#topic:7','fp%d'%i,'C:/old/VIP/Studio/%d.mp4'%i,100,1,1,
+                      source_key('C:/old/VIP/Studio/%d.mp4'%i)) for i in range(10000)])
+            original=db.session
+            @contextlib.contextmanager
+            def bounded():
+                with original() as c:
+                    c.set_progress_handler(lambda:1,2000)
+                    yield c
+            with patch.object(db,'session',bounded):
+                self.assertEqual(db.upload_completed_candidates([
+                    ('Channel:1#forum:new','Z:/VIP/Studio/9999.mp4',0,9,'partial',0)],'Channel:1',match_source=True),{0})
+                self.assertEqual(db.upload_claim_fingerprint(target_key='Channel:1#forum:new',fingerprint='partial',
+                    path='Z:/VIP/Studio/9999.mp4',run_token='now',claim_token='new',match_source=True),'completed')
