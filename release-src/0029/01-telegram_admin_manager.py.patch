+    async def _reauthorize_account_phone_async(self, existing_account: Account, phone: str) -> None:
+        from tam_core.session_recovery import copy_session_database
+        phone = re.sub(r'[\s()\-]', '', phone.strip())
+        if phone.startswith('00'):
+            phone = '+' + phone[2:]
+        if not re.fullmatch(r'\+[1-9][0-9]{4,14}', phone):
+            raise RuntimeError('Введи номер в международном формате, начиная с + и кода страны.')
+        session_name = existing_account.session
+        if (not session_name or session_name in {'.', '..'}
+                or not re.fullmatch(r'[A-Za-z0-9_.-]+', session_name)):
+            raise RuntimeError('Некорректное имя локальной сессии.')
+
+        def check_current():
+            if getattr(self, '_closed', False):
+                raise RuntimeError('Приложение закрыто; вход отменён.')
+            if not any(a.session == session_name and a.user_id == existing_account.user_id for a in self.store.accounts()):
+                raise RuntimeError('Аккаунт изменён или удалён во время входа.')
+
+        check_current()
+        api_id, api_hash = self._api_credentials()
+        session_file = SESSIONS_DIR / f'{session_name}.session'
+        backup = None
+        if session_file.exists():
+            backup = DATA_DIR / 'backups' / 'reauth' / f'{session_name}-{time.time_ns()}.session'
+            await asyncio.to_thread(copy_session_database, session_file, backup)
+        client, working_session_name, saved = None, None, False
+        try:
+            client = TelegramClient(str(SESSIONS_DIR / session_name), api_id, api_hash)
+            try:
+                await client.connect()
+                authorized = await client.is_user_authorized()
+            except Exception as exc:
+                if exc.__class__.__name__ not in {
+                    'AuthKeyUnregisteredError', 'AuthKeyInvalidError', 'AuthKeyDuplicatedError',
+                    'SessionRevokedError', 'SessionExpiredError',
+                }:
+                    raise
+                authorized = False
+            if authorized:
+                me = await client.get_me()
+                if not me or me.id != existing_account.user_id:
+                    raise RuntimeError('Локальная сессия принадлежит другому аккаунту.')
+                check_current()
+                saved = True
+                uploader = getattr(self, 'batch_uploader', None)
+                if uploader is not None:
+                    uploader.clear_session_auth_required(session_name)
+                self.ui_call(self.refresh_account_list)
+                self.ui_call(lambda: messagebox.showinfo(APP_NAME,
+                    'Сессия выбранного аккаунта уже авторизована. Повторный вход не требуется.'))
+                return
+
+            await client.disconnect()
+            working_session_name = f'phone_reauth_{time.time_ns()}'
+            client = TelegramClient(str(SESSIONS_DIR / working_session_name), api_id, api_hash)
+            await client.connect()
+            if await client.is_user_authorized():
+                raise RuntimeError('Новая сессия неожиданно уже авторизована.')
+            check_current()
+            self.log('Повторный вход: запрашиваю код Telegram…')
+            sent = await client.send_code_request(phone)
+            delivery = self._sent_code_description(sent)
+            self.log(f'Telegram сообщает: код отправлен {delivery}.')
+            code = await self.ui_ask_async(lambda: simpledialog.askstring(APP_NAME,
+                f'Код отправлен {delivery}.\n\nЕсли аккаунт открыт на ПК, проверь служебный чат Telegram.\nВведи код для {phone}:',
+                parent=self))
+            check_current()
+            if not code:
+                raise RuntimeError('Повторный вход отменён.')
+            try:
+                await client.sign_in(phone=phone, code=code.strip(), phone_code_hash=sent.phone_code_hash)
+            except errors.SessionPasswordNeededError:
+                password = await self.ui_ask_async(lambda: simpledialog.askstring(APP_NAME,
+                    'Включена двухэтапная проверка. Введи пароль 2FA:', parent=self, show='*'))
+                check_current()
+                if not password:
+                    raise RuntimeError('Повторный вход отменён: не введён пароль 2FA.')
+                await client.sign_in(password=password)
+            if not await client.is_user_authorized():
