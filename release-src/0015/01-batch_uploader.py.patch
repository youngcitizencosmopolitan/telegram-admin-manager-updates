     def _save_monitor_rule(self, rule: dict[str, Any]) -> None:
         self.app.monitor_rules.put(rule)
         self.refresh_monitor_tab()
+
+    def set_monitor_accounts_for_all(self, sessions: list[str]) -> int:
+        known = {account.session for account in self.app.store.accounts()}
+        selected = list(dict.fromkeys(str(s) for s in sessions if str(s) in known))
+        if not selected:
+            raise ValueError("Выбери хотя бы один существующий аккаунт.")
+        rule_ids = set(self.app.monitor_rules.set_accounts_for_all(selected))
+        with self._queue_lock:
+            for item in self.pending_batches:
+                if not _is_monitor_queue_item(item):
+                    continue
+                for snapshot in item.get("task_snapshots", []) or []:
+                    if isinstance(snapshot, dict) and str(snapshot.get("id", "")) in rule_ids:
+                        snapshot.update(account_sessions=list(selected), use_all_accounts=False,
+                                        monitor_accounts_override=True)
+                try:
+                    self.app.store.db.queue_mark(str(item.get("id", "")), "waiting", item)
+                except Exception as exc:
+                    self.app.log(f"Мониторинг: не удалось обновить снимок очереди — {exc}")
+        self.app.log(f"Мониторинг: выбрано аккаунтов {len(selected)} для всех правил ({len(rule_ids)}). "
+                     "Текущая пачка завершится с прежним составом; следующие используют выбранный список.")
+        self.refresh_monitor_tab(force=True)
+        return len(rule_ids)
+
+    def choose_monitor_accounts_for_all(self) -> None:
+        accounts, rules = self.app.store.accounts(), self.monitor_rules()
+        if not accounts or not rules:
+            messagebox.showinfo("Telegram Admin Manager", "Сначала добавь аккаунты и правила мониторинга.", parent=self.app)
+            return
+        known = {a.session for a in accounts}
+        selected = set(known)
+        for rule in rules:
+            if not rule.get("use_all_accounts", True):
+                selected.intersection_update(rule.get("account_sessions", []) or [])
+        dlg = tk.Toplevel(self.app)
+        dlg.title("Аккаунты для всех правил мониторинга")
+        dlg.geometry("640x520")
+        dlg.minsize(540, 380)
+        dlg.transient(self.app)
+        body = ttk.Frame(dlg, padding=12)
+        body.pack(fill="both", expand=True)
+        ttk.Label(body, text=f"Один список аккаунтов для всех правил: {len(rules)}", font=("Segoe UI", 11, "bold")).pack(anchor="w")
+        ttk.Label(body, text="Список заменит участников существующих правил. Новые аккаунты автоматически не добавляются. "
+                  "Текущая пачка завершится с прежним составом.",
+                  wraplength=590).pack(anchor="w", pady=(6, 10))
+        area = ttk.Frame(body)
+        area.pack(fill="both", expand=True)
+        canvas = tk.Canvas(area, highlightthickness=0)
+        scroll = ttk.Scrollbar(area, orient="vertical", command=canvas.yview)
+        scroll.pack(side="right", fill="y")
+        canvas.pack(side="left", fill="both", expand=True)
+        canvas.configure(yscrollcommand=scroll.set)
+        checks = ttk.Frame(canvas)
+        window = canvas.create_window((0, 0), window=checks, anchor="nw")
+        checks.bind("<Configure>", lambda _e: canvas.configure(scrollregion=canvas.bbox("all")))
+        canvas.bind("<Configure>", lambda e: canvas.itemconfigure(window, width=e.width))
+        variables = {a.session: tk.BooleanVar(value=a.session in selected) for a in accounts}
+        for account in accounts:
+            usage = getattr(self.app, "account_usage_allows", None)
+            suffix = " — мониторинг запрещён в настройках аккаунта" if callable(usage) and not usage(account.session, "monitoring") else ""
+            ttk.Checkbutton(checks, text=account.display + suffix, variable=variables[account.session]).pack(anchor="w", pady=3)
+        buttons = ttk.Frame(body)
+        buttons.pack(fill="x", pady=(10, 0))
+        def select_all(value: bool) -> None:
+            for variable in variables.values():
+                variable.set(value)
+        def apply() -> None:
+            try:
+                self.set_monitor_accounts_for_all([s for s, variable in variables.items() if variable.get()])
+            except Exception as exc:
+                messagebox.showerror("Telegram Admin Manager", str(exc), parent=dlg)
+                return
+            dlg.destroy()
+        ttk.Button(buttons, text="Все", command=lambda: select_all(True)).pack(side="left")
+        ttk.Button(buttons, text="Ни одного", command=lambda: select_all(False)).pack(side="left", padx=5)
+        ttk.Button(buttons, text="Применить ко всем правилам", command=apply).pack(side="right")
+        ttk.Button(buttons, text="Отмена", command=dlg.destroy).pack(side="right", padx=5)
+        dlg.grab_set()
 
