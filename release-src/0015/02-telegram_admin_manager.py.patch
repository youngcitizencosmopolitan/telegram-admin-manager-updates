+    def _target_cache_scope(self, client: Any) -> tuple[str, str] | None:
+        store = self.__dict__.get("store")
+        accounts = getattr(store, "accounts", None)
+        session = getattr(client, "session", None)
+        filename = getattr(session, "filename", None)
+        auth_key = getattr(getattr(session, "auth_key", None), "key", None)
+        if not callable(accounts) or not filename or not isinstance(auth_key, bytes) or not auth_key:
+            return None
+        name = Path(str(filename)).name.removesuffix(".session")
+        for account in accounts():
+            if str(account.session).removesuffix(".session") == name:
+                identity = f"{int(account.user_id)}:{hashlib.sha256(auth_key).hexdigest()}"
+                return str(account.session), identity
+        return None
