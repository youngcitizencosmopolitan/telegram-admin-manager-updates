+class MonitorSelectionScanRaceTests(unittest.IsolatedAsyncioTestCase):
+    async def test_bulk_selection_survives_scan_already_in_progress(self):
+        with tempfile.TemporaryDirectory() as td:
+            store = ConfigStore(Path(td) / 'config.json')
+            repo = MonitorRuleStore(store.db)
+            repo.put(dict(id='r', monitor_folder=True, monitor_seen_initialized=True,
+                          use_all_accounts=True, folder=td, target='@g'))
+            entered, release = threading.Event(), threading.Event()
+            pane = BatchUploaderPane.__new__(BatchUploaderPane)
+            pane.app = SimpleNamespace(monitor_rules=repo, ui_call=lambda fn: fn(), log=lambda *a: None)
+            pane.monitor_rules = repo.all
+            pane.monitor_runtime, pane.monitor_last_signatures, pane.monitor_pending_signatures = {}, {}, {}
+            pane.monitor_stop_event = threading.Event()
+            pane.refresh_monitor_tab = lambda: None
+            queued = []
+            pane._enqueue_batch = lambda tasks, **kwargs: queued.extend(tasks)
+            def scan(rule):
+                entered.set()
+                if not release.wait(3):
+                    raise TimeoutError('Test scan was never released')
+                pane.monitor_stop_event.set()
+                return 'signature', {'new.mp4'}
+            pane._scan_monitor_snapshot = scan
+            running = asyncio.create_task(pane._monitor_loop())
+            try:
+                self.assertTrue(await asyncio.to_thread(entered.wait, 3))
+                repo.set_accounts_for_all(['chosen'])
+                release.set()
+                await asyncio.wait_for(running, 3)
+                self.assertEqual(repo.get('r')['account_sessions'], ['chosen'])
+                self.assertFalse(repo.get('r')['use_all_accounts'])
+                self.assertEqual(queued[0]['account_sessions'], ['chosen'])
+            finally:
+                release.set()
+                if not running.done():
+                    running.cancel()
+                await asyncio.gather(running, return_exceptions=True)
+
+
+if __name__ == '__main__':
+    unittest.main()
