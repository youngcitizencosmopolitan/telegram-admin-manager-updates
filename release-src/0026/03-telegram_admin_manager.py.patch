+    async def ui_ask_async(self, func: Callable[[], Any]) -> Any:
+        """Keep the Telegram loop alive while Tk constructs a login prompt."""
+        loop = asyncio.get_running_loop()
+        result = loop.create_future()
+
+        def deliver(value, error):
+            if result.done():
+                return
+            if error is not None:
+                result.set_exception(error)
+            else:
+                result.set_result(value)
+
+        def callback():
+            if result.done():
+                return
+            try:
+                value, error = func(), None
+            except Exception as exc:
+                value, error = None, exc
+            try:
+                loop.call_soon_threadsafe(deliver, value, error)
+            except RuntimeError:
+                pass  # The login was cancelled before this UI callback ran.
+
+        try:
+            self.ui_call(callback)
+            while not result.done():
+                if getattr(self, '_closed', False):
+                    raise RuntimeError('Приложение закрыто; вход отменён.')
+                await asyncio.wait({result}, timeout=.1)
+            return await result
+        finally:
+            if not result.done():
+                result.cancel()
+
