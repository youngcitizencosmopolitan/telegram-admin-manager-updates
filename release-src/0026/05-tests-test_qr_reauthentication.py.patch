--- /dev/null
+++ b/app/tests/test_qr_reauthentication.py
@@ -0,0 +1,262 @@
+import asyncio
+import inspect
+import sqlite3
+import tempfile
+import threading
+import unittest
+from contextlib import closing
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import telegram_admin_manager as main
+from tam_core.models import Account
+from tam_core.repositories import ConfigStore
+
+
+class PasswordNeeded(Exception):
+    pass
+
+
+class QRReauthenticationTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.sessions = self.root/'sessions'
+        self.sessions.mkdir()
+        self.existing = Account(session='restored', label='Saved account', phone='', user_id=7)
+        self.other = Account(session='other', label='Other account', phone='', user_id=8)
+        store = ConfigStore(self.root/'config.json')
+        store.set_accounts([self.existing, self.other])
+        self.authorized = False
+        self.returned_id = 7
+        self.expire_once = self.password_needed = self.cancel = self.fail_dialog = False
+        self.cancel_on_get_me = False
+        self.displayed = []
+        self.client = None
+        self.client_paths = []
+        self.loop = asyncio.get_running_loop()
+        self.app = SimpleNamespace(store=store, _api_credentials=lambda: (1, 'synthetic-api-hash'),
+            ui_ask=lambda fn: fn(), ui_call=lambda fn: fn(), log=lambda text: None,
+            refresh_account_list=lambda: None)
+        self.app._account_from_me = main.TelegramAdminManager._account_from_me
+        self.app.ui_ask_async = lambda fn: main.TelegramAdminManager.ui_ask_async(self.app, fn)
+        self.app._save_account = lambda account: main.TelegramAdminManager._save_account(self.app, account)
+        self.app._delete_session_files = main.TelegramAdminManager._delete_session_files
+        owner = self
+
+        class FakeQR:
+            url = 'tg://login?token=synthetic-1'
+            listener_ready = False
+            calls = 0
+
+            def __init__(self, client):
+                self.client = client
+                self.scan = asyncio.Event()
+                self.wait_task = None
+
+            async def recreate(self):
+                self.url = 'tg://login?token=synthetic-2'
+
+            async def wait(self):
+                self.wait_task = asyncio.current_task()
+                self.listener_ready = True
+                self.calls += 1
+                if owner.expire_once and self.calls == 1:
+                    raise asyncio.TimeoutError()
+                await self.scan.wait()
+                if owner.password_needed:
+                    raise PasswordNeeded()
+                self.client.finish_login()
+                return await self.client.get_me()
+
+        class FakeClient:
+            def __init__(self, path, *args, **kwargs):
+                self.path = Path(path+'.session')
+                owner.client_paths.append(self.path)
+                if not self.path.exists():
+                    with closing(sqlite3.connect(self.path)) as db, db:
+                        db.execute('CREATE TABLE auth(value TEXT)')
+                        db.execute("INSERT INTO auth VALUES('original')")
+                self.authorized = owner.authorized
+                self.qr = FakeQR(self)
+                self.ignored = None
+                self.disconnected = False
+                self.get_me_calls = 0
+                owner.client = self
+
+            async def connect(self): pass
+            async def disconnect(self): self.disconnected = True
+            async def is_user_authorized(self): return self.authorized
+            async def get_me(self):
+                self.get_me_calls += 1
+                if owner.cancel_on_get_me and self.get_me_calls >= 2:
+                    owner.dialog.cancelled.set()
+                return SimpleNamespace(id=owner.returned_id, first_name='Synthetic')
+            async def qr_login(self, ignored_ids):
+                self.ignored = ignored_ids
+                return self.qr
+            async def sign_in(self, password): self.finish_login()
+            def finish_login(self):
+                self.authorized = True
+                with closing(sqlite3.connect(self.path)) as db, db:
+                    db.execute("UPDATE auth SET value='new login'")
+
+        class FakeDialog:
+            def __init__(self, parent, url):
+                self.cancelled = threading.Event()
+                owner.dialog = self
+                owner.assertTrue(owner.client.qr.listener_ready,
+                    'Login-token listener must be registered before showing the QR')
+                if owner.fail_dialog:
+                    raise RuntimeError('synthetic render failure')
+                self.update_qr(url)
+            def update_qr(self, url):
+                owner.displayed.append(url)
+                if owner.cancel:
+                    self.cancelled.set()
+                elif not (owner.expire_once and url.endswith('-1')):
+                    owner.loop.call_soon_threadsafe(owner.client.qr.scan.set)
+            def title(self, text): pass
+            def set_status(self, text): pass
+            def close_success(self): pass
+
+        for target, value in [('DATA_DIR',self.root), ('SESSIONS_DIR',self.sessions),
+                              ('TelegramClient',FakeClient), ('QRLoginDialog',FakeDialog),
+                              ('errors',SimpleNamespace(SessionPasswordNeededError=PasswordNeeded))]:
+            p = patch.object(main, target, value)
+            p.start(); self.addCleanup(p.stop)
+        for target, value in [('showinfo',None), ('showerror',None)]:
+            p = patch.object(main.messagebox, target, return_value=value)
+            p.start(); self.addCleanup(p.stop)
+        p = patch.object(main.simpledialog, 'askstring', return_value='synthetic-password')
+        p.start(); self.addCleanup(p.stop)
+        with closing(sqlite3.connect(self.sessions/'restored.session')) as db, db:
+            db.execute('CREATE TABLE auth(value TEXT)')
+            db.execute("INSERT INTO auth VALUES('original')")
+
+    async def run_login(self, existing=None):
+        method = main.TelegramAdminManager._add_account_qr_async
+        if existing is not None:
+            self.assertIn('existing_account', inspect.signature(method).parameters,
+                          'Saved accounts need an explicit reauthentication path')
+            return await asyncio.wait_for(method(self.app, '', existing_account=existing), 2)
+        return await asyncio.wait_for(method(self.app, ''), 2)
+
+    async def test_listener_is_ready_before_new_qr_is_shown(self):
+        self.returned_id = 9
+        await self.run_login()
+        self.assertTrue(self.client.disconnected)
+
+    async def test_existing_valid_session_needs_no_new_qr(self):
+        self.authorized = True
+        await self.run_login(self.existing)
+        self.assertIsNone(self.client.ignored)
+        self.assertEqual(self.displayed, [])
+        self.assertEqual({a.session for a in self.app.store.accounts()}, {'restored','other'})
+
+    async def test_saved_account_is_allowed_and_keeps_rule_and_usage_identity(self):
+        self.app.store.db.account_usage_set('restored', {'monitoring':False})
+        self.app.store.data['monitor_selected_sessions'] = ['restored']
+        await self.run_login(self.existing)
+        self.assertNotIn(7, self.client.ignored)
+        self.assertIn(8, self.client.ignored)
+        self.assertEqual({a.session for a in self.app.store.accounts()}, {'restored','other'})
+        self.assertEqual(self.app.store.data['monitor_selected_sessions'], ['restored'])
+        self.assertFalse(self.app.store.db.account_usage_get('restored')['monitoring'])
+
+    async def test_wrong_account_does_not_replace_saved_identity_or_session(self):
+        self.returned_id = 99
+        with self.assertRaises(RuntimeError):
+            await self.run_login(self.existing)
+        self.assertEqual(self.app.store.accounts(), [self.existing,self.other])
+        with closing(sqlite3.connect(self.sessions/'restored.session')) as db, db:
+            self.assertEqual(db.execute('SELECT value FROM auth').fetchone()[0], 'original')
+
+    async def test_reauthentication_uses_fresh_auth_session_until_owner_is_verified(self):
+        await self.run_login(self.existing)
+        self.assertEqual(len(self.client_paths), 2)
+        self.assertNotEqual(self.client_paths[0], self.client_paths[1],
+                            'A failed old auth key must not be authorized as a different owner')
+        self.assertFalse(self.client_paths[1].exists())
+        with closing(sqlite3.connect(self.sessions/'restored.session')) as db, db:
+            self.assertEqual(db.execute('SELECT value FROM auth').fetchone()[0], 'new login')
+
+    async def test_cancel_preserves_existing_session_and_cleans_waiter(self):
+        self.cancel = True
+        with self.assertRaises(RuntimeError):
+            await self.run_login(self.existing)
+        self.assertTrue(self.client.qr.wait_task.done())
+        with closing(sqlite3.connect(self.sessions/'restored.session')) as db, db:
+            self.assertEqual(db.execute('SELECT value FROM auth').fetchone()[0], 'original')
+
+    async def test_expired_qr_is_replaced_with_new_listened_token(self):
+        self.expire_once = True
+        await self.run_login(self.existing)
+        self.assertEqual(self.displayed, ['tg://login?token=synthetic-1','tg://login?token=synthetic-2'])
+
+    async def test_two_factor_login_keeps_saved_account_identity(self):
+        self.password_needed = True
+        await self.run_login(self.existing)
+        self.assertTrue(self.client.authorized)
+        self.assertEqual({a.session for a in self.app.store.accounts()}, {'restored','other'})
+
+    async def test_dialog_failure_cancels_login_waiter(self):
+        self.fail_dialog = True
+        with self.assertRaisesRegex(RuntimeError, 'render failure'):
+            await self.run_login(self.existing)
+        self.assertTrue(self.client.qr.wait_task.done())
+
+    async def test_storage_failure_restores_original_session_and_account(self):
+        with patch.object(self.app.store.db, 'save_config', side_effect=sqlite3.OperationalError('synthetic write error')):
+            with self.assertRaises(sqlite3.OperationalError):
+                await self.run_login(self.existing)
+        self.assertEqual(self.app.store.accounts(), [self.existing,self.other])
+        with closing(sqlite3.connect(self.sessions/'restored.session')) as db, db:
+            self.assertEqual(db.execute('SELECT value FROM auth').fetchone()[0], 'original')
+
+    async def test_cancel_after_scanning_is_honored_before_installing_session(self):
+        self.cancel_on_get_me = True
+        with self.assertRaises(RuntimeError):
+            await self.run_login(self.existing)
+        self.assertEqual(self.app.store.accounts(), [self.existing,self.other])
+        with closing(sqlite3.connect(self.sessions/'restored.session')) as db, db:
+            self.assertEqual(db.execute('SELECT value FROM auth').fetchone()[0], 'original')
+
+    async def test_restore_failure_still_removes_temporary_authenticated_session(self):
+        from tam_core.session_recovery import copy_session_database
+        self.returned_id = 99
+        def copy(source, destination):
+            if source.parent.name == 'reauth':
+                raise OSError('synthetic restore failure')
+            return copy_session_database(source, destination)
+        with patch('tam_core.session_recovery.copy_session_database', side_effect=copy):
+            with self.assertRaises(OSError):
+                await self.run_login(self.existing)
+        self.assertFalse(self.client_paths[-1].exists())
+
+
+class AsyncUIBridgeTests(unittest.IsolatedAsyncioTestCase):
+    async def invoke(self, app, callback):
+        method = getattr(main.TelegramAdminManager, 'ui_ask_async', None)
+        self.assertTrue(callable(method), 'QR login must await UI without blocking its event loop or leaking a waiting thread')
+        return await method(app, callback)
+
+    async def test_ui_result_and_exception_are_delivered(self):
+        app = SimpleNamespace(_closed=False, ui_call=lambda fn: fn())
+        self.assertEqual(await self.invoke(app, lambda: 42), 42)
+        def fail(): raise ValueError('synthetic ui failure')
+        with self.assertRaises(ValueError):
+            await self.invoke(app, fail)
+
+    async def test_closing_app_cancels_a_not_yet_displayed_prompt(self):
+        queued = []
+        app = SimpleNamespace(_closed=False, ui_call=queued.append)
+        task = asyncio.create_task(self.invoke(app, lambda: 42))
+        await asyncio.sleep(0)
+        app._closed = True
+        with self.assertRaises(RuntimeError):
+            await asyncio.wait_for(task, .5)
+        for callback in queued:
+            callback()  # Late callbacks must be harmless after cancellation.
