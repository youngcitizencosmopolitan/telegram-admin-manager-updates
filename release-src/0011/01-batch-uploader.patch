+    @staticmethod
+    def _forum_topic_title_key(title: Any) -> str:
+        """Canonical key used only for forum-topic discovery/routing.
+
+        Telegram/local folder names may contain compatibility Unicode or visually
+        equivalent whitespace (for example NBSP vs a normal space). Those must
+        not be treated as distinct topics when deciding whether creation is safe.
+        """
+        text = unicodedata.normalize("NFKC", str(title or ""))
+        return " ".join(text.split()).casefold()
