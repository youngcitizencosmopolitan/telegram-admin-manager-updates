+class ForumTopicCreationGuardTests(unittest.IsolatedAsyncioTestCase):
+    async def test_existing_topic_found_by_full_scan_is_never_created_again(self):
+        pane = BatchUploaderPane.__new__(BatchUploaderPane)
+        pane.app = _App()
+        pane.stop_event = SimpleNamespace(is_set=lambda: False)
+        pane._local_topic_titles = lambda _task: ["Fansly - naughtyannalee (Video_pack)"]
+        pane._cache_ttl_hours = lambda: 24.0
+        pane._forum_request_class = lambda name: (
+            (_CreateForumTopicRequest, "messages")
+            if name == "CreateForumTopicRequest"
+            else (_GetForumTopicsRequest, "messages")
+        )
+        pane._client_can_manage_topics = lambda *_args: asyncio.sleep(0, result=True)
+        pane._sleep_stop = lambda _seconds: asyncio.sleep(0, result=True)
+
+        existing = _Topic(
+            777,
+            "Fansly\u00a0-\u00a0naughtyannalee  (Video_pack)",
+            9777,
+            1_700_000_000,
+        )
+        full_reads = 0
+
+        async def get_topics(_client, _entity, query=None):
+            nonlocal full_reads
+            if query is not None:
+                return []
+            full_reads += 1
+            # Simulate a stale/incomplete first discovery; the pre-create safety
+            # lookup must do another full sweep and find the existing topic.
+            return [] if full_reads == 1 else [existing]
+
+        pane._get_forum_topics = get_topics
+
+        class _Client:
+            def __init__(self):
+                self.create_calls = 0
+
+            async def __call__(self, request):
+                if isinstance(request, _CreateForumTopicRequest):
+                    self.create_calls += 1
+                    return SimpleNamespace(topic_id=999)
+                raise AssertionError(type(request))
+
+        client = _Client()
+        entity = SimpleNamespace(forum=True, title="Forum")
+        task = {
+            "name": "Rule",
+            "target": "forum-target",
+            "forum_topics_from_subfolders": True,
+            "forum_auto_create_topics": True,
+        }
+        result = await pane._prepare_forum_topics(
+            task,
+            {"s1": (SimpleNamespace(), client)},
+            {"s1": entity},
+        )
+
+        self.assertEqual(client.create_calls, 0)
+        key = pane._forum_topic_title_key("Fansly - naughtyannalee (Video_pack)")
+        self.assertEqual(result[key], existing.id)
+
