+from __future__ import annotations
+
+from typing import Any
+
+
+def serialize_admin_rights(rights: Any) -> dict[str, bool]:
+    if rights is None:
+        return {}
+    out: dict[str, bool] = {}
+    names = set()
+    try:
+        names.update(vars(rights).keys())
+    except Exception:
+        pass
+    slots = getattr(rights.__class__, '__slots__', ()) or ()
+    if isinstance(slots, str):
+        slots = (slots,)
+    names.update(slots)
+    for name in sorted(str(x) for x in names):
+        if not name or name.startswith('_') or name in {'CONSTRUCTOR_ID', 'SUBCLASS_OF_ID'}:
+            continue
+        try:
+            value = getattr(rights, name)
+        except Exception:
+            continue
+        if isinstance(value, bool) or value is None:
+            out[name] = bool(value)
+    return out
+
+
+def relation_from_entity(entity: Any) -> dict[str, Any]:
+    if bool(getattr(entity, 'creator', False)):
+        rights = serialize_admin_rights(getattr(entity, 'admin_rights', None))
+        return {'relation': 'owner', 'rights': rights, 'can_add_admins': True}
+    admin_rights = getattr(entity, 'admin_rights', None)
+    if admin_rights is not None:
+        rights = serialize_admin_rights(admin_rights)
+        return {'relation': 'admin', 'rights': rights, 'can_add_admins': bool(rights.get('add_admins', False))}
+    return {'relation': 'member', 'rights': {}, 'can_add_admins': False}
+
+
+def merge_channel_observation(existing: dict[str, Any] | None, observation: dict[str, Any]) -> dict[str, Any]:
+    base = dict(existing or {})
+    incoming = dict(observation or {})
+    if base and incoming.get('peer_id') is not None and base.get('peer_id') is not None:
+        if int(base['peer_id']) != int(incoming['peer_id']):
+            raise ValueError('cannot merge different peer ids')
+    for key, value in incoming.items():
+        if value not in (None, '') or key not in base:
+            base[key] = value
+    return base
+
+
+def observation_from_entity(entity: Any, *, now: float) -> dict[str, Any]:
+    peer_id = int(getattr(entity, 'id'))
+    username = str(getattr(entity, 'username', '') or '')
+    title = str(getattr(entity, 'title', '') or username or peer_id)
+    kind = 'channel' if entity.__class__.__name__ == 'Channel' else 'group'
+    return {
+        'peer_id': peer_id,
+        'peer_type': kind,
+        'title': title,
+        'username': username,
+        'link': f'https://t.me/{username}' if username else '',
+        'last_seen_at': float(now),
+        'last_refreshed_at': float(now),
+        'status': 'ok',
+        'error': '',
+    }
