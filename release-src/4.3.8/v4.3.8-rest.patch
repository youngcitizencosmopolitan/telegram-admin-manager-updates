+            db.channel_upsert({'peer_id':123,'title':'Alpha','peer_type':'channel','link':'https://t.me/alpha'}); db.channel_upsert({'peer_id':123,'title':'Alpha 2','peer_type':'channel','status':'ok'})
+            rows=db.channels_all(); self.assertEqual(len(rows),1); self.assertEqual(rows[0]['peer_id'],123); self.assertEqual(rows[0]['title'],'Alpha 2')
+            db.channel_account_put(123,'acc_a',{'relation':'admin','rights':{'add_admins':True}}); rels=db.channel_accounts(123); self.assertEqual(rels[0]['session'],'acc_a'); self.assertEqual(rels[0]['relation'],'admin')
+            db.account_restriction_set('acc_a',{'status':'restricted','reason':'peer_flood','source_operation':'join'}); self.assertEqual(db.account_restriction_get('acc_a')['status'],'restricted')
