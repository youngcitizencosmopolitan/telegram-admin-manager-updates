+    def channel_upsert(self, payload: dict[str, Any]) -> None:
+        peer_id = int(payload.get("peer_id"))
+        current = {}
+        with self.session() as conn:
+            row = conn.execute("SELECT payload_json FROM channels WHERE peer_id=?", (peer_id,)).fetchone()
+            if row:
+                try:
+                    obj = json.loads(row[0])
+                    if isinstance(obj, dict):
+                        current = dict(obj)
+                except Exception:
+                    pass
+            merged = dict(current)
+            for key, value in dict(payload).items():
+                if value not in (None, "") or key not in merged:
+                    merged[key] = value
+            merged["peer_id"] = peer_id
+            conn.execute(
+                "INSERT INTO channels(peer_id, payload_json, updated_at) VALUES(?, ?, ?) "
