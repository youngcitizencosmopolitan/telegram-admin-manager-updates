--- a/src/adaptive_tg_bot/bot/keyboards.py
+++ b/src/adaptive_tg_bot/bot/keyboards.py
@@ -1,6 +1,59 @@
 from __future__ import annotations
 
 from datetime import time
+
+
+CHANNEL_CHAT_REQUEST_ID = 1001
+GROUP_CHAT_REQUEST_ID = 1002
+
+
+def _channel_admin_rights(*, can_promote_members: bool):
+    from aiogram.types import ChatAdministratorRights
+
+    return ChatAdministratorRights(
+        is_anonymous=False,
+        can_manage_chat=True,
+        can_delete_messages=False,
+        can_manage_video_chats=False,
+        can_restrict_members=False,
+        can_promote_members=can_promote_members,
+        can_change_info=False,
+        can_invite_users=False,
+        can_post_stories=False,
+        can_edit_stories=False,
+        can_delete_stories=False,
+        can_post_messages=True,
+        can_edit_messages=False,
+        can_pin_messages=False,
+        can_manage_topics=False,
+    )
+
+
+def main_menu_keyboard():
+    from aiogram.types import KeyboardButton, KeyboardButtonRequestChat, ReplyKeyboardMarkup
+
+    channel_request = KeyboardButtonRequestChat(
+        request_id=CHANNEL_CHAT_REQUEST_ID,
+        chat_is_channel=True,
+        user_administrator_rights=_channel_admin_rights(can_promote_members=True),
+        bot_administrator_rights=_channel_admin_rights(can_promote_members=False),
+        request_title=True,
+        request_username=True,
+    )
+    group_request = KeyboardButtonRequestChat(
+        request_id=GROUP_CHAT_REQUEST_ID,
+        chat_is_channel=False,
+        bot_is_member=True,
+        request_title=True,
+        request_username=True,
+    )
+    return ReplyKeyboardMarkup(
+        keyboard=[[
+            KeyboardButton(text="➕ Добавить канал", request_chat=channel_request),
+            KeyboardButton(text="➕ Добавить группу", request_chat=group_request),
+        ]],
+        resize_keyboard=True,
+    )
 
 
 def _inline(rows):
