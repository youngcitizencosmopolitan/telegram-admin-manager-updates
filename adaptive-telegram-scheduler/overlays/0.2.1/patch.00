+
+class SharedChatKind(str, Enum):
+    CHANNEL = "channel"
+    GROUP = "group"
+
+
+def shared_chat_kind(request_id: int) -> SharedChatKind:
+    if request_id == CHANNEL_CHAT_REQUEST_ID:
+        return SharedChatKind.CHANNEL
+    if request_id == GROUP_CHAT_REQUEST_ID:
+        return SharedChatKind.GROUP
