+        message, bot, _FakeDB(session), repo_factory=lambda _: repo
+    )
+
+    assert created is True
+    assert channel.id == 7
+    assert session.commits == 1
+    text, kwargs = message.answers[-1]
+    assert "✅ Канал добавлен: News" in text
+    assert "Внутренний ID: 7" in text
+    assert kwargs["reply_markup"] == "MAIN-MENU"
+
+
+async def test_handle_shared_chat_message_uses_group_label_and_does_not_duplicate(monkeypatch):
+    existing = SimpleNamespace(id=3, telegram_chat_id=-100123, title="Team")
+    repo = _FakeRegistrationRepo(existing=existing)
+    session = _FakeSession()
+    message = _FakeMessage(request_id=GROUP_CHAT_REQUEST_ID)
+    bot = _FakeBot(chat_type="supergroup", status="member", title="Team")
+    monkeypatch.setattr(keyboards_module, "main_menu_keyboard", lambda: "MAIN-MENU")
+
+    channel, created = await handle_shared_chat_message(
+        message, bot, _FakeDB(session), repo_factory=lambda _: repo
+    )
+
+    assert created is False
+    assert channel is existing
+    text, kwargs = message.answers[-1]
+    assert "Группа уже добавлена" in text
+    assert kwargs["reply_markup"] == "MAIN-MENU"
+
+
+def test_channel_router_wires_chat_shared_service_message(monkeypatch):
+    aiogram = types.ModuleType("aiogram")
+    filters = types.ModuleType("aiogram.filters")
+    aiogram_types = types.ModuleType("aiogram.types")
+
+    class _F:
+        chat_shared = object()
+
+    class _Router:
+        last = None
+
+        def __init__(self, name=None):
+            self.name = name
+            self.message_handlers = []
+            _Router.last = self
+
+        def message(self, *filters_):
+            def decorator(fn):
+                self.message_handlers.append((filters_, fn))
+                return fn
+            return decorator
+
+    class _Command:
+        def __init__(self, name):
+            self.name = name
+
+    aiogram.F = _F()
+    aiogram.Router = _Router
+    filters.Command = _Command
+    aiogram_types.Message = type("Message", (), {})
+
+    monkeypatch.setitem(sys.modules, "aiogram", aiogram)
+    monkeypatch.setitem(sys.modules, "aiogram.filters", filters)
+    monkeypatch.setitem(sys.modules, "aiogram.types", aiogram_types)
+
+    from adaptive_tg_bot.bot.channel_handlers import build_router
+
+    build_router()
+
+    names = [fn.__name__ for _, fn in _Router.last.message_handlers]
+    assert "shared_chat" in names
+
+
+from adaptive_tg_bot.bot.handlers import answer_with_main_menu
+
+
