+def test_main_menu_keyboard_serializes_with_real_aiogram_when_installed():
+    pytest.importorskip("aiogram")
+
+    markup = main_menu_keyboard()
+    payload = markup.model_dump(exclude_none=True)
+
+    channel = payload["keyboard"][0][0]["request_chat"]
+    group = payload["keyboard"][0][1]["request_chat"]
+    assert channel["chat_is_channel"] is True
+    assert channel["bot_administrator_rights"]["can_post_messages"] is True
+    assert group["chat_is_channel"] is False
+    assert group["bot_is_member"] is True
+
