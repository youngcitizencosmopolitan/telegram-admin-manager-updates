+from adaptive_tg_bot.bot.channel_handlers import register_shared_target
+
+
+class _FakeRegistrationRepo:
+    def __init__(self, existing=None):
+        self.existing = existing
+        self.created = []
+
+    async def get_or_create_user(self, telegram_user_id):
+        return SimpleNamespace(id=42, telegram_user_id=telegram_user_id)
+
+    async def get_channel_by_telegram_chat_id(self, chat_id):
+        assert chat_id == -100123
+        return self.existing
+
+    async def create_channel_target(self, owner_user_id, telegram_chat_id, title):
+        channel = SimpleNamespace(id=7, owner_user_id=owner_user_id, telegram_chat_id=telegram_chat_id, title=title)
+        self.created.append(channel)
+        return channel
+
+
+async def test_register_shared_target_creates_new_target_once():
+    repo = _FakeRegistrationRepo()
+    target = SimpleNamespace(chat_id=-100123, title="News", kind=SharedChatKind.CHANNEL)
+
+    channel, created = await register_shared_target(repo, 555, target)
+
+    assert created is True
+    assert channel.id == 7
+    assert repo.created[0].owner_user_id == 42
+    assert repo.created[0].title == "News"
+
+
+async def test_register_shared_target_returns_existing_without_duplicate():
+    existing = SimpleNamespace(id=3, telegram_chat_id=-100123, title="Already")
+    repo = _FakeRegistrationRepo(existing=existing)
+    target = SimpleNamespace(chat_id=-100123, title="News", kind=SharedChatKind.CHANNEL)
+
+    channel, created = await register_shared_target(repo, 555, target)
+
+    assert created is False
+    assert channel is existing
+    assert repo.created == []
+
+from contextlib import asynccontextmanager
+
+from adaptive_tg_bot.bot import keyboards as keyboards_module
+from adaptive_tg_bot.bot.channel_handlers import handle_shared_chat_message
