+
+class _FakeSession:
+    def __init__(self):
+        self.commits = 0
+
+    async def commit(self):
+        self.commits += 1
+
+
+class _FakeDB:
+    def __init__(self, session):
+        self._session = session
+
+    @asynccontextmanager
+    async def session(self):
+        yield self._session
+
+
+class _FakeMessage:
+    def __init__(self, *, request_id: int, user_id: int = 555):
+        self.chat_shared = SimpleNamespace(request_id=request_id, chat_id=-100123, title="Shared title")
+        self.from_user = SimpleNamespace(id=user_id)
+        self.answers = []
+
+    async def answer(self, text, **kwargs):
+        self.answers.append((text, kwargs))
+
+
