+async def test_resolve_shared_channel_requires_publish_rights_and_returns_title():
+    bot = _FakeBot(chat_type="channel", status="administrator", can_post_messages=True, title="News")
+
+    target = await resolve_shared_chat(bot, -100123, SharedChatKind.CHANNEL)
+
+    assert target.chat_id == -100123
+    assert target.title == "News"
+    assert target.kind is SharedChatKind.CHANNEL
+
+
+async def test_resolve_shared_channel_rejects_admin_without_publish_right():
+    bot = _FakeBot(chat_type="channel", status="administrator", can_post_messages=False)
+
+    with pytest.raises(ChatRegistrationError, match="публиковать"):
+        await resolve_shared_chat(bot, -100123, SharedChatKind.CHANNEL)
+
+
+async def test_resolve_shared_group_accepts_bot_member_and_rejects_left_status():
+    member_bot = _FakeBot(chat_type="supergroup", status="member")
+    target = await resolve_shared_chat(member_bot, -100123, SharedChatKind.GROUP)
+    assert target.kind is SharedChatKind.GROUP
+
+    left_bot = _FakeBot(chat_type="group", status="left")
+    with pytest.raises(ChatRegistrationError, match="не добавлен"):
+        await resolve_shared_chat(left_bot, -100123, SharedChatKind.GROUP)
+
+
+async def test_resolve_shared_chat_rejects_mismatched_chat_type():
+    bot = _FakeBot(chat_type="group", status="member")
+    with pytest.raises(ChatRegistrationError, match="не канал"):
+        await resolve_shared_chat(bot, -100123, SharedChatKind.CHANNEL)
